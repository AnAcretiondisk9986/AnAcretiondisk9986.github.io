{
  "name": "anacretiondisk-blog",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/ai-quota-snapshot.mjs && node scripts/localize-images.mjs",
    "postbuild": "node scripts/postbuild-rewrite.mjs",
    "snapshot:quota": "node scripts/ai-quota-snapshot.mjs",
    "images:localize": "node scripts/localize-images.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "admin": "node admin-server.mjs",
    "desktop": "electron desktop/main.mjs",
    "build:desktop": "electron-builder --win zip --x64",
    "blog": "node cli/blog.mjs",
    "tui": "node cli/tui.mjs",
    "test:desktop": "node --test desktop/config.test.mjs desktop/server-control.test.mjs",
    "test:blog-cli": "node --test cli/blog.test.mjs",
    "test:blog-tui": "node --test cli/tui.test.mjs",
    "test:blog": "node --test cli/blog.test.mjs cli/tui.test.mjs",
    "quota:check": "node scripts/ai-quota-proxy.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:images": "node scripts/optimize-images.mjs --dry-run",
    "perf:verify": "node scripts/verify-gallery-perf.mjs",
    "verify:home-cinematic": "node scripts/verify-home-cinematic.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "changelog:release": "node scripts/make-releases.mjs",
    "test:admin-storage": "node --test scripts/admin-storage.test.mjs",
    "test:admin-sync": "node --test scripts/admin-sync.test.mjs",
    "test:admin": "node --test scripts/admin-storage.test.mjs scripts/admin-json-store.test.mjs scripts/admin-sync.test.mjs scripts/store.test.mjs",
    "test:admin-api": "node scripts/admin-api-smoke.mjs",
    "test:admin-ui": "node scripts/sync-center-e2e.mjs",
    "test:post-list": "node scripts/post-list-e2e.mjs",
    "test:admin-e2e": "node scripts/run-admin-e2e.mjs",
    "test:admin-all": "npm run test:admin && npm run test:admin-api && npm run test:admin-e2e",
    "test:editor": "node scripts/editor-e2e.mjs",
    "test:preflight": "node scripts/preflight-e2e.mjs",
    "build:desktop:installer": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "astro": "^7.4.0",
    "express": "^5.2.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "heic-decode": "^2.1.0",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "sharp": "^0.35.3",
    "vditor": "4.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.12.0"
  },
  "build": {
    "appId": "top.acretiondisk.blog.desktop",
    "productName": "ACR-BLOG",
    "copyright": "© Acretiondisk",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/server-control.mjs",
      "desktop/config.mjs",
      "desktop/log.mjs",
      "desktop/splash.html",
      "desktop/icon.ico",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ACR·BLOG",
      "artifactName": "ACR-BLOG-Setup-${version}.${ext}"
    }
  },
  "description": "ACR·BLOG 桌面版——博客内容管理桌面应用",
  "author": {
    "name": "Acretiondisk"
  }
}
