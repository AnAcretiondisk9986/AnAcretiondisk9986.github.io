---
import type { WordCloudWord } from '../lib/wordcloud';

interface Props {
  words: WordCloudWord[];
  /** 词云区块标题,默认 "关键词索引" */
  title?: string;
  /** 紧凑模式:用于文章页窄边栏,小字号、无大标题、不绑定点击跳转 */
  compact?: boolean;
}

const { words, title = '关键词索引', compact = false } = Astro.props;
const siteBase = Astro.site?.toString() ?? '';
---

{compact ? (
  <section class="wordcloud-compact">
    <h3 class="wordcloud-compact-title">{title}</h3>
    {words.length === 0 ? (
      <p class="wordcloud-empty">本篇暂无高频关键词。</p>
    ) : (
      <div class="wordcloud-box" data-wordcloud-box data-compact>
        <canvas
          data-wordcloud
          data-words={JSON.stringify(words)}
          data-site={siteBase}
          aria-label={`词云:${title}`}
        ></canvas>
        <div class="wordcloud-tip" data-wordcloud-tip hidden></div>
      </div>
    )}
  </section>
) : (
  <section class="wordcloud-section">
  <div class="section-heading codex-heading">
    <div>
      <p class="eyebrow">INDEX VERBORUM</p>
      <h2>{title}</h2>
    </div>
    <div class="heading-note">
      <span>{words.length} 个关键词 · 点击词语搜索站内相关内容</span>
    </div>
  </div>
  {words.length === 0 ? (
    <p class="wordcloud-empty">词库仍在积累中,暂无足够的高频关键词。</p>
  ) : (
    <div class="wordcloud-box" data-wordcloud-box>
      <canvas
        data-wordcloud
        data-words={JSON.stringify(words)}
        data-site={siteBase}
        aria-label="词云:博客正文高频关键词"
      ></canvas>
      <div class="wordcloud-tip" data-wordcloud-tip hidden></div>
    </div>
  )}
  </section>
)}

<style>
  .wordcloud-compact {
    margin-top: 42px;
  }
  .wordcloud-compact-title {
    margin: 0 0 14px;
    padding-top: 14px;
    border-top: 1px solid var(--rule-strong);
    font-family: var(--serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }
  .wordcloud-compact .wordcloud-box {
    padding: 0.5rem;
  }
  .wordcloud-compact .wordcloud-empty {
    padding: 1rem;
    font-size: 0.78rem;
  }
  @media (max-width: 860px) {
    /* 移动端边栏变两列 grid(860px 断点),词云占满整行 */
    .wordcloud-compact {
      grid-column: 1 / -1;
      margin-top: 6px;
    }
  }
  .wordcloud-section {
    margin: 2.5rem 0 3rem;
  }
  .wordcloud-box {
    position: relative;
    background: var(--paper-light);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.75rem;
    overflow: hidden;
  }
  .wordcloud-empty {
    padding: 2rem;
    text-align: center;
    color: var(--ink-faint);
    font: 0.9rem/1.6 var(--serif);
    border: 1px dashed var(--rule);
    border-radius: 6px;
  }
  canvas[data-wordcloud] {
    display: block;
    width: 100%;
    height: auto;
    cursor: pointer;
  }
  .wordcloud-tip {
    position: absolute;
    pointer-events: none;
    background: var(--ink);
    color: var(--paper);
    font: 0.8rem/1.4 var(--sans);
    letter-spacing: 0.04em;
    padding: 0.3em 0.7em;
    border-radius: 3px;
    white-space: nowrap;
    transform: translate(-50%, -120%);
    opacity: 0.95;
    z-index: 5;
  }
  .wordcloud-tip b {
    color: var(--gold-light);
    font-weight: 600;
  }
</style>

<script>
  import WordCloud from '../vendor/wordcloud2.js';
  document.addEventListener('astro:page-load', () => {

  // astro:page-load:整页加载与每次 VT 导航后触发,重新初始化(打包脚本只执行一次,事件驱动每次导航执行)

  const box = document.querySelector<HTMLElement>('[data-wordcloud-box]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-wordcloud]');
  const tip = document.querySelector<HTMLElement>('[data-wordcloud-tip]');

  if (!box || !canvas || !tip) {
    // 空态(词库不足)时不渲染 canvas,优雅跳过
    console.warn('[WordCloud] 词云画布缺失,跳过渲染');
  } else {
    const words: { text: string; count: number; weight: number }[] = JSON.parse(
      canvas.dataset.words ?? '[]',
    );
    const siteBase = canvas.dataset.site ?? '';
    const compact = box.hasAttribute('data-compact');

  const FONT =
    '"Noto Serif SC", "Source Han Serif SC", "Songti SC", SimSun, Georgia, serif';
  const COLOR_VARS = ['--ink', '--ink-soft', '--red', '--gold', '--gold-light'];

  if (!WordCloud.isSupported) {
    box.hidden = true;
  } else {
    let resizeTimer: number | undefined;
    // 布局迭代序号:新一轮布局开始时递增,旧迭代检测到序号变化即放弃
    let layoutSeq = 0;

    function palette(): string[] {
      const cs = getComputedStyle(document.documentElement);
      return COLOR_VARS.map((v) => cs.getPropertyValue(v).trim() || '#5f574a');
    }

    /** 依据容器尺寸设置画布物理尺寸(含 DPR) */
    function setCanvasSize() {
      const dpr = window.devicePixelRatio || 1;
      const w = Math.max(box.clientWidth - 24, 140); // 减去 box 内边距
      // 紧凑模式接近方形(高度封顶 280px,避免移动端满宽时过高),普通模式扁宽
      const ratio = compact ? 1.1 : 0.38;
      const cap = compact ? 280 : Infinity;
      const h = Math.max(Math.round(Math.min(w * ratio, cap)), compact ? 180 : 240);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
    }

    /** 基础权重:紧凑模式把 14–72 映射到 8–24,普通模式直接用词频映射 */
    function baseWeight(w: { text: string; weight: number }): number {
      return compact ? Math.round(8 + ((w.weight - 14) * 16) / 58) : w.weight;
    }

    /** 绘制一轮,返回被丢弃(放不下)的词数与绘制词数。
     *  wordcloud2.js 是异步绘制,通过 wordclouddrawn / wordcloudstop 事件收集结果。 */
    function drawOnce(scale: number): Promise<{ dropped: number; drawn: number }> {
      return new Promise((resolve) => {
        let dropped = 0;
        let drawn = 0;
        let settled = false;
        const onDrawn = (e: Event) => {
          drawn++;
          if ((e as CustomEvent<{ drawn: boolean }>).detail?.drawn === false) dropped++;
        };
        const finish = () => {
          if (settled) return;
          settled = true;
          canvas.removeEventListener('wordclouddrawn', onDrawn);
          canvas.removeEventListener('wordcloudstop', finish);
          resolve({ dropped, drawn });
        };
        canvas.addEventListener('wordclouddrawn', onDrawn);
        canvas.addEventListener('wordcloudstop', finish);
        // 超时兜底:极端情况下 stop 事件未触发时不挂起
        window.setTimeout(finish, 4000);

        WordCloud(canvas, {
          list: words.map((w) => [
            w.text,
            Math.max(baseWeight(w) * scale, compact ? 6 : 8),
          ]),
          gridSize: 8,
          weightFactor: 1,
          // 背景必须透明:默认 #fff 会把 canvas 涂成纯白,
          // 暗色主题下浅色词在白底上不可见(表现为"一片纯白")。
          // 透明后露出 .wordcloud-box 的 --paper-light,随主题自适应。
          backgroundColor: 'transparent',
          fontFamily: FONT,
          // wordcloud2.js 不支持数组 color(fillStyle 无效则整图不画)。
          // 用函数从主题色板随机取色,随亮/暗主题自适应。
          color: () => {
            const colors = palette();
            return colors[Math.floor(Math.random() * colors.length)];
          },
          rotateRatio: compact ? 0 : 0.25, // 紧凑模式全部横排,更易读
          shuffle: false, // 按权重从中心向外铺
          // 缩小迭代时小词不能被 minSize 提前跳过,否则收敛判断失真
          minSize: compact ? 6 : 8,
          drawOutOfBound: false,
        hover: (item: [string, number] | null, _dim: unknown, evt: MouseEvent) => {
          if (item?.[0]) {
            const entry = words.find((w) => w.text === item[0]);
            tip.textContent = '';
            const b = document.createElement('b');
            b.textContent = String(entry?.count ?? item[1]);
            tip.append(item[0], ' · 出现 ', b, ' 次');
            tip.style.left = `${evt.clientX - box.getBoundingClientRect().left}px`;
            tip.style.top = `${evt.clientY - box.getBoundingClientRect().top}px`;
            tip.hidden = false;
          } else {
            tip.hidden = true;
          }
        },
        click: compact
          ? undefined // 单篇词云仅作展示,不绑定跳转
          : (item: [string, number] | null) => {
              const word = item?.[0];
              if (!word) return;
              const q = `site:${siteBase.replace(/^https?:\/\//, '')} ${word}`;
              window.open(
                `https://www.google.com/search?q=${encodeURIComponent(q)}`,
                '_blank',
                'noopener',
              );
            },
      });
    });
    }

    /** 自适应布局:迭代字号缩放,让词云尽量填满画布。
     *  有词放不下就整体缩小,全部放下后尝试放大,直到刚好放不下回退一档。 */
    async function fitAndDraw() {
      const runId = ++layoutSeq;
      let scale = 1;
      let r = await drawOnce(scale);
      if (runId !== layoutSeq) return;

      // 阶段 1:确保所有词放下(缩小)
      let success = { scale, dropped: r.dropped, drawn: r.drawn };
      while (r.dropped > 0 && scale > 0.55) {
        scale *= 0.85;
        r = await drawOnce(scale);
        if (runId !== layoutSeq) return;
        if (r.dropped === 0) {
          success = { scale, dropped: 0, drawn: r.drawn };
          break;
        }
      }

      // 阶段 2:全部放下则放大填满,失败(出现丢弃)即回退到最近一次全放下
      if (success.dropped === 0) {
        let lastScale = success.scale;
        let bestScale = success.scale;
        for (let i = 0; i < 6; i++) {
          const next = lastScale * 1.1;
          if (next > 2.2) break;
          lastScale = next;
          r = await drawOnce(next);
          if (runId !== layoutSeq) return;
          if (r.dropped === 0) bestScale = next;
          else break;
        }
        if (bestScale !== lastScale) {
          // 当前画布是放大失败的布局,重画回最佳尺寸
          await drawOnce(bestScale);
        }
      }
    }

    function render() {
      setCanvasSize();
      void fitAndDraw();
    }

    render();

    // 用 ResizeObserver 精确跟随容器尺寸(窗口缩放、侧边栏列宽变化都覆盖)
    const ro = new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(render, 200);
    });
    ro.observe(box);

    // 主题切换时重绘,让颜色跟随亮/暗色变量
    new MutationObserver(() => render()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
  }
  });
</script>
