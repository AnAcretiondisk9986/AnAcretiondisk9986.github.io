---
// 文章底部评论（Waline 评论服务，与留言页同一后端）。
// path 取当前文章 URL；评论服务在部分网络环境（如大陆直连）不可达时，
// 按用户要求直接显示「当前地区暂不支持」提示，不阻塞正文阅读。
---

<section class="post-comments" aria-label="文章评论">
  <header class="pc-index-bar">
    <span>COMMENTS IN THE MARGIN</span>
    <span data-pc-count>— ITEMS</span>
  </header>

  <div class="pc-compose" aria-label="发表评论">
    <div class="pc-avatar" data-pc-avatar aria-hidden="true">匿</div>
    <div class="pc-compose-main">
      <input
        class="pc-nick"
        type="text"
        placeholder="你的称呼（可编辑，留空则为匿名访客）"
        maxlength="30"
        autocomplete="nickname"
        data-pc-nick
      />
      <textarea
        class="pc-textarea"
        placeholder="写点什么……"
        maxlength="300"
        rows="4"
        data-pc-text
      ></textarea>
      <div class="pc-compose-bar">
        <span class="pc-hint">仅文字 · 不能附加图片 · 发送后标注 IP 属地</span>
        <span class="pc-count" data-pc-count-text>0 / 300</span>
        <button class="pc-submit" type="button" data-pc-submit>发送</button>
      </div>
    </div>
  </div>

  <div class="pc-list" data-pc-list></div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
  const MAX_LEN = 300;
  const PAGE_SIZE = 20;
  const FETCH_TIMEOUT = 8000; // 8 秒超时：连不上就直接按「地区不支持」处理
  const STORAGE_SERVER = 'post-comments-server-url';
  const STORAGE_NICK = 'guestbook-nick';
  const DEFAULT_SERVER = 'https://comment-sys-ashen.vercel.app';

  const PAGE_PATH = location.pathname;

  const avatarEl = document.querySelector<HTMLElement>('[data-pc-avatar]');
  const nickInput = document.querySelector<HTMLInputElement>('[data-pc-nick]');
  const textarea = document.querySelector<HTMLTextAreaElement>('[data-pc-text]');
  const countText = document.querySelector<HTMLElement>('[data-pc-count-text]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-pc-submit]');
  const listEl = document.querySelector<HTMLElement>('[data-pc-list]');
  const countEl = document.querySelector<HTMLElement>('[data-pc-count]');

  let serverURL = localStorage.getItem(STORAGE_SERVER) || DEFAULT_SERVER;
  const urlParam = new URLSearchParams(location.search).get('server');
  if (urlParam && /^https?:\/\//i.test(urlParam)) {
    serverURL = urlParam.replace(/\/+$/, '');
    localStorage.setItem(STORAGE_SERVER, serverURL);
  }

  // ── 带超时的 fetch：超时即抛错，由错误状态统一提示 ──
  async function fetchWithTimeout(url: string, init: RequestInit = {}) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT);
    try {
      return await fetch(url, { ...init, signal: ctrl.signal });
    } finally {
      clearTimeout(timer);
    }
  }

  // ── 头像：按昵称哈希取色，字母头像（B 站式圆形） ──
  const AVATAR_COLORS = ['#8d302b', '#9a7b40', '#5f574a', '#4a6b5a', '#6b5a7a', '#7a5a4a', '#3a6b8a', '#8a6b3a'];
  function nickHash(text: string) {
    let hash = 0;
    for (let i = 0; i < text.length; i += 1) hash = (hash * 31 + text.charCodeAt(i)) >>> 0;
    return hash;
  }
  function updateAvatar(nick: string) {
    const name = nick.trim() || '匿名访客';
    if (!avatarEl) return;
    avatarEl.textContent = name.slice(0, 1).toUpperCase();
    avatarEl.style.background = AVATAR_COLORS[nickHash(name) % AVATAR_COLORS.length];
  }

  // ── 相对时间（B 站风格） ──
  function relativeTime(time: number) {
    const diff = Date.now() - time;
    const minute = 60 * 1000;
    const hour = 60 * minute;
    const day = 24 * hour;
    if (diff < minute) return '刚刚';
    if (diff < hour) return `${Math.floor(diff / minute)} 分钟前`;
    if (diff < day) return `${Math.floor(diff / hour)} 小时前`;
    if (diff < 30 * day) return `${Math.floor(diff / day)} 天前`;
    return new Date(time).toLocaleDateString('zh-CN');
  }
  function fullTime(time: number) {
    return new Date(time).toLocaleString('zh-CN', { hour12: false });
  }

  // ── 评论内容渲染：纯文本化的 HTML，移除一切图片/媒体元素与事件属性 ──
  function sanitizeContent(html: string): string {
    const doc = new DOMParser().parseFromString(html || '', 'text/html');
    doc.querySelectorAll('img, svg, script, iframe, object, embed, video, audio, source, canvas, math, style, link, meta').forEach((el) => el.remove());
    doc.querySelectorAll('*').forEach((el) => {
      [...el.attributes].forEach((attr) => {
        if (/^on/i.test(attr.name) || /^data-/i.test(attr.name)) el.removeAttribute(attr.name);
      });
    });
    doc.querySelectorAll('a').forEach((a) => {
      const href = a.getAttribute('href') || '';
      if (!/^https?:/i.test(href)) {
        a.removeAttribute('href');
      } else {
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
      }
    });
    return doc.body.innerHTML;
  }

  function commentTime(comment: any): number {
    const value = comment.time ?? comment.insertedAt ?? Date.now();
    const ts = typeof value === 'number' ? value : Date.parse(String(value));
    return Number.isFinite(ts) ? ts : Date.now();
  }

  function buildComment(comment: any, floor: number) {
    const article = document.createElement('article');
    article.className = 'pc-comment';

    const avatar = document.createElement('div');
    avatar.className = 'pc-c-avatar';
    avatar.textContent = (comment.nick || '匿').slice(0, 1).toUpperCase();
    avatar.style.background = AVATAR_COLORS[nickHash(comment.nick || '匿名') % AVATAR_COLORS.length];

    const body = document.createElement('div');
    body.className = 'pc-c-body';

    const meta = document.createElement('div');
    meta.className = 'pc-c-meta';
    const nick = document.createElement('span');
    nick.className = 'pc-c-nick';
    nick.textContent = comment.nick || '匿名访客';
    meta.append(nick);
    if (comment.addr) {
      const region = document.createElement('span');
      region.className = 'pc-c-region';
      region.textContent = `IP属地：${comment.addr}`;
      region.title = '发送端 IP 归属地（国内显示省份，国外显示国家）';
      meta.append(region);
    }
    const time = document.createElement('time');
    time.className = 'pc-c-time';
    const ts = commentTime(comment);
    time.dateTime = new Date(ts).toISOString();
    time.textContent = relativeTime(ts);
    time.title = fullTime(ts);
    meta.append(time);
    const floorEl = document.createElement('span');
    floorEl.className = 'pc-c-floor';
    floorEl.textContent = `#${floor} 楼`;
    meta.append(floorEl);

    const content = document.createElement('div');
    content.className = 'pc-c-content';
    content.innerHTML = sanitizeContent(comment.comment || '');

    body.append(meta, content);
    article.append(avatar, body);
    return article;
  }

  // ── 状态视图 ──
  // 错误（超时 / 网络不通 / 服务异常）一律按用户要求提示「当前地区暂不支持」，
  // 评论服务部署在境外，境内直连超时即属此类。
  function setStatus(kind: 'loading' | 'error' | 'empty' | 'list', detail = '') {
    if (!listEl) return;
    listEl.innerHTML = '';
    listEl.dataset.status = kind;
    if (kind === 'loading') {
      const p = document.createElement('p');
      p.className = 'pc-status';
      p.textContent = '正在翻查评论……';
      listEl.append(p);
    } else if (kind === 'error') {
      const div = document.createElement('div');
      div.className = 'pc-error';
      const strong = document.createElement('strong');
      strong.textContent = '当前地区暂不支持评论';
      const p = document.createElement('p');
      p.textContent = '无法连接评论服务，可能受网络环境限制。此处的讨论功能不受影响阅读本条目。';
      div.append(strong, p);
      if (detail) {
        const code = document.createElement('code');
        code.textContent = detail;
        div.append(code);
      }
      listEl.append(div);
    } else if (kind === 'empty') {
      const div = document.createElement('div');
      div.className = 'pc-empty';
      const strong = document.createElement('strong');
      strong.textContent = '暂无评论';
      const span = document.createElement('span');
      span.textContent = '在条目边缘留下第一笔批注。';
      div.append(strong, span);
      listEl.append(div);
    }
  }

  let page = 1;
  let totalPages = 1;
  let totalCount = 0;
  let loadedComments: any[] = [];

  async function loadComments(reset = false) {
    if (!serverURL) {
      setStatus('error', '未配置评论服务地址');
      return;
    }
    if (reset) {
      page = 1;
      loadedComments = [];
      setStatus('loading');
    }
    try {
      const params = new URLSearchParams({
        path: PAGE_PATH,
        page: String(page),
        pageSize: String(PAGE_SIZE),
        sortBy: 'insertedAt_asc',
      });
      const res = await fetchWithTimeout(`${serverURL}/api/comment?${params}`);
      const json = await res.json();
      if (!res.ok || json.errno) throw new Error(json.errmsg || `HTTP ${res.status}`);
      const data = json.data;
      totalPages = Number(data.totalPages) || 1;
      totalCount = Number(data.count) || 0;
      loadedComments = [...loadedComments, ...(data.data || [])];
      renderComments();
    } catch (err) {
      if (err instanceof DOMException && err.name === 'AbortError') {
        setStatus('error', '连接超时');
      } else {
        setStatus('error', err instanceof Error ? err.message : String(err));
      }
    }
  }

  function renderComments() {
    if (!listEl || !countEl) return;
    countEl.textContent = `${String(totalCount).padStart(2, '0')} ITEMS`;
    if (loadedComments.length === 0) {
      setStatus('empty');
      return;
    }
    listEl.innerHTML = '';
    listEl.dataset.status = 'list';
    const fragment = document.createDocumentFragment();
    loadedComments.forEach((comment, index) => {
      fragment.append(buildComment(comment, index + 1));
    });
    listEl.append(fragment);
    if (page < totalPages) {
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'pc-more';
      more.textContent = '加载更多评论';
      more.addEventListener('click', () => {
        page += 1;
        loadComments(false);
      });
      listEl.append(more);
    }
  }

  // ── 字数统计 ──
  textarea?.addEventListener('input', () => {
    const len = textarea.value.length;
    if (countText) countText.textContent = `${len} / ${MAX_LEN}`;
  });

  // ── 提交 ──
  submitBtn?.addEventListener('click', async () => {
    if (!serverURL) {
      setStatus('error', '未配置评论服务地址');
      return;
    }
    const nick = nickInput?.value.trim() || '匿名访客';
    const content = textarea?.value.trim() || '';
    if (!content) {
      if (countText) countText.textContent = '还没有写下内容';
      textarea?.focus();
      return;
    }
    if (content.length > MAX_LEN) {
      if (countText) countText.textContent = `超出 ${content.length - MAX_LEN} 字`;
      return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = '发送中…';
    try {
      const res = await fetchWithTimeout(`${serverURL}/api/comment`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          url: PAGE_PATH,
          nick,
          comment: content,
          ua: navigator.userAgent,
        }),
      });
      const json = await res.json();
      if (!res.ok || json.errno) throw new Error(json.errmsg || `HTTP ${res.status}`);
      if (textarea) textarea.value = '';
      if (countText) countText.textContent = `0 / ${MAX_LEN}`;
      await loadComments(true);
    } catch (err) {
      const detail = err instanceof DOMException && err.name === 'AbortError'
        ? '连接超时'
        : (err instanceof Error ? err.message : String(err));
      if (countText) countText.textContent = '发送失败：当前地区暂不支持评论';
      setStatus('error', detail);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '发送';
    }
  });

  // ── 昵称记忆与头像 ──
  const savedNick = localStorage.getItem(STORAGE_NICK) || '';
  if (nickInput && savedNick) {
    nickInput.value = savedNick;
    updateAvatar(savedNick);
  } else {
    updateAvatar('匿');
  }
  nickInput?.addEventListener('input', () => {
    updateAvatar(nickInput.value);
    localStorage.setItem(STORAGE_NICK, nickInput.value.trim());
  });

  loadComments(true);
  });
</script>

<style is:global>
  /* ── 文章底部评论（视觉与留言页一致，独立类名避免互相影响） ── */
  .post-comments {
    margin-top: clamp(52px, 8vw, 88px);
  }

  .pc-index-bar {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-faint);
    font-family: var(--latin);
    font-size: 0.56rem;
    letter-spacing: 0.15em;
  }

  /* 发表区（B 站版式：头像 + 昵称/正文/工具栏） */
  .pc-compose {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 20px;
    padding: 30px 0 34px;
    border-bottom: 1px solid var(--rule-strong);
  }

  .pc-avatar,
  .pc-c-avatar {
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #f4ead6;
    font-family: var(--serif);
    user-select: none;
    flex-shrink: 0;
  }

  .pc-avatar {
    width: 56px;
    height: 56px;
    font-size: 1.15rem;
    background: var(--ink-faint);
  }

  .pc-compose-main {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .pc-nick {
    width: min(100%, 320px);
    padding: 8px 12px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.82rem;
    background: color-mix(in srgb, var(--paper-light) 62%, transparent);
    outline: none;
    transition: border-color 180ms ease;
  }

  .pc-nick::placeholder {
    color: var(--ink-faint);
  }

  .pc-nick:focus {
    border-color: var(--red);
  }

  .pc-textarea {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.9rem;
    line-height: 1.75;
    background: color-mix(in srgb, var(--paper-light) 62%, transparent);
    resize: vertical;
    outline: none;
    transition: border-color 180ms ease;
  }

  .pc-textarea:focus {
    border-color: var(--red);
  }

  .pc-compose-bar {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .pc-hint {
    flex: 1;
    min-width: 0;
    color: var(--ink-faint);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
  }

  .pc-count {
    color: var(--ink-faint);
    font-family: var(--latin);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .pc-submit {
    min-width: 92px;
    min-height: 38px;
    padding: 0 20px;
    border: 1px solid var(--red-dark);
    border-radius: 2px;
    color: #f7ead4;
    font-family: var(--serif);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    background: var(--red);
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
  }

  .pc-submit:hover {
    background: var(--red-dark);
    transform: translateY(-1px);
  }

  .pc-submit:disabled {
    opacity: 0.55;
    cursor: wait;
    transform: none;
  }

  /* 评论列表 */
  .pc-list {
    padding: 26px 0 10px;
  }

  .pc-status {
    padding: 40px 0;
    color: var(--ink-faint);
    font-family: var(--serif);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-align: center;
  }

  .pc-error,
  .pc-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 46px 20px;
    border: 1px dashed var(--rule-strong);
    border-radius: 4px;
    text-align: center;
  }

  .pc-error strong,
  .pc-empty strong {
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .pc-error p,
  .pc-empty span {
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .pc-error code {
    padding: 2px 8px;
    border-radius: 2px;
    color: var(--ink-faint);
    background: var(--paper-deep);
    font-family: var(--latin);
    font-size: 0.66rem;
    overflow-wrap: anywhere;
  }

  .pc-comment {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
  }

  .pc-c-avatar {
    width: 40px;
    height: 40px;
    font-size: 0.9rem;
  }

  .pc-c-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .pc-c-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .pc-c-nick {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .pc-c-region {
    padding: 1px 7px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: 0.6rem;
  }

  .pc-c-time,
  .pc-c-floor {
    color: var(--ink-faint);
    font-family: var(--latin);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  .pc-c-floor {
    margin-left: auto;
  }

  .pc-c-content {
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.88rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .pc-c-content p {
    margin: 0 0 10px;
  }

  .pc-c-content p:last-child {
    margin-bottom: 0;
  }

  .pc-c-content a {
    color: var(--red-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pc-c-content code {
    padding: 1px 6px;
    border-radius: 3px;
    color: var(--red-dark);
    background: var(--paper-deep);
    font-family: var(--latin);
    font-size: 0.82em;
  }

  .pc-c-content blockquote {
    margin: 8px 0;
    padding-left: 14px;
    border-left: 2px solid var(--red);
    color: var(--ink-soft);
  }

  .pc-c-content ul,
  .pc-c-content ol {
    margin: 8px 0;
    padding-left: 22px;
  }

  .pc-more {
    display: block;
    margin: 26px auto 0;
    padding: 9px 26px;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    color: var(--ink-faint);
    font-family: var(--serif);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    background: transparent;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .pc-more:hover {
    color: var(--red);
    border-color: var(--red);
  }

  /* 窄屏适配（与留言页一致） */
  @media (max-width: 640px) {
    .pc-compose {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 14px;
      padding-block: 24px;
    }

    .pc-avatar {
      width: 44px;
      height: 44px;
      font-size: 0.95rem;
    }

    .pc-hint {
      display: none;
    }

    .pc-comment {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 12px;
    }

    .pc-c-avatar {
      width: 36px;
      height: 36px;
      font-size: 0.82rem;
    }

    .pc-c-floor {
      margin-left: 0;
    }

    .pc-index-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }

  /* 打印（导出 PDF）时隐藏评论区 */
  @media print {
    .post-comments {
      display: none !important;
    }
  }
</style>
