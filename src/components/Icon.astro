---
/** Original 24px line icons. UI controls never depend on emoji fonts. */
import { iconPaths, type IconName } from '../lib/icons';
interface Props { name: IconName; class?: string; }
const { name, class: className = '' } = Astro.props;

---
<svg class:list={['ui-icon', `ui-icon--${name}`, className]} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={iconPaths[name]} /></svg>
