---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import ThemeCopy from './ThemeCopy.astro';
import { firstImageFromBody } from '../lib/post-cover';

interface Props {
  posts: CollectionEntry<'blog'>[];
  basePath?: string;
  private?: boolean;
  /** 是否显示排序/版式切换工具栏（首页精选列表关闭，固定横栏） */
  toolbar?: boolean;
}

const { posts, basePath = '/blog/', private: isPrivate = false, toolbar = true } = Astro.props;
const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const dayCounts = new Map<string, number>();

for (const post of posts) {
  const key = post.data.pubDate.toISOString().slice(0, 10);
  dayCounts.set(key, (dayCounts.get(key) ?? 0) + 1);
}

const covers = new Map(posts.map((post) => [
  post.id,
  post.data.cover?.trim() || firstImageFromBody(post.body ?? ''),
]));
---

<div class="catalog-collection">
  {toolbar && (
  <div class="gallery-order-bar catalog-toolbar" aria-label="文章显示设置">
    <div class="catalog-toolbar__search">
      <label class="catalog-search" id="catalog-search">
        <span class="sr-only">搜索文章</span>
        <Icon name="search" />
        <input type="search" data-catalog-search placeholder="搜索标题、摘要或标签" autocomplete="off" />
      </label>
      <span class="catalog-results" data-catalog-results>{posts.length} 篇文章</span>
    </div>
    <div class="catalog-toolbar-actions">
      <div class="gallery-order-label">
        <span>排序</span>
        <strong><span data-order-status>从新至旧</span><span aria-hidden="true"> / </span><span data-catalog-view-status>横栏</span></strong>
      </div>
      <div class="gallery-sort" role="group" aria-label="文章展示顺序">
        <button type="button" data-order-sort="newest" aria-pressed="true">
          <span aria-hidden="true"><Icon name="arrow-down" /></span>从新至旧
        </button>
        <button type="button" data-order-sort="oldest" aria-pressed="false">
          <span aria-hidden="true"><Icon name="arrow-up" /></span>从旧至新
        </button>
      </div>
      <div class="catalog-view-switch" role="group" aria-label="文章版式">
        <button type="button" data-catalog-view="cards" aria-pressed="false" title="卡片式">
          <span aria-hidden="true"><Icon name="grid" /></span>卡片
        </button>
        <button type="button" data-catalog-view="rows" aria-pressed="true" title="横栏式">
          <span aria-hidden="true"><Icon name="rows" /></span>横栏
        </button>
      </div>
    </div>
  </div>
  )}

  {toolbar && (
  <div class="catalog-rule" data-catalog-rule aria-hidden="true">
    <span>INDEX</span><span>IMAGO</span><span>TITULUS</span><span>DATE</span><span></span>
  </div>
  )}

  <div class="catalog-list" data-catalog-list data-catalog-layout={toolbar ? 'rows' : 'cards'} data-order-list data-catalog-fixed={toolbar ? undefined : ''}>
    {posts.map((post, index) => {
      const cover = covers.get(post.id) ?? '';
      const dayKey = post.data.pubDate.toISOString().slice(0, 10);
      const href = `${normalizedBasePath}${post.id}/`;
      return (
        <article class="catalog-entry" data-order-card data-order-date={dayKey} data-order-day-index={post.data.dayIndex ?? 0} data-order-position={index} data-catalog-search-text={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`}>
          <div class="catalog-index">
            <span data-order-sequence data-order-pad="2">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <figure class="catalog-cover" data-empty={cover ? undefined : ''}>
            {cover && <img src={cover} alt="" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />}
          </figure>
          <div class="catalog-content">
            {isPrivate && <span class="private-entry__mark">LOCKED</span>}
            <h2><a href={href}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list" aria-label="标签">
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>
          <time datetime={post.data.pubDate.toISOString()}>
            <span>{post.data.pubDate.getFullYear()}</span>
            <b>{String(post.data.pubDate.getMonth() + 1).padStart(2, '0')}.{String(post.data.pubDate.getDate()).padStart(2, '0')}</b>
            {dayCounts.get(dayKey)! > 1 && (
              <span class="catalog-day-index">DAY {String(post.data.dayIndex ?? 0).padStart(2, '0')}</span>
            )}
          </time>
          <a class="catalog-open" href={href} aria-label={`阅读《${post.data.title}》`}><ThemeCopy minimal="阅读" trace="打开记录" /> <Icon name="arrow-up-right" /></a>
        </article>
      );
    })}
  </div>
  {toolbar && <p class="catalog-empty" data-catalog-empty hidden>没有找到匹配的文章。试试更换关键词。</p>}
</div>

<script>
  import { initCatalogLayout } from '../scripts/catalog-layout';
  import { initOrderToggle } from '../scripts/order-toggle';
  import { initCatalogSearch } from '../scripts/catalog-search';

  initCatalogLayout();
  initOrderToggle();
  initCatalogSearch();
  document.addEventListener('astro:page-load', () => {
    initCatalogLayout();
    initOrderToggle();
    initCatalogSearch();
  });
</script>
