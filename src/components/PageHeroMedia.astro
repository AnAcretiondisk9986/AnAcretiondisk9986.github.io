---
// 页头背景:与首页 hero 共用同一背景图(frontend.json 数据源,管理面板改图全站同步)
// 仅 Liquid 主题显示(still 显 still 图、fluid 显 fluid 图),legacy 主题由 CSS 隐藏
import frontend from '../data/frontend.json';
---
<div class="page-hero-media" aria-hidden="true">
  <img class="page-hero-image page-hero-image--still" src={frontend.stillHeroImage} alt="" style={`object-position:${frontend.stillImagePosition}`} />
  <img class="page-hero-image page-hero-image--fluid" src={frontend.fluidHeroImage} alt="" style={`object-position:${frontend.fluidImagePosition}`} />
  <span class="page-hero-scrim"></span>
</div>
