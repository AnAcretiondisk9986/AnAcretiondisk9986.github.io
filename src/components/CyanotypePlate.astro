---
/** A code-native cyanotype plate: orbital exposures, registration marks and a paper silhouette. */
---
<figure class="cyanotype-plate" aria-label="原创蓝晒线稿：交错的轨道围绕一颗未被填满的星体，像仍在生长的观察。">
  <div class="cyanotype-plate__top"><span>PLATE 001 / ACRETIONDISK</span><span>原始观察</span></div>
  <svg class="cyanotype-plate__drawing" viewBox="0 0 560 520" fill="none" aria-hidden="true">
    <defs>
      <pattern id="cyanotype-grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" stroke="#e7f0ff" stroke-opacity=".12" stroke-width=".6" /></pattern>
      <pattern id="cyanotype-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(32)"><path d="M0 0v7" stroke="#163da1" stroke-width="1.4" /></pattern>
      <clipPath id="cyanotype-disc"><circle cx="280" cy="258" r="113" /></clipPath>
    </defs>
    <path fill="url(#cyanotype-grid)" d="M0 0h560v520H0z" />
    <g stroke="#dceaff" stroke-width="1">
      <path d="M24 40h24M36 28v24m476-12h24m-12-12v24M24 480h24m-12-12v24m476-12h24m-12-12v24" />
      <circle cx="280" cy="258" r="184" stroke-opacity=".4" stroke-dasharray="2 7" />
      <path d="M280 48v420M72 258h416" stroke-opacity=".25" stroke-dasharray="4 5" />
      <circle cx="280" cy="258" r="150" stroke-opacity=".28" />
      <ellipse cx="280" cy="258" rx="235" ry="76" transform="rotate(-32 280 258)" stroke-opacity=".75" />
      <ellipse cx="280" cy="258" rx="224" ry="88" transform="rotate(39 280 258)" stroke-opacity=".4" />
    </g>
    <circle cx="280" cy="258" r="113" fill="#e8eff5" />
    <g clip-path="url(#cyanotype-disc)"><path d="M265 134c-53 83-4 116 4 164 10 64-49 76-27 112h182V122Z" fill="url(#cyanotype-hatch)" /><path d="M265 134c-53 83-4 116 4 164 10 64-49 76-27 112" stroke="#163da1" stroke-width="1.4" /></g>
    <ellipse cx="280" cy="258" rx="235" ry="76" transform="rotate(-32 280 258)" stroke="#f3f6ed" stroke-width="1.2" stroke-dasharray="470 720" />
    <g fill="#ff865c"><circle cx="438" cy="144" r="8" /><circle cx="114" cy="341" r="3" /></g>
    <path d="m438 144 34-55h39M191 327l-40 88H71" stroke="#ecf1f9" stroke-width=".8" />
    <g fill="#e7f0ff" font-family="monospace" font-size="10" letter-spacing="1.2"><text x="408" y="77">IN PROGRESS</text><text x="71" y="433">未完成，也值得记录。</text><text x="288" y="63">N</text><text x="482" y="252">E</text></g>
    <g stroke="#e7f0ff" stroke-width="1"><path d="M58 466h100m-100-4v8m25-6v4m25-6v8m25-6v4m25-6v8" /><path d="m474 416 13 22 13-22m-13 22v24" /></g>
  </svg>
  <figcaption><span>把目光停留的地方，<br />慢慢显影成自己的世界。</span><span class="cyanotype-plate__number">01<span> / ∞</span></span></figcaption>
</figure>
