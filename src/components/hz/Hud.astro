---
/**
 * HUD：仪器取景器。
 * - 顶栏：品牌 / 编号通道导航 / VOID·PLATE 切换 / 菜单（窄屏）
 * - 四角裁切标（纯装饰）
 * - 左下 / 右下读数：光标坐标、下潜深度、UTC 时钟、MJD（由 scripts/hz/shell.ts 驱动）
 * - 全屏菜单：窄屏导航
 */
interface Props {
  siteName: string;
  siteTagline: string;
  pathname: string;
}
const { siteName, siteTagline, pathname } = Astro.props;

const channels = [
  { href: '/', label: '首页', en: 'ORIGIN' },
  { href: '/blog/', label: '文章', en: 'SPECTRUM' },
  { href: '/gallery/', label: '图像', en: 'LENSING' },
  { href: '/about/', label: '关于', en: 'OBSERVER' },
  { href: '/academics/', label: '学业', en: 'TRAJECTORY' },
  { href: '/ai-quota/', label: '额度', en: 'FLUX' },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="hz-hud" data-hud>
  <a class="hz-brand" href="/" aria-label={`${siteName} · 首页`}>
    <svg class="hz-brand__mark" viewBox="0 0 40 40" aria-hidden="true">
      <ellipse class="hz-brand__disk" cx="20" cy="20" rx="18" ry="5.4" />
      <path class="hz-brand__arc" d="M8.6 18.2a11.6 11.6 0 0 1 22.8 0" />
      <circle class="hz-brand__hole" cx="20" cy="20" r="6.2" />
    </svg>
    <span class="hz-brand__text">
      <span class="hz-brand__name">{siteName}</span>
      <span class="hz-brand__tag">{siteTagline}</span>
    </span>
  </a>

  <nav class="hz-nav" aria-label="主导航">
    {channels.map((c, i) => (
      <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
        <span class="hz-nav__no">{String(i + 1).padStart(2, '0')}</span>
        <span class="hz-nav__label">{c.label}</span>
      </a>
    ))}
  </nav>

  <div class="hz-tools">
    <button class="hz-theme" type="button" data-theme-toggle aria-label="切换明暗：VOID 暗色 / PLATE 底片">
      <span class="hz-theme__opt" data-opt="dark">VOID</span>
      <span class="hz-theme__sep" aria-hidden="true">/</span>
      <span class="hz-theme__opt" data-opt="light">PLATE</span>
    </button>
    <button class="hz-menu-btn" type="button" data-menu-open aria-expanded="false" aria-controls="hz-menu">
      <span class="hz-menu-btn__bars" aria-hidden="true"><i></i><i></i></span>
      <span class="sr-only">打开导航</span>
    </button>
  </div>
</header>

<div class="hz-frame" aria-hidden="true">
  <i class="hz-frame__c hz-frame__c--tl"></i>
  <i class="hz-frame__c hz-frame__c--tr"></i>
  <i class="hz-frame__c hz-frame__c--bl"></i>
  <i class="hz-frame__c hz-frame__c--br"></i>
</div>

<div class="hz-readout hz-readout--l" aria-hidden="true">
  <span data-ro-xy>X 0000 · Y 0000</span>
  <span data-ro-depth>DEPTH 000%</span>
</div>
<div class="hz-readout hz-readout--r" aria-hidden="true">
  <span data-ro-clock>UTC --:--:--</span>
  <span data-ro-mjd>MJD -----.----</span>
</div>

<div class="hz-menu" id="hz-menu" data-menu hidden>
  <div class="hz-menu__head">
    <span class="hz-mono">CHANNELS · 通道</span>
    <button class="hz-menu__close" type="button" data-menu-close>关闭 ✕</button>
  </div>
  <nav class="hz-menu__nav" aria-label="主导航（菜单）">
    {channels.map((c, i) => (
      <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined} style={`--i:${i}`}>
        <span class="hz-menu__no">{String(i + 1).padStart(2, '0')}</span>
        <span class="hz-menu__label">{c.label}</span>
        <span class="hz-menu__en">{c.en}</span>
      </a>
    ))}
  </nav>
  <a class="hz-menu__private" href="/private/">私密文章 · PRIVATE →</a>
</div>
