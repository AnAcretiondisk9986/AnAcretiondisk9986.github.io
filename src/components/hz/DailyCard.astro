---
import type { NormalizedDailyEntry } from '../../lib/daily';
import { pad2 } from '../../lib/horizon';

interface Props {
  entry: NormalizedDailyEntry;
  avatar: string;
  authorName: string;
  handle: string;
  index: number;
}

const { entry, avatar, authorName, handle, index } = Astro.props;

const mediaPayload = entry.images.map((img) => ({
  src: img.fullSrc,
  thumb: img.src,
  original: img.originalSrc,
  fallback: img.fallbackSrc,
  alt: img.alt || `${entry.fullDateTime} 的日常影像 ${img.index + 1}`,
}));

const mediaJson = entry.images.length > 0 ? JSON.stringify(mediaPayload) : undefined;
const charCount = entry.text.replace(/\s+/g, '').length;
---

<article
  class:list={[
    'hz-tweet',
    {
      'is-pinned': entry.pinned,
      'has-media': entry.images.length > 0,
      'has-thread': Boolean(entry.threadId),
    },
  ]}
  id={entry.id}
  data-tl-tweet
  data-id={entry.id}
  data-ts={String(entry.timestamp)}
  data-pinned={entry.pinned ? '1' : '0'}
  data-has-media={entry.images.length > 0 ? '1' : '0'}
  data-media-count={String(entry.images.length)}
  data-month={entry.monthKey}
  data-day={entry.dayKey}
  data-tags={JSON.stringify(entry.tags)}
  data-thread-id={entry.threadId || undefined}
  data-search={entry.searchBlob}
  data-date-label={entry.fullDateTime}
  data-excerpt={entry.text.slice(0, 120)}
  data-pos={String(index)}
>
  {entry.pinned && (
    <div class="hz-tweet__context hz-mono">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M16 4v5l2 2v2h-5v7l-1 1-1-1v-7H6v-2l2-2V4h8Z" fill="currentColor" />
      </svg>
      <span>置顶日常 · PINNED TRANSMISSION</span>
    </div>
  )}

  {!entry.pinned && entry.threadId && (
    <div class="hz-tweet__context hz-tweet__context--thread hz-mono">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M10 6h10M10 12h10M10 18h6M4 6h.01M4 12h.01M4 18h.01" stroke-linecap="round" />
      </svg>
      <button
        type="button"
        class="hz-tweet__thread-btn"
        data-tl-thread-filter={entry.threadId}
        title="仅查看该串连片段"
      >
        THREAD // {entry.threadLabel || entry.threadId}
      </button>
    </div>
  )}

  <div class="hz-tweet__shell">
    <div class="hz-tweet__gutter">
      <a class="hz-tweet__avatar" href="/about/" aria-label={`查看 ${authorName} 档案`}>
        <img src={avatar} alt={authorName} loading="lazy" decoding="async" />
      </a>
      <span class="hz-tweet__connector" aria-hidden="true"></span>
    </div>

    <div class="hz-tweet__main">
      <header class="hz-tweet__head">
        <div class="hz-tweet__author">
          <a class="hz-tweet__name" href="/about/">{authorName}</a>
          <span class="hz-tweet__badge" title="HORIZON 观测者" aria-label="已验证观测者">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="10" cy="10" r="8.5" fill="currentColor" />
              <path
                d="M6.4 10.2 8.9 12.6 13.8 7.5"
                fill="none"
                stroke="#08080b"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="hz-tweet__handle">{handle}</span>
          <span class="hz-tweet__dot" aria-hidden="true">·</span>
          <a class="hz-tweet__time" href={`#${entry.id}`} title={`${entry.fullDateTime} · ${entry.mjdLabel}`}>
            <time datetime={entry.createdAt} data-tl-rel={entry.createdAt}>
              {entry.fullDateTime}
            </time>
          </a>
        </div>

        <div class="hz-tweet__telemetry hz-mono">
          <span class="hz-tweet__mjd">{entry.mjdLabel}</span>
          <a class="hz-tweet__seq" href={`#${entry.id}`} aria-label={`定位到 ${entry.fullDateTime}`}>
            #{pad2(index + 1)}
          </a>
        </div>
      </header>

      {entry.html && <div class="hz-tweet__body" set:html={entry.html} />}

      {entry.images.length > 0 && (
        <div
          class="hz-media"
          data-count={String(entry.images.length)}
          data-media={mediaJson}
          role="group"
          aria-label={`共 ${entry.images.length} 张图片`}
        >
          {entry.images.map((img, imgIdx) => {
            const tileSrc = entry.images.length === 1 ? img.fullSrc : img.src;
            return (
              <button
                type="button"
                class="hz-media__item"
                data-tl-open-img={String(imgIdx)}
                aria-label={img.alt ? `查看大图：${img.alt}` : `查看大图（第 ${imgIdx + 1} / ${entry.images.length} 张）`}
              >
                <img
                  src={tileSrc}
                  alt={img.alt || ''}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  data-gallery-fallback={img.fallbackSrc || undefined}
                />
                {entry.images.length > 1 && (
                  <span class="hz-media__idx hz-mono" aria-hidden="true">
                    {pad2(imgIdx + 1)}/{pad2(entry.images.length)}
                  </span>
                )}
                {img.alt && (
                  <span class="hz-media__alt hz-mono" title={img.alt}>
                    ALT
                  </span>
                )}
              </button>
            );
          })}
        </div>
      )}

      {entry.linkCard && (
        <a
          class="hz-tweet__card"
          href={entry.linkCard.url}
          target={entry.linkCard.external ? '_blank' : undefined}
          rel={entry.linkCard.external ? 'noopener noreferrer' : undefined}
        >
          <span class="hz-tweet__card-label hz-mono">{entry.linkCard.label}</span>
          <strong class="hz-tweet__card-title">{entry.linkCard.title}</strong>
          {entry.linkCard.description && (
            <span class="hz-tweet__card-desc">{entry.linkCard.description}</span>
          )}
          <span class="hz-tweet__card-arrow" aria-hidden="true">↗</span>
        </a>
      )}

      {(entry.location || entry.device || entry.mood) && (
        <div class="hz-tweet__meta hz-mono">
          {entry.location && <span>LOC // {entry.location}</span>}
          {entry.device && <span>GEAR // {entry.device}</span>}
          {entry.mood && <span>STATE // {entry.mood}</span>}
        </div>
      )}

      <footer class="hz-tweet__actions" aria-label="动态操作">
        {entry.images.length > 0 ? (
          <button
            type="button"
            class="hz-tl-act hz-tl-act--media"
            data-tl-open-img="0"
            title="在高清灯箱中查看全部图片"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="3" />
              <circle cx="8.5" cy="9.5" r="1.5" fill="currentColor" stroke="none" />
              <path d="m21 15-4.5-4.5L9 18" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{entry.images.length} / 9 帧</span>
          </button>
        ) : (
          <span class="hz-tl-act hz-tl-act--static" title="纯文字微片段">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M5 7h14M5 12h10M5 17h7" stroke-linecap="round" />
            </svg>
            <span>{charCount} 字</span>
          </span>
        )}

        <button
          type="button"
          class="hz-tl-act hz-tl-act--like"
          data-tl-like={entry.id}
          aria-pressed="false"
          title="共鸣（本地记录）"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path
              d="M12 20.4s-7.5-4.7-9.2-9.2C1.6 8.1 3.6 4.5 7 4.5c2 0 3.7 1.1 5 2.7 1.3-1.6 3-2.7 5-2.7 3.4 0 5.4 3.6 4.2 6.7-1.7 4.5-9.2 9.2-9.2 9.2Z"
              stroke-linejoin="round"
            />
          </svg>
          <span data-tl-like-label>共鸣</span>
        </button>

        <button
          type="button"
          class="hz-tl-act hz-tl-act--bookmark"
          data-tl-bookmark={entry.id}
          aria-pressed="false"
          title="收藏到本地列表"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path
              d="M6.5 4.5h11a1 1 0 0 1 1 1v14.8l-6.5-4.1-6.5 4.1V5.5a1 1 0 0 1 1-1Z"
              stroke-linejoin="round"
            />
          </svg>
          <span data-tl-bookmark-label>收藏</span>
        </button>

        <button
          type="button"
          class="hz-tl-act hz-tl-act--share"
          data-tl-copy={entry.id}
          title="复制本条直达链接"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path
              d="M10 13.5a4.2 4.2 0 0 0 6 .3l2.5-2.5a4.2 4.2 0 0 0-6-6L11 6.8M14 10.5a4.2 4.2 0 0 0-6-.3L5.5 12.7a4.2 4.2 0 0 0 6 6L13 17.2"
              stroke-linecap="round"
            />
          </svg>
          <span data-tl-copy-label>直链</span>
        </button>
      </footer>
    </div>
  </div>
</article>
