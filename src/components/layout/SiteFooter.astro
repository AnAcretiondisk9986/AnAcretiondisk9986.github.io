---
interface Props {
  siteName: string;
  siteTagline: string;
}

const { siteName, siteTagline } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="f-footer">
  <div class="f-footer__inner">
    <div class="f-footer__brand">
      <span class="f-stamp" aria-hidden="true">A</span>
      <span>
        <span class="f-footer__name">{siteName}</span>
        <span class="f-footer__meta">{siteTagline}</span>
      </span>
    </div>
    <p class="f-footer__meta">文字以 CC BY-NC 4.0 授权，图片版权归原作者。</p>
    <p class="f-footer__meta f-footer__end">
      <a href="https://github.com/AnAcretiondisk9986">GitHub</a>
      <span>© {year}</span>
    </p>
  </div>
</footer>
