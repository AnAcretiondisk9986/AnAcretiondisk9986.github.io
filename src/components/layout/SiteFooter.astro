---
interface Props {
  siteName: string;
  siteTagline: string;
}

const { siteName, siteTagline } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="f-footer">
  <div class="f-footer__inner">
    <div class="f-footer__brand">
      <span class="f-stamp" aria-hidden="true">A</span>
      <span>
        <span class="f-footer__name">{siteName}</span>
        <span class="f-footer__meta">{siteTagline}</span>
      </span>
    </div>
    <p class="f-footer__meta">文字以 CC BY-NC 4.0 授权，图片版权归原作者。</p>
    <p class="f-footer__meta f-footer__end">
      <a href="https://github.com/AnAcretiondisk9986">GitHub</a>
      <span>© {year}</span>
    </p>
  </div>
</footer>

<style is:global>
  /* ==========================================================================
     页脚打磨层（2026-11-11 polish）
     --------------------------------------------------------------------------
     与 SiteHeader 一样刻意不放进 @layer：未分层规则压过 folio-ui（components）
     与 cyanotype（theme）里对 .f-footer__meta / .f-footer 的声明。
     ========================================================================== */

  /* ── 页脚 meta：13px / ink-3（3.58:1）→ 14px / ink-2（≈6.6:1）────── */
  .f-footer .f-footer__meta {
    font-size: 0.875rem;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: var(--c-ink-2, var(--c-ink, inherit));
  }

  /* ── 长页面上 main 与页脚之间的空隙：p-sp-8（64px）收到 24–40px ────
     页脚自身上下留白也各收 4–8px，避免「正文结束 → 一大片空白 → 页脚」。 */
  .f-footer {
    margin-top: clamp(24px, 3vw, 40px);
    padding-block: 28px 32px;
  }
  .f-footer__inner {
    align-items: center;
  }

  /* ── 页脚链接热区：粗指针下 ≥44 高（视觉字号不动）────────────────── */
  @media (pointer: coarse) {
    .f-footer a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .f-footer .f-footer__end {
      gap: 12px;
    }
  }

  /* ── 打印：页脚不该出现在纸上（post 打印实测仍有 78px 页脚）──────── */
  @media print {
    .f-footer {
      display: none;
    }
  }
</style>
