---
interface Props {
  siteName: string;
  siteTagline: string;
}

const { siteName, siteTagline } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="f-footer">
  <div class="f-double-rule" style="margin-bottom:32px"></div>
  <div class="f-footer__inner">
    <div class="f-stamp" aria-hidden="true">ARS<br />LONGA</div>
    <div class="f-footer__meta">
      {siteName} · {siteTagline}<br />
      内容以 CC BY-NC 4.0 授权 · 图片来源见各图版
    </div>
    <div class="f-footer__meta" style="text-align:right">
      <a href="https://github.com/AnAcretiondisk9986">GITHUB ↗</a> · © {year} {siteName.toUpperCase()}<br />
      编目与图版持续增补
    </div>
  </div>
</footer>
