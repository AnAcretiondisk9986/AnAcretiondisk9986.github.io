---
interface Props {
  siteName: string;
  siteTagline: string;
  pathname: string;
}

const { siteName, siteTagline, pathname } = Astro.props;
const navigation = [
  { href: '/', label: '首页', index: 'I' },
  { href: '/blog/', label: '编目', index: 'II' },
  { href: '/gallery/', label: '图志', index: 'III' },
  { href: '/about/', label: '关于', index: 'IV' },
  { href: '/ai-quota/', label: '额度', index: 'V' },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="f-header">
  <a class="f-skip" href="#main">跳到主内容</a>
  <div class="f-masthead">
    <a class="f-brand" href="/" aria-label={`${siteName} 首页`}>
      <span class="f-brand__seal" aria-hidden="true">A</span>
      <span>
        <span class="f-brand__name">{siteName}</span>
        <span class="f-brand__tag">{siteTagline}</span>
      </span>
    </a>

    <nav class="f-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="f-tools">
      <a class="f-icon-btn" href="/blog/#catalog-search" aria-label="搜索文章">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16.5 16.5 4 4" /></svg>
      </a>
      <button class="f-icon-btn theme-toggle" type="button" aria-label="切换明暗主题">
        <span class="f-theme-icon" aria-hidden="true">
          <svg class="f-theme-icon__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" /></svg>
          <svg class="f-theme-icon__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
        </span>
      </button>
    </div>
  </div>

  <nav class="f-nav-mobile" aria-label="主导航（移动端）">
    {navigation.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style is:global>
  /* ==========================================================================
     页头打磨层（2026-11-11 polish）
     --------------------------------------------------------------------------
     这一层刻意「不放进 @layer」：folio-ui / cyanotype 的组件与主题规则都在
     @layer 里，而未分层的规则优先级高于任何层，所以这里可以稳定压过
     cyanotype 的 `:root[data-visual-theme="cyanotype"] .f-icon-btn{border-color:transparent}`
     —— 那条正是「图标看起来不像可点控件」的直接原因。不写 !important。
     ========================================================================== */

  /* ── 跳到主内容（键盘 Tab 第一下就拿到）────────────────────────────── */
  .f-skip {
    position: fixed;
    top: 0;
    left: 50%;
    translate: -50% -140%;
    z-index: 90;
    padding: 10px 18px;
    background: var(--c-paper, #fff);
    color: var(--c-ink, #111);
    border: 1px solid var(--c-rule-strong, currentColor);
    border-radius: 0 0 4px 4px;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    box-shadow: 0 6px 20px rgb(0 0 0 / 12%);
    transition: translate 0.16s var(--p-ease, ease);
  }
  .f-skip:focus,
  .f-skip:focus-visible {
    translate: -50% 0;
    outline: 2px solid var(--c-accent, currentColor);
    outline-offset: 2px;
  }
  /* skip link 落到 main 上时不要给整屏画焦点框 */
  main#main:focus { outline: none; }

  /* ── 图标按钮：从「看得见的控件」而不是「一点淡痕」开始 ────────────
     原状：30×30、边框 transparent、图标 14px、色 --c-ink-2 → 1440 宽几乎看不见。
     现在：36×36 的可见边框 + 纸面微底 + 17px 图标 + --c-ink 正文色。 */
  .f-header .f-icon-btn {
    width: 36px;
    height: 36px;
    /* fusion-theme 的 legacy 规则给了 .theme-toggle min-height:42px / padding-inline:12px，
       会把按钮拉成 36×42 的长方块；这里显式清零，让两个按钮同尺寸同形。 */
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 1px solid var(--c-rule-strong, var(--c-rule, currentColor));
    border-radius: var(--r-frame, 2px);
    color: var(--c-ink, currentColor);
    background: color-mix(in oklab, var(--c-ink, #000) 4%, transparent);
    transition: background 0.14s var(--p-ease, ease), border-color 0.14s var(--p-ease, ease),
      color 0.14s var(--p-ease, ease);
  }
  .f-header .f-icon-btn svg {
    width: 17px;
    height: 17px;
    stroke-width: 1.7;
  }
  .f-header .f-icon-btn:hover {
    border-color: var(--c-metal, var(--c-ink, currentColor));
    color: var(--c-accent, currentColor);
    background: color-mix(in oklab, var(--c-accent, #000) 12%, transparent);
  }
  .f-header .f-icon-btn:focus-visible {
    outline: 2px solid var(--c-accent, currentColor);
    outline-offset: 2px;
  }

  /* 主题切换按钮里的太阳/月亮由 appearance.ts 控制显隐，尺寸交给上面统一管 */
  .f-header .f-theme-icon {
    display: grid;
    place-items: center;
    line-height: 0;
  }

  /* ── 桌面导航：链接热区抬到 36 高（视觉字号不动）──────────────────
     桌面是鼠标操作，36px 足够；粗指针设备在下面的 @media 里抬到 44px。
     这也是页头总高的控制点：内容行 37.5px + masthead 上下 14×2 = 66px。 */
  .f-header .f-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding-block: 0;
    padding-inline: 2px;
  }

  /* ── 移动端：图标 44×44、导航 5 等分格 44 高，热区全部 ≥44×44 ────── */
  @media (max-width: 720px) {
    /* 内容行留白收一档，用省下来的高度换 44px 热区，总高度基本持平 */
    .f-header .f-masthead {
      padding-block: 8px;
      gap: var(--p-sp-3, 12px);
    }
    .f-header .f-brand {
      min-height: 44px;
      align-items: center;
    }
    .f-header .f-icon-btn {
      width: 44px;
      height: 44px;
      min-height: 0;
      padding: 0;
    }
    .f-header .f-tools {
      gap: 6px;
    }

    /* 5 个导航项各占一格，格子 44×≈70：手指落点不再挤在文字上 */
    .f-header .f-nav-mobile {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: stretch;
      gap: 0;
      margin-top: 2px;
      padding-block: 0;
    }
    .f-header .f-nav-mobile a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding-inline: 2px;
      white-space: nowrap;
    }
  }

  /* 粗指针设备（平板/触屏笔电）即使宽度 >720 也给足热区 */
  @media (pointer: coarse) {
    .f-header .f-icon-btn {
      width: 44px;
      height: 44px;
      min-height: 0;
      padding: 0;
    }
    .f-header .f-nav a {
      min-height: 44px;
    }
  }
</style>
