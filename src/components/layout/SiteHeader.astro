---
interface Props {
  siteName: string;
  siteTagline: string;
  pathname: string;
}

const { siteName, siteTagline, pathname } = Astro.props;
const navigation = [
  { href: '/', label: '首页', index: 'I' },
  { href: '/blog/', label: '编目', index: 'II' },
  { href: '/gallery/', label: '图志', index: 'III' },
  { href: '/about/', label: '关于', index: 'IV' },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="f-header">
  <div class="f-masthead">
    <a class="f-brand" href="/" aria-label={`${siteName} 首页`}>
      <span class="f-brand__seal" aria-hidden="true">A</span>
      <span>
        <span class="f-brand__name">{siteName}</span>
        <span class="f-brand__tag">{siteTagline}</span>
      </span>
    </a>

    <nav class="f-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="f-tools">
      <a class="f-icon-btn" href="/blog/#catalog-search" aria-label="搜索文章">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16.5 16.5 4 4" /></svg>
      </a>
      <button class="f-icon-btn theme-toggle" type="button" aria-label="切换明暗主题">
        <span class="f-theme-icon" aria-hidden="true">
          <svg class="f-theme-icon__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" /></svg>
          <svg class="f-theme-icon__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
        </span>
      </button>
    </div>
  </div>

  <nav class="f-nav-mobile" aria-label="主导航（移动端）">
    {navigation.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>
