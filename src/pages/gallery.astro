---
import Icon from '../components/Icon.astro';
import { getPublicPosts } from '../lib/posts';
import { sortNewestFirst, thumbOf } from '../lib/gallery';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeCopy from '../components/ThemeCopy.astro';
import { safeLink } from '../lib/safe-link';
import standaloneGallery from '../data/gallery.json';

interface GalleryImage {
  id: string;
  src: string;
  thumb?: string;
  alt: string;
  title: string;
  caption?: string;
  date?: string;
  dayIndex?: number;
  daySequence?: number;
  dayTotal?: number;
  sourceUrl?: string;
  sourceTitle?: string;
  original?: string;
}

// 为同一天内的图像分配日内序号（1 = 当天最早），不改变数组本身顺序
const assignDaySequence = (images: GalleryImage[]) => {
  const byDay = new Map<string, GalleryImage[]>();
  for (const image of images) {
    if (!image.date) continue;
    const day = image.date.slice(0, 10);
    const list = byDay.get(day);
    if (list) list.push(image);
    else byDay.set(day, [image]);
  }
  for (const list of byDay.values()) {
    list.sort((a, b) => (a.dayIndex ?? 0) - (b.dayIndex ?? 0));
    list.forEach((image, i) => {
      image.daySequence = i + 1;
      image.dayTotal = list.length;
    });
  }
};

const posts = await getPublicPosts();

const markdownImage = /!\[([^\]]*)\]\(([^)\s]+)(?:\s+["'][^"']*["'])?\)/g;
const journalImages: GalleryImage[] = posts.flatMap((post) => {
    const body = post.body ?? '';
    return [...body.matchAll(markdownImage)].map((match, index) => {
      const src = match[2];
      const fileName = decodeURIComponent(src.split('/').pop() || `image-${index + 1}`);
      return {
        id: `journal-${post.id}-${index + 1}`,
        src,
        alt: match[1] || `${post.data.title}中的图像 ${index + 1}`,
        title: post.data.title,
        caption: match[1] || fileName,
        date: post.data.pubDate.toISOString().slice(0, 10),
        // 继承文章的同日索引号：保证 assignDaySequence 按 dayIndex 分配日内序号，
        // 使同日随文图片/图集在「从新至旧」下按文章发表顺序排列
        dayIndex: post.data.dayIndex ?? 0,
        sourceUrl: `/blog/${post.id}/`,
        sourceTitle: post.data.title,
      };
    });
  }).map((img) => ({ ...img, thumb: img.thumb || thumbOf(img.src) }));

const standaloneImages: GalleryImage[] = sortNewestFirst(standaloneGallery as GalleryImage[]).map((img) => ({
    ...img,
    thumb: img.thumb || thumbOf(img.src),
    sourceUrl: safeLink(img.sourceUrl),
  }));
assignDaySequence(journalImages);
assignDaySequence(standaloneImages);
const totalImages = journalImages.length + standaloneImages.length;

// 按文章(sourceUrl)分组随文图像,生成文章图集视图的数据
interface JournalGroup {
  images: GalleryImage[];
  firstIndex: number;
}
const journalGroupMap = new Map<string, JournalGroup>();
journalImages.forEach((image, index) => {
  const key = image.sourceUrl || '';
  const group = journalGroupMap.get(key);
  if (group) group.images.push(image);
  else journalGroupMap.set(key, { images: [image], firstIndex: index });
});
const journalGroups: JournalGroup[] = [...journalGroupMap.values()];
---

<BaseLayout title="照片" description="Acretiondisk 的照片。">
  <div class="gallery-shell">
    <header class="f-gallery-head">
      <div class="f-fleuron" aria-hidden="true"><i></i></div>
      <div class="f-cover__folio">
        <span>IMAGO</span><span>·</span><span>图志</span><span>·</span><span>VOL. I</span>
      </div>
      <h1 class="f-gallery-head__title">照片</h1>
      <p class="f-gallery-head__deck"><ThemeCopy minimal="文章中的图片，以及单独收藏的照片。" trace="从文字中显影的片段，以及尚未归入卷册的独立收藏。" /></p>
      <div class="f-cover__meta f-gallery-head__stats">
        <span><span>图版</span><b class="f-num">{String(totalImages).padStart(3, '0')}</b></span>
        <span><span>随文图像</span><b class="f-num">{String(journalImages.length).padStart(2, '0')}</b></span>
        <span><span>独立收藏</span><b class="f-num">{String(standaloneImages.length).padStart(2, '0')}</b></span>
      </div>
    </header>

    <div class="gallery-tabs" role="tablist" aria-label="图像档案视图">
      <button class="gallery-tab" type="button" role="tab" aria-selected="true" aria-controls="gallery-journal" id="tab-journal" data-gallery-tab="journal">
        <span class="gallery-tab-index">I</span>
        <span><ThemeCopy minimal="文章图片" trace="随文图像" /></span>
        <b>{String(journalImages.length).padStart(2, '0')}</b>
      </button>
      <button class="gallery-tab" type="button" role="tab" aria-selected="false" aria-controls="gallery-independent" id="tab-independent" data-gallery-tab="independent">
        <span class="gallery-tab-index">II</span>
        <span><ThemeCopy minimal="独立照片" trace="独立收藏" /></span>
        <b>{String(standaloneImages.length).padStart(2, '0')}</b>
      </button>
    </div>

    <div class="gallery-order-bar">
      <div class="gallery-order-label">
        <span>DISPLAY ORDER</span>
        <strong data-gallery-order-status>从新至旧</strong>
      </div>
      <div class="gallery-sort" role="group" aria-label="照片展示顺序">
        <button type="button" data-gallery-sort="newest" aria-pressed="true">
          <span aria-hidden="true"><Icon name="arrow-down" /></span>从新至旧
        </button>
        <button type="button" data-gallery-sort="oldest" aria-pressed="false">
          <span aria-hidden="true"><Icon name="arrow-up" /></span>从旧至新
        </button>
      </div>
    </div>

    <section class="gallery-panel" id="gallery-journal" role="tabpanel" aria-labelledby="tab-journal" data-gallery-panel="journal">
      <div class="gallery-index-bar">
        <span><ThemeCopy minimal="来自文章的图片" trace="IMAGES FOUND IN PUBLISHED FOLIOS" /></span>
        <span><ThemeCopy cyanotype={`${journalImages.length} 次快门 · 随手记显影`} minimal={`${journalImages.length} 张 · 自动整理`} trace={`${journalImages.length} ITEMS / AUTO INDEXED`} /></span>
      </div>
      <div class="gallery-view-bar">
        <div class="gallery-view-label">
          <span>VIEW MODE</span>
          <strong data-gallery-view-status><ThemeCopy minimal="按文章" trace="文章图集" /></strong>
        </div>
        <div class="gallery-view-switch" role="group" aria-label="随文图像展示方式">
          <button type="button" data-gallery-view="timeline" aria-pressed="false">
            <span aria-hidden="true"><Icon name="rows" /></span>时间线
          </button>
          <button type="button" data-gallery-view="albums" aria-pressed="true">
            <span aria-hidden="true"><Icon name="grid" /></span><ThemeCopy minimal="按文章" trace="文章图集" />
          </button>
        </div>
      </div>
      {journalImages.length > 0 ? (
        <div class="gallery-masonry gallery-masonry--journal" data-gallery-masonry hidden>
        </div>
        <nav class="gallery-pager" data-gallery-pager aria-label="随文图像翻页" hidden>
          <button type="button" data-gallery-page="prev" aria-label="上一页"><Icon name="arrow-left" /></button>
          <span class="gallery-pager-status"><b data-gallery-page-current>01</b> / <b data-gallery-page-total>01</b></span>
          <button type="button" data-gallery-page="next" aria-label="下一页"><Icon name="arrow-right" /></button>
        </nav>
        <div class="gallery-albums" data-gallery-albums>
          {journalGroups.map((group, groupIndex) => {
            const lead = group.images[0];
            return (
              <section
                class="gallery-album"
                data-gallery-album
                data-gallery-date={lead.date}
                data-gallery-day-sequence={lead.daySequence ?? 0}
                data-gallery-position={group.firstIndex}
              >
                <header class="gallery-album-head">
                  <div>
                    <span class="gallery-card-label" data-gallery-sequence data-gallery-sequence-cyanotype-prefix="手记 " data-gallery-sequence-minimal-prefix="文章 " data-gallery-sequence-trace-prefix="FOLIO "><ThemeCopy cyanotype={`手记 ${String(groupIndex + 1).padStart(2, '0')}`} minimal={`文章 ${String(groupIndex + 1).padStart(2, '0')}`} trace={`FOLIO ${String(groupIndex + 1).padStart(2, '0')}`} /></span>
                    <span class="gallery-card-label">{lead.date} · {group.images.length} IMAGES</span>
                  </div>
                  <h2>{lead.sourceTitle}</h2>
                  <a href={lead.sourceUrl}><ThemeCopy minimal="阅读全文" trace="阅览全文" /> <Icon name="arrow-up-right" /></a>
                </header>
                <div class="gallery-album-grid">
                  {group.images.map((image, imageIndex) => (
                    <button
                      class="gallery-album-thumb"
                      type="button"
                      data-gallery-open
                      data-gallery-src={image.src}
                      data-gallery-alt={image.alt || image.title}
                      data-gallery-title={image.title}
                      data-gallery-caption={image.caption}
                      data-gallery-source={image.sourceUrl}
                      data-gallery-source-title={image.sourceTitle}
                      aria-label={`查看${image.title}中的${image.caption}`}
                    >
                      <img src={image.thumb || image.src} alt={image.alt || image.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                      <span class="gallery-image-expand" aria-hidden="true"><Icon name="arrow-up-right" /></span>
                      <span class="gallery-album-thumb-index">{String(imageIndex + 1).padStart(2, '0')}</span>
                    </button>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      ) : (
        <div class="gallery-empty"><strong><ThemeCopy minimal="还没有文章图片" trace="尚无随文图像" /></strong><span><ThemeCopy minimal="文章中的图片会自动显示在这里。" trace="等待新的图像进入公开卷册。" /></span></div>
      )}
    </section>

    <section class="gallery-panel" id="gallery-independent" role="tabpanel" aria-labelledby="tab-independent" data-gallery-panel="independent" hidden>
      {standaloneImages.length > 0 && (
        <div class="gallery-billboard" data-gallery-billboard>
          <div class="gallery-billboard-head">
            <span><ThemeCopy minimal="照片轮播" trace="BILLBOARD / FULL COLLECTION" /></span>
            <span data-billboard-caption><ThemeCopy cyanotype={`${standaloneImages.length} 张散页 · 逐一翻看`} minimal={`共 ${standaloneImages.length} 张独立照片`} trace={`轮播全部 ${standaloneImages.length} 张独立收藏`} /></span>
          </div>
          <div class="gallery-billboard-stage">
            <button class="gallery-billboard-arrow" type="button" data-billboard-prev aria-label="上一张"><Icon name="arrow-left" /></button>
            <div class="gallery-billboard-viewport" data-billboard-viewport tabindex="0" aria-label="独立收藏随机广告牌,可横向滚动">
              <div class="gallery-billboard-track" data-billboard-track></div>
            </div>
            <button class="gallery-billboard-arrow" type="button" data-billboard-next aria-label="下一张"><Icon name="arrow-right" /></button>
          </div>
          <div class="gallery-billboard-dots" data-billboard-dots></div>
        </div>
      )}
      <div class="gallery-index-bar">
        <span><ThemeCopy minimal="独立照片" trace="INDEPENDENT IMAGE COLLECTION" /></span>
        <span><ThemeCopy cyanotype={`${standaloneImages.length} 张散页影像`} minimal={`${standaloneImages.length} 张`} trace={`${standaloneImages.length} ITEMS / CURATED`} /></span>
      </div>
      {standaloneImages.length > 0 ? (
        <div class="gallery-masonry gallery-masonry--independent" data-independent-masonry>
        </div>
        <nav class="gallery-pager" data-independent-pager aria-label="独立收藏翻页">
          <button type="button" data-independent-page="prev" aria-label="上一页"><Icon name="arrow-left" /></button>
          <span class="gallery-pager-status"><b data-independent-page-current>01</b> / <b data-independent-page-total>01</b></span>
          <button type="button" data-independent-page="next" aria-label="下一页"><Icon name="arrow-right" /></button>
        </nav>
      ) : (
        <div class="gallery-empty gallery-empty--independent">
          <img class="archive-seal" src="/logo.webp" alt="" width="180" height="180" loading="lazy" />
          <strong><ThemeCopy minimal="还没有独立照片" trace="独立收藏尚未入藏" /></strong>
          <span><ThemeCopy minimal="单独收藏的照片会显示在这里。" trace="此处保留给未附着于文章的图像记录。" /></span>
        </div>
      )}
    </section>

    <footer class="gallery-footer">
      <span><ThemeCopy minimal="照片与文章同步整理" trace="IMAGO / INDEXED WITH THE PUBLISHED ARCHIVE" /></span>
      <span>{new Date().getFullYear()} · ACR—GALLERY</span>
    </footer>
  </div>
</BaseLayout>

<dialog class="gallery-viewer" id="gallery-viewer" aria-labelledby="gallery-viewer-title">
  <div class="gallery-viewer-frame">
    <button class="gallery-viewer-close" type="button" data-gallery-close aria-label="关闭图像预览"><Icon name="close" /></button>
    <div class="gallery-viewer-media" id="gallery-viewer-media"><img id="gallery-viewer-image" alt="" referrerpolicy="no-referrer" draggable="false" /></div>
    <div class="gallery-viewer-tools">
      <button class="gallery-viewer-original" type="button" data-gallery-original-btn hidden>加载原图</button>
      <label class="gallery-viewer-zoom">
        <span>缩放</span>
        <input type="range" min="100" max="400" step="5" value="100" data-gallery-zoom aria-label="图像缩放" />
        <b data-gallery-zoom-label>100%</b>
      </label>
      <button class="gallery-viewer-reset" type="button" data-gallery-zoom-reset>复位</button>
    </div>
    <footer class="gallery-viewer-meta">
      <div>
        <span class="gallery-card-label" id="gallery-viewer-caption"></span>
        <h2 id="gallery-viewer-title"></h2>
      </div>
      <a id="gallery-viewer-source" href="#" hidden>查看来源 <Icon name="arrow-up-right" /></a>
    </footer>
  </div>
</dialog>

<script type="application/json" id="journal-pool" set:html={JSON.stringify(journalImages).replace(/</g, '\\u003c')}></script>
<script type="application/json" id="gallery-pool" set:html={JSON.stringify(standaloneImages).replace(/</g, '\\u003c')}></script>

<script>
  import '../scripts/gallery-page';
</script>

<style is:global>
  /* ── 图志页：把 legacy 的档案头 / 药丸 tab / 卡片盒接管为 Folio 版式。
     仅视觉层覆盖，class 名、data-* 契约与 DOM 层级保持原样（gallery-page.ts 依赖）。 ── */
  @layer components {
    /* ===== 页头：章节头（饰花 + 徽标 + 标题 + 说明 + 等宽统计） ===== */
    .f-gallery-head {
      padding-block: var(--p-sp-8) var(--p-sp-6);
      border-bottom: 1px solid var(--c-rule-strong);
      text-align: center;
    }
    .f-gallery-head .f-fleuron { margin-bottom: var(--p-sp-4); }
    .f-gallery-head__title {
      margin-top: var(--p-sp-5);
      font-family: var(--hero-font);
      font-size: var(--type-title);
      font-weight: var(--hero-weight);
      font-synthesis-weight: none;
      letter-spacing: -.03em;
      line-height: 1.15;
    }
    .f-gallery-head__deck {
      max-width: 34em;
      margin: var(--p-sp-4) auto 0;
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--type-lead);
      line-height: 1.75;
      color: var(--c-ink-2);
    }
    .f-gallery-head__stats { margin-top: var(--p-sp-6); }
    .f-gallery-head__stats b {
      font-family: var(--font-mono);
      font-size: var(--type-meta);
      font-weight: 400;
      letter-spacing: .04em;
      color: var(--c-ink);
      font-variant-numeric: tabular-nums;
    }

    /* ===== tabs：下划线式，选中仅 2px 铜线下划线 ===== */
    .gallery-tabs {
      display: flex;
      grid-template-columns: none;
      gap: var(--p-sp-6);
      margin: var(--p-sp-5) 0 0;
      padding: 0;
      overflow: visible;
      border: 0;
      border-bottom: 1px solid var(--c-rule);
      border-radius: 0;
      background: transparent;
    }
    .gallery-tab {
      position: relative;
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      min-height: 0;
      padding: 0 0 var(--p-sp-3);
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-meta);
      letter-spacing: .02em;
      box-shadow: none;
      transition: color .12s var(--p-ease);
    }
    .gallery-tab::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: transparent;
      transition: background-color .12s var(--p-ease);
    }
    .gallery-tab:hover { color: var(--c-ink-2); background: transparent; }
    .gallery-tab[aria-selected='true'] { color: var(--c-ink); background: transparent; box-shadow: none; }
    .gallery-tab[aria-selected='true']::after { background: var(--c-metal); }
    .gallery-tab-index {
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: .1em;
      color: var(--c-metal);
    }
    .gallery-tab b {
      display: inline;
      min-width: 0;
      width: auto;
      height: auto;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--c-ink-3);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      font-weight: 400;
      letter-spacing: .06em;
    }

    /* ===== 排序条 / 视图切换条：细线 + 等宽小字，去掉填充与描边盒 ===== */
    .gallery-order-bar,
    .gallery-view-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--p-sp-3) var(--p-sp-4);
      min-height: 0;
      margin: 0;
      padding-block: var(--p-sp-3);
      border: 0;
      border-bottom: 1px solid var(--c-rule);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .gallery-order-label,
    .gallery-view-label {
      display: inline-flex;
      align-items: baseline;
      gap: 10px;
      padding: 0;
      color: var(--c-ink-3);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .gallery-order-label strong,
    .gallery-view-label strong {
      color: var(--c-ink);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      font-weight: 500;
      letter-spacing: .04em;
    }
    .gallery-sort,
    .gallery-view-switch {
      display: flex;
      grid-template-columns: none;
      gap: var(--p-sp-5);
      border: 0;
      border-radius: 0;
      background: transparent;
    }
    .gallery-sort button,
    .gallery-view-switch button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-width: 0;
      min-height: 0;
      padding: 2px 0 6px;
      border: 0;
      border-bottom: 1px solid transparent;
      border-radius: 0;
      background: transparent;
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-meta);
      letter-spacing: .02em;
      box-shadow: none;
      transition: color .12s var(--p-ease), border-color .12s var(--p-ease);
    }
    .gallery-sort button span,
    .gallery-view-switch button span {
      color: inherit;
      font-family: inherit;
      font-size: inherit;
    }
    .gallery-sort button svg,
    .gallery-view-switch button svg { width: 12px; height: 12px; }
    .gallery-sort button:hover,
    .gallery-view-switch button:hover,
    .gallery-sort button[aria-pressed='true'],
    .gallery-view-switch button[aria-pressed='true'] {
      color: var(--c-ink);
      background: transparent;
      box-shadow: none;
    }
    .gallery-sort button:hover,
    .gallery-view-switch button:hover { border-bottom-color: var(--c-rule-strong); }
    .gallery-sort button[aria-pressed='true'],
    .gallery-view-switch button[aria-pressed='true'] { border-bottom-color: var(--c-metal); }

    /* ===== 索引条 ===== */
    .gallery-index-bar {
      display: flex;
      justify-content: space-between;
      gap: var(--p-sp-4);
      padding: var(--p-sp-3) 0;
      border-bottom: 1px solid var(--c-rule);
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: .06em;
    }

    /* ===== 文章图集 ===== */
    .gallery-albums { padding: var(--p-sp-6) 0 var(--p-sp-8); }
    .gallery-album {
      overflow: visible;
      padding: var(--p-sp-6) 0;
      border: 0;
      border-bottom: 1px solid var(--c-rule);
      border-radius: 0;
      background: transparent;
    }
    .gallery-album-head {
      align-items: baseline;
      gap: var(--p-sp-3);
      margin-bottom: var(--p-sp-4);
    }
    .gallery-album-head > div { gap: var(--p-sp-3); }
    .gallery-album-head h2 {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--type-h2);
      font-weight: 500;
      letter-spacing: 0;
    }
    .gallery-album-head a {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: .04em;
    }
    .gallery-album-head a:hover { color: var(--c-metal); }
    .gallery-album-head a svg { width: 11px; height: 11px; }
    .gallery-album-grid { gap: var(--p-sp-3); }
    .gallery-album-thumb {
      overflow: hidden;
      border: 1px solid var(--c-rule-strong);
      border-radius: var(--r-frame);
      background: var(--c-paper-sunken);
    }
    .gallery-album-thumb img { height: 132px; filter: none; }
    .gallery-album-thumb:hover img { filter: none; transform: scale(1.02); }

    /* ===== 时间线图卡 ===== */
    .gallery-masonry {
      column-count: 3;
      column-gap: var(--p-sp-5);
      padding: var(--p-sp-6) 0 var(--p-sp-7);
