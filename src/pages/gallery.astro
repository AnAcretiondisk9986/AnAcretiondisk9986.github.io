---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicPosts } from '../lib/posts';
import { sortNewestFirst, thumbOf } from '../lib/gallery';
import { safeLink } from '../lib/safe-link';
import standaloneGallery from '../data/gallery.json';
import '../styles/hz/gallery.css';

interface GalleryItem {
  id: string;
  src: string;
  thumb?: string;
  original?: string;
  alt: string;
  title: string;
  caption?: string;
  date?: string;
  dayIndex?: number;
  sourceUrl?: string;
  sourceTitle?: string;
}

const posts = await getPublicPosts();
const markdownImage = /!\[([^\]]*)\]\(([^)\s]+)(?:\s+["'][^"']*["'])?\)/g;

const journalImages: GalleryItem[] = posts.flatMap((post) => {
  const body = post.body ?? '';
  return [...body.matchAll(markdownImage)].map((match, idx) => {
    const src = match[2];
    const fileName = decodeURIComponent(src.split('/').pop() || `image-${idx + 1}`);
    return {
      id: `journal-${post.id}-${idx + 1}`,
      src,
      thumb: thumbOf(src),
      alt: match[1] || `${post.data.title} 中的图像 ${idx + 1}`,
      title: post.data.title,
      caption: match[1] || fileName,
      date: post.data.pubDate.toISOString().slice(0, 10),
      dayIndex: post.data.dayIndex ?? 0,
      sourceUrl: `/blog/${post.id}/`,
      sourceTitle: post.data.title,
    };
  });
});

const standaloneImages: GalleryItem[] = sortNewestFirst(standaloneGallery as GalleryItem[]).map((img) => ({
  ...img,
  thumb: img.thumb || thumbOf(img.src),
  sourceUrl: safeLink(img.sourceUrl),
}));

const totalCount = standaloneImages.length + journalImages.length;
---

<BaseLayout title="图像透镜" description="Acretiondisk 的独立影像收藏与文章随文图版。" page="lensing">
  <div class="hz-wrap hz-gal" data-gal-root>
    <header class="hz-gal-head">
      <p class="hz-mono hz-gal-head__kicker">GRAVITATIONAL LENSING // 04 · <span lang="ja">重力レンズ図誌</span></p>
      <h1 class="hz-gal-head__title">图像档案</h1>
      <p class="hz-gal-head__deck">
        独立收藏的散页影像与文章中显影的摄影片段。拖拽透镜场以引力放大局部，或切换为索引网格翻阅。
      </p>
    </header>

    <div class="hz-gal-bar">
      <div class="hz-gal-tabs" role="tablist" aria-label="图像集合">
        <button type="button" role="tab" data-gal-tab="plates" aria-selected="true">
          <span>独立收藏</span>
          <b>{String(standaloneImages.length).padStart(2, '0')}</b>
        </button>
        <button type="button" role="tab" data-gal-tab="journal" aria-selected="false">
          <span>随文影像</span>
          <b>{String(journalImages.length).padStart(2, '0')}</b>
        </button>
        <button type="button" role="tab" data-gal-tab="all" aria-selected="false">
          <span>全部</span>
          <b>{String(totalCount).padStart(2, '0')}</b>
        </button>
      </div>

      <div class="hz-gal-tools">
        <label class="sr-only" for="hz-gal-filter">检索图像关键词、日期或来源</label>
        <input
          id="hz-gal-filter"
          class="hz-gal-filter"
          type="search"
          data-gal-filter
          placeholder="检索日期、来源或标签…"
          autocomplete="off"
        />

        <div class="hz-seg" role="group" aria-label="排序">
          <button type="button" data-gal-sort="newest" aria-pressed="true">最新</button>
          <button type="button" data-gal-sort="oldest" aria-pressed="false">最早</button>
        </div>

        <div class="hz-seg" role="group" aria-label="视图模式">
          <button type="button" data-gal-mode="field" aria-pressed="true">透镜场</button>
          <button type="button" data-gal-mode="index" aria-pressed="false">索引</button>
        </div>

        <span class="hz-mono" data-gal-count>{standaloneImages.length} PLATES</span>
      </div>
    </div>

    <section class="hz-field-wrap" data-gal-field-wrap aria-label="引力透镜交互视场">
      <div class="hz-field-hud hz-mono">
        <span class="hz-field-hud__tele">
          <span lang="ja">重力場</span>
          <span data-field-coord>OFFSET [0, 0]</span>
          <span data-field-zoom>ZOOM 100%</span>
        </span>
        <div class="hz-field-hud__btns">
          <button type="button" class="hz-mini-btn" data-field-random>随机跳转 ↗</button>
          <button type="button" class="hz-mini-btn" data-field-orbit>RE-ORBIT</button>
          <button type="button" class="hz-mini-btn" data-field-reset>RESET</button>
        </div>
      </div>

      <div
        class="hz-field-stage"
        data-field-stage
        tabindex="0"
        aria-label="可拖拽平移与滚轮双指缩放的图像透镜场"
      >
        <div class="hz-field-canvas" data-field-canvas></div>
        <div class="hz-field-reticle" aria-hidden="true"></div>
      </div>
    </section>

    <section class="hz-index-wrap" data-gal-index-wrap hidden aria-label="图像索引网格">
      <div class="hz-index-grid" data-index-grid></div>
      <nav class="hz-gal-pager" aria-label="图像分页">
        <button type="button" class="hz-mini-btn" data-page-prev>← 上一页</button>
        <span class="hz-mono" data-page-status>01 / 01</span>
        <button type="button" class="hz-mini-btn" data-page-next>下一页 →</button>
      </nav>
    </section>
  </div>
</BaseLayout>

<dialog class="hz-viewer" id="hz-viewer" aria-label="图像查看器">
  <div class="hz-viewer__shell">
    <div class="hz-viewer__top">
      <div class="hz-viewer__nav">
        <button type="button" class="hz-mini-btn" data-viewer-prev aria-label="上一张">← PREV</button>
        <button type="button" class="hz-mini-btn" data-viewer-next aria-label="下一张">NEXT →</button>
      </div>
      <button type="button" class="hz-mini-btn" data-viewer-close aria-label="关闭灯箱">CLOSE ✕</button>
    </div>

    <div class="hz-viewer__media" data-viewer-media>
      <img data-viewer-img alt="" referrerpolicy="no-referrer" draggable="false" />
    </div>

    <div class="hz-viewer__tools">
      <div class="hz-viewer__zoom">
        <span class="hz-mono">ZOOM</span>
        <input type="range" min="100" max="400" step="1" value="100" data-viewer-zoom aria-label="缩放比例" />
        <b class="hz-mono" data-viewer-zoom-val>100%</b>
        <button type="button" class="hz-mini-btn" data-viewer-reset>复位</button>
      </div>
      <div class="hz-viewer__zoom">
        <button type="button" class="hz-mini-btn" data-viewer-original hidden>加载无损原图</button>
        <a class="hz-mini-btn" data-viewer-source href="#" hidden>查看来源文章 ↗</a>
      </div>
    </div>
  </div>
</dialog>

<script type="application/json" id="hz-plates-pool" set:html={JSON.stringify(standaloneImages).replace(/</g, '\\u003c')}></script>
<script type="application/json" id="hz-journal-pool" set:html={JSON.stringify(journalImages).replace(/</g, '\\u003c')}></script>

<script>
  import '../scripts/hz/gallery-field';
</script>
