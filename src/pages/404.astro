---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <section class="f-section f-notfound" aria-labelledby="nf-title">
    <div class="f-frame f-frame--plain">
      <span class="f-crop f-crop--tl"></span><span class="f-crop f-crop--tr"></span>
      <span class="f-crop f-crop--bl"></span><span class="f-crop f-crop--br"></span>
      <div class="f-cover__inner">
        <div class="f-fleuron" aria-hidden="true"><i></i></div>
        <div class="f-cover__folio"><span>IV · 04</span><span>·</span><span>FOLIO NON INVENTUM</span></div>
        <h1 id="nf-title" class="f-notfound__title">页面不存在</h1>
        <p class="f-cover__deck">链接可能有误，或这一页已经被移到新的编目位置。</p>
        <div class="f-actions">
          <a class="f-btn" href="/">返回首页 <Icon name="arrow-right" /></a>
          <a class="f-btn f-btn--ghost" href="/blog/">浏览编目</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @layer components {
    .f-notfound { padding-block: var(--p-sp-8) var(--p-sp-8); display: grid; justify-items: center; }
    /* 404 的框不要跟着 1637px 的壳层无限拉宽：单独限一个"一页纸"的宽度 */
    .f-notfound .f-frame {
      width: min(100%, 58rem);
      margin-inline: auto;
      padding-block: clamp(3.5rem, 9vw, 8rem);
    }
    .f-frame--plain { padding-block: clamp(56px, 12vw, 140px); }
    .f-notfound__title {
      font-family: var(--hero-font);
      font-size: var(--type-display);
      font-weight: var(--hero-weight);
      font-synthesis-weight: none;
      letter-spacing: var(--track-cjk-display);
      line-height: var(--lh-display);
      margin-top: var(--p-sp-5);
    }
  }
</style>
