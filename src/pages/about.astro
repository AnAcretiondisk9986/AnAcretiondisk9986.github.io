---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveSeal from '../components/ArchiveSeal.astro';
import about from '../data/about.json';
---

<BaseLayout title={about.title || '关于'} description={about.subtitle || '关于 Acretiondisk。'}>
  <article class="dossier">
    <header class="dossier-header">
      <div>
        <p class="eyebrow">{about.eyebrow}</p>
        <h1>{about.title}</h1>
        <p>{about.subtitle}</p>
      </div>
      <ArchiveSeal class="dossier-seal" />
    </header>

    <div class="dossier-grid">
      <section class="portrait-record">
        <div class:list={['portrait-placeholder', about.avatar ? 'has-avatar' : '']} aria-label="Acretiondisk 个人标记">
          {about.avatar
            ? <img src={about.avatar} alt="Acretiondisk 头像" loading="lazy" />
            : (<><ArchiveSeal /><span>ACR</span></>)}
        </div>
        <dl class="identity-table">
          {
            (about.identity || []).map(item => (
              <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
            ))
          }
        </dl>
      </section>

      <section class="dossier-copy">
        {about.lead && <p class="lead-paragraph">{about.lead}</p>}
        {
          (about.paragraphs || []).map(text => (
            <p>{text}</p>
          ))
        }

        <blockquote>
          <span>{about.quoteLabel}</span>
          {about.quoteText}
        </blockquote>

        <div class="interest-index">
          <h2>{about.interestsTitle}</h2>
          <ol>
            {
              (about.interests || []).map(item => (
                <li><span>{item.index}</span><b>{item.name}</b><small>{item.note}</small></li>
              ))
            }
          </ol>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
