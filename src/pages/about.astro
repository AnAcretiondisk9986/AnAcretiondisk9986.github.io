---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeCopy from '../components/ThemeCopy.astro';
import WordCloud from '../components/WordCloud.astro';
import { safeLink } from '../lib/safe-link';
import { getPublicPosts } from '../lib/posts';
import { buildWordCloud } from '../lib/wordcloud';
import about from '../data/about.json';

// 头像已是图片仓库的 jsDelivr 外链，直接引用
const avatarSrc = about.avatar ?? '';

// 个人页词云：构建时统计全部公开文章（标题 + 正文）的词频，
// 与卷册目录共用同一份数据链路，文章更新后重新构建即自动刷新。
const cloudWords = buildWordCloud(
  (await getPublicPosts()).map((post) => ({ title: post.data.title, body: post.body ?? '' })),
);

// 把文本中的 http(s) 链接转换为可点击 <a>。
// 先转义再替换，防 HTML/属性注入；仅识别 http/https，其余原样输出。
// 所有经管理面板可编辑的文本字段统一走此函数，后续新增字段粘贴链接即可跳转。
function linkify(text = '') {
  const escaped = String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
  return escaped.replace(
    // URL 字符集采用 RFC 3986 合法字符，匹配在非 URL 字符（如中文标点）处自然停止
    /https?:\/\/[A-Za-z0-9\-._~:\/?#\[\]@!$&'()*+,;=%]+/g,
    (raw) => {
      // 剥离 URL 尾部成对标点（英文/全角），避免把句号收进链接
      const url = raw.replace(/[),.;:!?]+$/, '').replace(/[）】」』，。；：！？、]+$/, '');
      if (!url) return raw;
      return `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`;
    },
  );
}
---

<BaseLayout title={about.title || '关于'} description={about.subtitle || '关于 Acretiondisk。'}>
  <article class="dossier">
    <header class="dossier-header">
      <div>
        <p class="eyebrow"><ThemeCopy minimal={about.eyebrow} trace={about.eyebrow} cyanotype="BEHIND THE PRINT / 04" /></p>
        <h1><ThemeCopy minimal={about.title} trace={about.title} cyanotype="底片背面" /></h1>
        <p><ThemeCopy minimal={about.subtitle} trace={about.subtitle} cyanotype="作品之外，还有一个不断观察、尝试、偶尔推翻自己的我。" /></p>
      </div>
      <img class="archive-seal dossier-seal" src="/logo.webp" alt="" width="260" height="260" loading="lazy" />
    </header>

    <a class="private-channel private-channel--dossier" href="/private/">
      <span class="private-channel__copy"><ThemeCopy minimal="私密文章" trace="私密卷册" /><small>PRIVATE ARCHIVE · 需要密码</small></span>
      <span class="private-channel__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
    </a>

    <section class="appearance-settings" aria-labelledby="appearance-heading">
      <div class="appearance-heading">
        <p class="eyebrow">APPEARANCE</p>
        <h2 id="appearance-heading"><ThemeCopy minimal="外观" trace="界面主题" /></h2>
      </div>
      <div class="appearance-selector" role="group" aria-label="界面主题">
        <button type="button" data-visual-theme-option="cyanotype" aria-pressed="false">
          <span class="appearance-swatch appearance-swatch--cyanotype" aria-hidden="true"></span><span>蓝晒</span>
        </button>
        <button type="button" data-visual-theme-option="still" aria-pressed="false">
          <span class="appearance-swatch appearance-swatch--still" aria-hidden="true"></span>
          <span>静澈</span>
        </button>
        <button type="button" data-visual-theme-option="fluid" aria-pressed="false">
          <span class="appearance-swatch appearance-swatch--fluid" aria-hidden="true"></span>
          <span>流形</span>
        </button>
        <button type="button" data-visual-theme-option="minimal" aria-pressed="false">
          <span class="appearance-swatch appearance-swatch--minimal" aria-hidden="true"></span>
          <span>留白</span>
        </button>
        <button type="button" data-visual-theme-option="trace" aria-pressed="false">
          <span class="appearance-swatch appearance-swatch--trace" aria-hidden="true"></span>
          <span>行迹</span>
        </button>
      </div>
      <span class="sr-only" data-visual-theme-status aria-live="polite"></span>
    </section>

    <div class="dossier-grid">
      <section class="portrait-record">
        <div class:list={['portrait-placeholder', avatarSrc ? 'has-avatar' : '']} aria-label="Acretiondisk 个人标记">
          {avatarSrc
            ? <img src={avatarSrc} alt="Acretiondisk 头像" loading="lazy" />
            : (<><img class="archive-seal" src="/logo.webp" alt="Acretiondisk 标记" width="260" height="260" loading="lazy" /><span>ACR</span></>)}
        </div>
        <dl class="identity-table">
          {
            (about.identity || []).map(item => (
              <div><dt>{item.label}</dt><dd set:html={linkify(item.value)} /></div>
            ))
          }
        </dl>
      </section>

      <section class="dossier-copy">
        {about.lead && <p class="lead-paragraph" set:html={linkify(about.lead)} />}
        {
          (about.paragraphs || []).map(text => (
            <p set:html={linkify(text)} />
          ))
        }

        <blockquote>
          <span class="quote-label">{about.quoteLabel}</span>
          <div class="quote-text" set:html={linkify(about.quoteText)} />
        </blockquote>

        <div class="interest-index">
          <h2>{about.interestsTitle}</h2>
          <ol>
            {
              (about.interests || []).map(item => (
                <li><span>{item.index}</span><b>{item.name}</b><small set:html={linkify(item.note)} /></li>
              ))
            }
          </ol>
        </div>

        {
          about.projectsTitle && (
            <div class="interest-index project-index">
              <h2>{about.projectsTitle}</h2>
              <ol>
                {
                  (about.projects || []).map(item => {
                    // 仅放行 http(s) 链接（safeLink 其余返回空串），标题已由管理面板解析或手动填写，空时兜底显示裸网址
                    const href = safeLink(item.url);
                    return (
                      <li><span>{item.index}</span><b>{item.name}</b><small>{href ? <a href={href} target="_blank" rel="noopener noreferrer">{item.title || item.url}</a> : (item.title || '')}</small></li>
                    );
                  })
                }
              </ol>
            </div>
          )
        }
      </section>
    </div>

    <div class="dossier-wordcloud">
      <WordCloud words={cloudWords} />
    </div>
  </article>
</BaseLayout>

<style>
  /* 词云区块默认宽度取 --content-width(相对 main 再减 32px),直接嵌进个人档案会
     比上方正文左右各内缩 16px;这里让它铺满档案内容宽度,与标题左对齐。
     用 .dossier 前缀提高特异性,避免被各视觉主题对 .wordcloud-section 的规则盖掉。 */
  .dossier .dossier-wordcloud :global(.wordcloud-section) {
    width: auto;
    margin-inline: 0;
  }
</style>

<style is:global>
  /* ── 关于页：外观选择器 ──
     .dossier 的版式（页头 / 头像 + 正文 measure / 兴趣索引 / 词云）统一放在
     src/styles/pages-next.css 的 components 层；这里只保留本页独有的外观设置块。 */
  @layer components {
    .appearance-settings {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--p-sp-4) var(--p-sp-6);
      margin-block: var(--p-sp-6);
      padding-block: var(--p-sp-5);
      border-block: 1px solid var(--c-rule);
    }
    .appearance-heading .eyebrow {
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: var(--track-caps);
      text-transform: uppercase;
      color: var(--c-metal);
    }
    .appearance-heading h2 {
      margin: 6px 0 0;
      font-family: var(--font-display);
      font-size: var(--type-h2);
      font-weight: 600;
      line-height: var(--lh-title);
    }
    .appearance-selector {
      display: flex;
      flex-wrap: wrap;
      gap: var(--p-sp-2);
      margin-top: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
    }
    .appearance-selector button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 0;
      padding: 8px 14px;
      border: 1px solid var(--c-rule);
      border-radius: var(--r-frame);
      background: transparent;
      box-shadow: none;
      color: var(--c-ink-2);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      font-weight: 400;
      letter-spacing: .1em;
      transition: border-color var(--p-dur-fast) var(--p-ease),
                  background var(--p-dur-fast) var(--p-ease),
                  color var(--p-dur-fast) var(--p-ease);
    }
    .appearance-selector button:hover {
      border-color: var(--c-metal);
      color: var(--c-ink);
    }
    .appearance-selector button:active {
      transform: none;
    }
    .appearance-selector button[aria-pressed='true'] {
      border-color: var(--c-ink);
      background: var(--c-ink);
      box-shadow: none;
      color: var(--c-paper);
    }
    .appearance-selector button:focus-visible {
      outline: 1px solid var(--c-metal);
      outline-offset: 2px;
    }
    .appearance-swatch {
      width: 11px;
      height: 11px;
      flex: none;
      border: 1px solid var(--c-rule-strong);
      border-radius: 50%;
      box-shadow: none;
    }
    /* 色点表示各主题的原型强调色；L2 语义色只描述"当前"主题，
       跨主题预览只能用 L1 原始色 + color-mix 压向纸面，保持与旧值几乎一致。 */
    .appearance-swatch--cyanotype { background: color-mix(in oklab, var(--p-blue-600) 94%, var(--c-ink)); }
    .appearance-swatch--still { background: color-mix(in oklab, var(--p-green-700) 94%, var(--c-ink)); }
    .appearance-swatch--fluid { background: color-mix(in oklab, var(--p-teal-600) 94%, var(--c-ink)); }
    .appearance-swatch--minimal { background: color-mix(in oklab, var(--p-brick-600) 94%, var(--c-ink)); }
    .appearance-swatch--trace { background: color-mix(in oklab, var(--p-cyan-500) 94%, var(--c-ink)); }

    @media (max-width: 860px) {
      .appearance-settings {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--p-sp-4);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .appearance-selector button { transition: none; }
    }
  }
</style>

<script>
  /**
   * 外观切换（FOLIO）。
   * 主题 CSS 已不再按需加载：5 套主题现在只是 folio.css 里的 token 块，
   * 切主题 = 改 <html data-visual-theme>，没有任何样式表下载或替换。
   */
  type VisualTheme = 'cyanotype' | 'still' | 'fluid' | 'minimal' | 'trace';

  const THEMES: VisualTheme[] = ['cyanotype', 'still', 'fluid', 'minimal', 'trace'];
  const THEME_NAMES: Record<VisualTheme, string> = {
    cyanotype: '蓝晒', still: '静澈', fluid: '流形', minimal: '留白', trace: '行迹',
  };

  const initializedThemeButtons = new WeakSet<HTMLButtonElement>();

  function initVisualThemePicker() {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-visual-theme-option]')];
    const status = document.querySelector<HTMLElement>('[data-visual-theme-status]');
    if (buttons.length === 0) return;

    const sync = (theme: VisualTheme) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.visualThemeOption === theme));
      });
      if (status) status.textContent = `已切换为${THEME_NAMES[theme]}主题`;
    };

    const currentValue = document.documentElement.dataset.visualTheme as VisualTheme;
    sync(THEMES.includes(currentValue) ? currentValue : 'cyanotype');

    buttons.forEach((button) => {
      if (initializedThemeButtons.has(button)) return;
      initializedThemeButtons.add(button);
      button.addEventListener('click', () => {
        const option = button.dataset.visualThemeOption as VisualTheme;
        const theme: VisualTheme = THEMES.includes(option) ? option : 'cyanotype';
        if (document.documentElement.dataset.visualTheme === theme) return;

        const apply = () => {
          document.documentElement.dataset.visualTheme = theme;
          try { localStorage.setItem('visual-theme', theme); } catch {}
          sync(theme);
        };

        if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.startViewTransition(apply);
        } else {
          apply();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initVisualThemePicker);
</script>
