---
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeLink } from '../lib/safe-link';
import { getPublicPosts } from '../lib/posts';
import { buildWordCloud } from '../lib/wordcloud';
import { fmtMass, linkify, massOf } from '../lib/horizon';
import about from '../data/about.json';
import standaloneGallery from '../data/gallery.json';
import '../styles/hz/about.css';

const posts = await getPublicPosts();
const totalChars = posts.reduce((sum, p) => sum + massOf(p.body ?? ''), 0);
const cloudWords = buildWordCloud(
  posts.map((post) => ({ title: post.data.title, body: post.body ?? '' })),
);
const maxWeight = Math.max(1, ...cloudWords.map((w) => w.weight));
const minWeight = Math.min(...cloudWords.map((w) => w.weight), 0);
const normW = (w: number) =>
  maxWeight > minWeight ? (w - minWeight) / (maxWeight - minWeight) : 0.5;
---

<BaseLayout title={about.title || '关于'} description={about.subtitle || '关于 Acretiondisk。'} page="observer">
  <article class="hz-wrap hz-about">
    <header class="hz-about-head">
      <div>
        <p class="hz-mono hz-about-head__kicker">OBSERVER DOSSIER // 04 · <span lang="ja">観測者記録</span></p>
        <h1 class="hz-about-head__title">{about.title || '编目者档案'}</h1>
        {about.subtitle && <p class="hz-about-head__sub">{about.subtitle}</p>}
      </div>
      <a class="hz-btn" href="/private/">
        <span>进入暗房 · 私密文章</span>
        <span aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="hz-about-grid">
      <aside class="hz-about-side">
        <div class="hz-avatar-ring">
          <img
            src={about.avatar || '/logo.webp'}
            alt="Acretiondisk 头像"
            loading="eager"
            decoding="async"
          />
        </div>

        <dl class="hz-dl">
          {(about.identity || []).map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd set:html={linkify(item.value)} />
            </div>
          ))}
          <div><dt>公开手记</dt><dd>{posts.length} 篇</dd></div>
          <div><dt>累计字符</dt><dd>{fmtMass(totalChars)}</dd></div>
          <div><dt>独立图版</dt><dd>{(standaloneGallery as unknown[]).length} 幅</dd></div>
        </dl>

        <a class="hz-mini-btn" href="/ai-quota/">查看 AI 算力额度监控 ↗</a>
      </aside>

      <div class="hz-about-body">
        <section class="hz-about-copy">
          {about.lead && <p class="hz-about-copy__lead" set:html={linkify(about.lead)} />}
          {(about.paragraphs || []).map((text) => (
            <p set:html={linkify(text)} />
          ))}

          {about.quoteText && (
            <blockquote class="hz-about-quote">
              <span class="hz-mono">{about.quoteLabel || 'PRINCIPLE'}</span>
              <div set:html={linkify(about.quoteText)} />
            </blockquote>
          )}
        </section>

        {(about.interests || []).length > 0 && (
          <section class="hz-ledger-box" aria-labelledby="about-links">
            <h2 id="about-links">{about.interestsTitle || '关联网站'}</h2>
            <ol class="hz-ledger-list">
              {(about.interests || []).map((item) => (
                <li>
                  <span>{item.index}</span>
                  <b>{item.name}</b>
                  <small set:html={linkify(item.note)} />
                </li>
              ))}
            </ol>
          </section>
        )}

        {(about.projects || []).length > 0 && (
          <section class="hz-ledger-box" aria-labelledby="about-projects">
            <h2 id="about-projects">{about.projectsTitle || '我的项目'}</h2>
            <ol class="hz-ledger-list">
              {(about.projects || []).map((item) => {
                const href = safeLink(item.url);
                return (
                  <li>
                    <span>{String(item.index).padStart(2, '0')}</span>
                    <b>{item.name}</b>
                    <small>
                      {href ? (
                        <a href={href} target="_blank" rel="noopener noreferrer">
                          {item.title || item.url} ↗
                        </a>
                      ) : (
                        item.title || ''
                      )}
                    </small>
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </div>
    </div>

    {cloudWords.length > 0 && (
      <section class="hz-freq" aria-labelledby="about-freq">
        <div class="hz-freq__head">
          <div>
            <p class="hz-mono" style="color:var(--hz-hot-ink);margin-bottom:4px;">LEXICON SPECTRUM</p>
            <h2 id="about-freq">全站词频光谱</h2>
          </div>
          <p class="hz-mono">CLICK ANY TERM TO FILTER /BLOG/</p>
        </div>

        <div class="hz-freq__wall">
          {cloudWords.map((w) => {
            const ratio = normW(w.weight);
            return (
              <a
                class="hz-freq__word"
                href={`/blog/?q=${encodeURIComponent(w.text)}`}
                style={`--w:${ratio.toFixed(3)};--w-int:${Math.round(ratio * 5)}`}
                title={`出现 ${w.count} 次 · 点击在文章目录中搜索「${w.text}」`}
              >
                <span>{w.text}</span>
                <small>{w.count}</small>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
