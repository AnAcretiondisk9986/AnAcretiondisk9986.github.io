---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveSeal from '../components/ArchiveSeal.astro';
import ThemeCopy from '../components/ThemeCopy.astro';
---

<BaseLayout title="留言" description="在 Acretiondisk 的卷末留下批注。">
  <div class="guestbook-shell">
    <header class="guestbook-header">
      <div class="guestbook-header-copy">
        <div class="folio-kicker">
          <span>EPISTULAE / PERSONAL ARCHIVE</span>
          <span>VOL. I · MMXXVI</span>
        </div>
        <p class="eyebrow">MARGINALIA OF THE CODEX</p>
        <h1>
          <ThemeCopy minimal="留言">
            <Fragment slot="trace">卷末<br /><em>留言</em></Fragment>
          </ThemeCopy>
        </h1>
        <p class="guestbook-intro"><ThemeCopy minimal="写下想说的话。仅支持文字，最多 300 字，发布后显示 IP 属地。" trace="在编目册的空白处，留下你的批注。仅文字，上限三百字，发送后展示 IP 属地。" /></p>
      </div>
      <div class="guestbook-header-mark">
        <ArchiveSeal />
        <dl>
          <div><dt>留言总数</dt><dd data-guestbook-count>—</dd></div>
          <div><dt><ThemeCopy minimal="字数上限" trace="单条上限" /></dt><dd>300 字</dd></div>
          <div><dt>属地标注</dt><dd>省 / 国家</dd></div>
        </dl>
      </div>
    </header>

    <section class="guestbook-compose" aria-label="发表留言">
      <div class="guestbook-avatar" data-guestbook-avatar aria-hidden="true">匿</div>
      <div class="guestbook-compose-main">
        <input
          class="guestbook-nick"
          type="text"
          placeholder="你的称呼（可编辑，留空则为匿名访客）"
          maxlength="30"
          autocomplete="nickname"
          data-guestbook-nick
        />
        <textarea
          class="guestbook-textarea"
          placeholder="写点什么……"
          maxlength="300"
          rows="4"
          data-guestbook-text
        ></textarea>
        <div class="guestbook-compose-bar">
          <span class="guestbook-hint"><ThemeCopy minimal="仅文字 · 最多 300 字 · 显示 IP 属地" trace="仅文字 · 不能附加图片 · 发送后标注 IP 属地" /></span>
          <span class="guestbook-count" data-guestbook-count-text>0 / 300</span>
          <button class="guestbook-submit" type="button" data-guestbook-submit>发送</button>
        </div>
      </div>
    </section>

    <section class="guestbook-section" aria-label="留言列表">
      <div class="guestbook-index-bar">
        <span><ThemeCopy minimal="全部留言" trace="COMMENTS IN THE MARGIN" /></span>
        <span data-guestbook-index>— ITEMS</span>
      </div>
      <div class="guestbook-list" data-guestbook-list></div>
    </section>

    <footer class="guestbook-footer">
      <span><ThemeCopy minimal="留言将显示 IP 属地" trace="EPISTULAE / NOTED WITH IP REGION" /></span>
      <span>{new Date().getFullYear()} · ACR—GUESTBOOK</span>
    </footer>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
  const PAGE_PATH = '/guestbook/';
  const MAX_LEN = 300;
  const PAGE_SIZE = 20;
  const STORAGE_SERVER = 'guestbook-server-url';
  const STORAGE_NICK = 'guestbook-nick';
  const DEFAULT_SERVER = 'https://comment-sys-ashen.vercel.app';

  const themeText = (minimal: string, trace: string) =>
    document.documentElement.dataset.visualTheme === 'trace' ? trace : minimal;

  const avatarEl = document.querySelector<HTMLElement>('[data-guestbook-avatar]');
  const nickInput = document.querySelector<HTMLInputElement>('[data-guestbook-nick]');
  const textarea = document.querySelector<HTMLTextAreaElement>('[data-guestbook-text]');
  const countText = document.querySelector<HTMLElement>('[data-guestbook-count-text]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-guestbook-submit]');
  const listEl = document.querySelector<HTMLElement>('[data-guestbook-list]');
  const countEl = document.querySelector<HTMLElement>('[data-guestbook-count]');
  const indexEl = document.querySelector<HTMLElement>('[data-guestbook-index]');

  if (nickInput) nickInput.placeholder = themeText('你的称呼（可选）', '你的称呼（可编辑，留空则为匿名访客）');
  if (textarea) textarea.placeholder = themeText('写下留言…', '在页边写下批注……');
  if (submitBtn) submitBtn.textContent = themeText('发布', '发送');

  let serverURL = localStorage.getItem(STORAGE_SERVER) || DEFAULT_SERVER;
  const urlParam = new URLSearchParams(location.search).get('server');
  if (urlParam && /^https?:\/\//i.test(urlParam)) {
    serverURL = urlParam.replace(/\/+$/, '');
    localStorage.setItem(STORAGE_SERVER, serverURL);
  }

  // ── 头像：按昵称哈希取色，字母头像（B 站式圆形） ──
  const AVATAR_COLORS = ['#8d302b', '#9a7b40', '#5f574a', '#4a6b5a', '#6b5a7a', '#7a5a4a', '#3a6b8a', '#8a6b3a'];
  function nickHash(text: string) {
    let hash = 0;
    for (let i = 0; i < text.length; i += 1) hash = (hash * 31 + text.charCodeAt(i)) >>> 0;
    return hash;
  }
  function updateAvatar(nick: string) {
    const name = nick.trim() || '匿名访客';
    if (!avatarEl) return;
    avatarEl.textContent = name.slice(0, 1).toUpperCase();
    avatarEl.style.background = AVATAR_COLORS[nickHash(name) % AVATAR_COLORS.length];
  }

  // ── 相对时间（B 站风格） ──
  function relativeTime(time: number) {
    const diff = Date.now() - time;
    const minute = 60 * 1000;
    const hour = 60 * minute;
    const day = 24 * hour;
    if (diff < minute) return '刚刚';
    if (diff < hour) return `${Math.floor(diff / minute)} 分钟前`;
    if (diff < day) return `${Math.floor(diff / hour)} 小时前`;
    if (diff < 30 * day) return `${Math.floor(diff / day)} 天前`;
    return new Date(time).toLocaleDateString('zh-CN');
  }
  function fullTime(time: number) {
    return new Date(time).toLocaleString('zh-CN', { hour12: false });
  }

  // ── 评论内容渲染：纯文本化的 HTML，移除一切图片/媒体元素与事件属性 ──
  function sanitizeContent(html: string): string {
    const doc = new DOMParser().parseFromString(html || '', 'text/html');
    doc.querySelectorAll('img, svg, script, iframe, object, embed, video, audio, source, canvas, math, style, link, meta').forEach((el) => el.remove());
    doc.querySelectorAll('*').forEach((el) => {
      [...el.attributes].forEach((attr) => {
        if (/^on/i.test(attr.name) || /^data-/i.test(attr.name)) el.removeAttribute(attr.name);
      });
    });
    doc.querySelectorAll('a').forEach((a) => {
      const href = a.getAttribute('href') || '';
      if (!/^https?:/i.test(href)) {
        a.removeAttribute('href');
      } else {
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
      }
    });
    return doc.body.innerHTML;
  }

  function commentTime(comment: any): number {
    const value = comment.time ?? comment.insertedAt ?? Date.now();
    const ts = typeof value === 'number' ? value : Date.parse(String(value));
    return Number.isFinite(ts) ? ts : Date.now();
  }

  function buildComment(comment: any, floor: number) {
    const article = document.createElement('article');
    article.className = 'guestbook-comment';

    const avatar = document.createElement('div');
    avatar.className = 'guestbook-c-avatar';
    avatar.textContent = (comment.nick || '匿').slice(0, 1).toUpperCase();
    avatar.style.background = AVATAR_COLORS[nickHash(comment.nick || '匿名') % AVATAR_COLORS.length];

    const body = document.createElement('div');
    body.className = 'guestbook-c-body';

    const meta = document.createElement('div');
    meta.className = 'guestbook-c-meta';
    const nick = document.createElement('span');
    nick.className = 'guestbook-c-nick';
    nick.textContent = comment.nick || '匿名访客';
    meta.append(nick);
    if (comment.addr) {
      const region = document.createElement('span');
      region.className = 'guestbook-c-region';
      region.textContent = `IP属地：${comment.addr}`;
      region.title = '发送端 IP 归属地（国内显示省份，国外显示国家）';
      meta.append(region);
    }
    const time = document.createElement('time');
    time.className = 'guestbook-c-time';
    const ts = commentTime(comment);
    time.dateTime = new Date(ts).toISOString();
    time.textContent = relativeTime(ts);
    time.title = fullTime(ts);
    meta.append(time);
    const floorEl = document.createElement('span');
    floorEl.className = 'guestbook-c-floor';
    floorEl.textContent = `#${floor} 楼`;
    meta.append(floorEl);

    const content = document.createElement('div');
    content.className = 'guestbook-c-content';
    content.innerHTML = sanitizeContent(comment.comment || '');

    body.append(meta, content);
    article.append(avatar, body);
    return article;
  }

  // ── 状态视图 ──
  function setStatus(kind: 'loading' | 'unconfigured' | 'error' | 'empty' | 'list', detail = '') {
    if (!listEl) return;
    listEl.innerHTML = '';
    listEl.dataset.status = kind;
    if (kind === 'loading') {
      const p = document.createElement('p');
      p.className = 'guestbook-status';
      p.textContent = themeText('正在加载留言…', '正在翻查留言册……');
      listEl.append(p);
    } else if (kind === 'unconfigured') {
      const div = document.createElement('div');
      div.className = 'guestbook-unconfigured';
      const strong = document.createElement('strong');
      strong.textContent = themeText('留言服务未连接', '留言服务尚未连接');
      const p = document.createElement('p');
      p.textContent = '本地预览：在地址栏加 ?server=http://127.0.0.1:8765 后刷新页面（需先运行 node scripts/mock-waline.mjs）。线上请按 docs/WALINE_DEPLOY.md 部署 Waline 后配置。';
      const code = document.createElement('code');
      code.textContent = detail || '';
      div.append(strong, p, code);
      listEl.append(div);
    } else if (kind === 'error') {
      const p = document.createElement('p');
      p.className = 'guestbook-status';
      p.textContent = themeText(`加载失败：${detail}。`, `留言加载失败：${detail}。可尝试用 ?server= 指定服务地址。`);
      listEl.append(p);
    } else if (kind === 'empty') {
      const div = document.createElement('div');
      div.className = 'guestbook-empty';
      const strong = document.createElement('strong');
      strong.textContent = themeText('还没有留言', '尚无留言');
      const span = document.createElement('span');
      span.textContent = themeText('欢迎留下第一条。', '在编目册的空白处，留下第一笔批注。');
      div.append(strong, span);
      listEl.append(div);
    }
  }

  let page = 1;
  let totalPages = 1;
  let totalCount = 0;
  let loadedComments: any[] = [];

  async function loadComments(reset = false) {
    if (!serverURL) {
      setStatus('unconfigured');
      return;
    }
    if (reset) {
      page = 1;
      loadedComments = [];
      setStatus('loading');
    }
    try {
      const params = new URLSearchParams({
        path: PAGE_PATH,
        page: String(page),
        pageSize: String(PAGE_SIZE),
        sortBy: 'insertedAt_asc',
      });
      const res = await fetch(`${serverURL}/api/comment?${params}`);
      const json = await res.json();
      if (!res.ok || json.errno) throw new Error(json.errmsg || `HTTP ${res.status}`);
      const data = json.data;
      totalPages = Number(data.totalPages) || 1;
      totalCount = Number(data.count) || 0;
      loadedComments = [...loadedComments, ...(data.data || [])];
      renderComments();
    } catch (err) {
      setStatus('error', err instanceof Error ? err.message : String(err));
    }
  }

  function renderComments() {
    if (!listEl || !countEl || !indexEl) return;
    countEl.textContent = String(totalCount);
    indexEl.textContent = themeText(`${totalCount} 条留言`, `${String(totalCount).padStart(2, '0')} ITEMS`);
    if (loadedComments.length === 0) {
      setStatus('empty');
      return;
    }
    listEl.innerHTML = '';
    listEl.dataset.status = 'list';
    const fragment = document.createDocumentFragment();
    loadedComments.forEach((comment, index) => {
      fragment.append(buildComment(comment, index + 1));
    });
    listEl.append(fragment);
    if (page < totalPages) {
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'guestbook-more';
      more.textContent = themeText('加载更多', '继续翻查留言');
      more.addEventListener('click', () => {
        page += 1;
        loadComments(false);
      });
      listEl.append(more);
    }
  }

  // ── 字数统计 ──
  textarea?.addEventListener('input', () => {
    const len = textarea.value.length;
    if (countText) countText.textContent = `${len} / ${MAX_LEN}`;
  });

  // ── 提交 ──
  submitBtn?.addEventListener('click', async () => {
    if (!serverURL) {
      setStatus('unconfigured');
      return;
    }
    const nick = nickInput?.value.trim() || '匿名访客';
    const content = textarea?.value.trim() || '';
    if (!content) {
      if (countText) countText.textContent = themeText('请输入留言', '还没有写下内容');
      textarea?.focus();
      return;
    }
    if (content.length > MAX_LEN) {
      if (countText) countText.textContent = `超出 ${content.length - MAX_LEN} 字`;
      return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = themeText('发布中…', '发送中…');
    try {
      const res = await fetch(`${serverURL}/api/comment`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          url: PAGE_PATH,
          nick,
          comment: content,
          ua: navigator.userAgent,
        }),
      });
      const json = await res.json();
      if (!res.ok || json.errno) throw new Error(json.errmsg || `HTTP ${res.status}`);
      if (textarea) textarea.value = '';
      if (countText) countText.textContent = `0 / ${MAX_LEN}`;
      await loadComments(true);
    } catch (err) {
      if (countText) countText.textContent = err instanceof Error ? `发送失败：${err.message}` : '发送失败';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = themeText('发布', '发送');
    }
  });

  // ── 昵称记忆与头像 ──
  const savedNick = localStorage.getItem(STORAGE_NICK) || '';
  if (nickInput && savedNick) {
    nickInput.value = savedNick;
    updateAvatar(savedNick);
  } else {
    updateAvatar('匿');
  }
  nickInput?.addEventListener('input', () => {
    updateAvatar(nickInput.value);
    localStorage.setItem(STORAGE_NICK, nickInput.value.trim());
  });

  loadComments(true);
  });
</script>
