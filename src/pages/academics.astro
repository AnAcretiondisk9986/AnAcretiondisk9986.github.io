---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicPosts } from '../lib/posts';
import {
  computeAcademicStats,
  computeAcademicTelemetry,
  fmtCredit,
  formatCourseGrade,
  packAcademics,
  packTrackWall,
  resolveCoursePosts,
  type AcademicData,
  type AxisSegment,
  type PackedCourse,
} from '../lib/academics';
import rawData from '../data/academics.json';
import '../styles/hz/log.css';
import '../styles/hz/academics.css';

const data = rawData as AcademicData;
const stats = computeAcademicStats(data);
const telemetry = computeAcademicTelemetry(data);
const publicPosts = (await getPublicPosts()).filter((p) => !p.data.access || p.data.access === 'public');
const postMap = new Map(publicPosts.map((p) => [p.id.toLowerCase(), { id: p.id, title: p.data.title }]));
const transferPosts = resolveCoursePosts(data.transfer?.posts, postMap);
const packedSemesters = packAcademics(data);

const origWall = packTrackWall(packedSemesters.filter((s) => s.track === 'orig'));
const clinWall = packTrackWall(packedSemesters.filter((s) => s.track === 'clin'));

// GPA 折线图 SVG 点位计算
const curvePoints = telemetry.semesterCurve;
const curveCoords = curvePoints.map((s, idx) => {
  const x = curvePoints.length === 1 ? 140 : Math.round(16 + (idx / (curvePoints.length - 1)) * 248);
  const gpa = Math.max(0, Math.min(5, s.avgGpa));
  const y = Math.round(64 - (gpa / 5) * 52);
  return { ...s, x, y };
});
const curvePolyline = curveCoords.map((p) => `${p.x},${p.y}`).join(' ');

const litTotal = stats.completedCount + stats.activeCount;

const walls: { id: 'orig' | 'clin'; label: string; courses: PackedCourse[]; axis: AxisSegment[] }[] = [
  { id: 'orig', label: data.tracks.orig.name, courses: origWall.courses, axis: origWall.axis },
  { id: 'clin', label: data.tracks.clin.name, courses: clinWall.courses, axis: clinWall.axis },
];

const tileStyle = (c: PackedCourse) =>
  `--sem-hue:${c.hue};--fs-d:${c.titleRemD}rem;--fs-m:${c.titleRemM}rem;--dc:${c.desktop.x};--dr:${c.desktop.y};--dw:${c.desktop.w};--dh:${c.desktop.h};--tc:${c.tablet.x};--tr:${c.tablet.y};--tw:${c.tablet.w};--th:${c.tablet.h};--mc:${c.mobile.x};--mr:${c.mobile.y};--mw:${c.mobile.w};--mh:${c.mobile.h}`;

const axisStyle = (a: AxisSegment) =>
  `--sem-hue:${a.hue};--dr:${a.desktopRow};--dh:${a.desktopSpan};--tr:${a.tabletRow};--th:${a.tabletSpan};--mr:${a.mobileRow};--mh:${a.mobileSpan}`;

const badgeText = (c: PackedCourse) => {
  if (c.kind === 'milestone') {
    return c.milestoneSpan && c.milestoneSpan >= 4 ? '大五学年' : '大四学年';
  }
  return `${fmtCredit(c.credits)} CR`;
};
---

<BaseLayout title="学业" description="本科课程拼贴墙。" page="trajectory">
  <div class="hz-wrap hz-acad" data-acad-root>
    <header class="hz-acad-head">
      <div class="hz-acad-head__title-row">
        <div>
          <p class="hz-mono hz-acad-head__kicker">
            TRAJECTORY // 06 · <span lang="ja">履修軌道</span>
          </p>
          <h1 class="hz-acad-head__title">学业</h1>
        </div>
        <p class="hz-mono hz-acad-readout" data-acad-readout>
          {stats.totalTiles} / {stats.totalTiles}
        </p>
      </div>

      <div class="hz-acad-controls">
        <label class="hz-search">
          <span class="hz-mono" aria-hidden="true">SEARCH</span>
          <input
            type="search"
            data-acad-search
            aria-label="搜索课程名或开课部门"
            placeholder="搜索课程名或开课部门…"
            autocomplete="off"
          />
          <kbd aria-hidden="true">/</kbd>
        </label>

        <div class="hz-tags-rail" role="group" aria-label="状态筛选">
          <button type="button" data-acad-filter="all" aria-pressed="true">全部 ({stats.totalTiles})</button>
          <button type="button" data-acad-filter="lit" aria-pressed="false">已点亮 ({litTotal})</button>
          <button type="button" data-acad-filter="completed" aria-pressed="false">
            <i class="hz-swatch hz-swatch--done" aria-hidden="true"></i>已修 ({stats.completedCount})
          </button>
          <button type="button" data-acad-filter="active" aria-pressed="false">
            <i class="hz-swatch hz-swatch--active" aria-hidden="true"></i>在修 ({stats.activeCount})
          </button>
          <button type="button" data-acad-filter="early" aria-pressed="false">提前 ({stats.earlyCount})</button>
          <button type="button" data-acad-filter="planned" aria-pressed="false">
            <i class="hz-swatch hz-swatch--plan" aria-hidden="true"></i>待修 ({stats.plannedCount})
          </button>
        </div>
      </div>
    </header>

    <details class="hz-acad-tele" open>
      <summary class="hz-acad-tele__sum hz-mono">
        <span>ORBITAL TELEMETRY // 轨线遥测</span>
        <span>
          已修 {fmtCredit(telemetry.origCompletedCredits + telemetry.clinCompletedCredits)} CR
          {telemetry.overallWeightedGpa !== null ? ` · 综合加权绩点 ${telemetry.overallWeightedGpa.toFixed(2)} / 5.0` : ''}
          · 在修 {fmtCredit(telemetry.clinActiveCredits)} CR
        </span>
      </summary>
      <div class="hz-acad-tele__body">
        <div class="hz-acad-tele__cards">
          <div class="hz-acad-tcard">
            <span class="hz-mono">TRACK 01 · {data.tracks.orig.name}</span>
            <b>{fmtCredit(telemetry.origCompletedCredits)} <small>/ {fmtCredit(telemetry.origTotalCredits)} CR</small></b>
            <small class="hz-mono">
              已记绩 {telemetry.origCompletedCredits > 0 ? '完成转轨学分互认' : '准备中'}
            </small>
          </div>
          <div class="hz-acad-tcard">
            <span class="hz-mono">TRACK 02 · {data.tracks.clin.name}</span>
            <b>{fmtCredit(telemetry.clinLitCredits)} <small>/ {fmtCredit(telemetry.clinTotalCredits)} CR</small></b>
            <small class="hz-mono">
              已修 {fmtCredit(telemetry.clinCompletedCredits)} CR · 在修 {fmtCredit(telemetry.clinActiveCredits)} CR
              {telemetry.overallWeightedGpa !== null ? ` · 加权绩点 ${telemetry.overallWeightedGpa.toFixed(2)} (${telemetry.scoredCourseCount} 门)` : ''}
            </small>
          </div>
        </div>
        {curveCoords.length > 0 && (
          <div class="hz-acad-curve">
            <span class="hz-mono hz-acad-curve__k">SEMESTER GPA TRAJECTORY</span>
            <svg viewBox="0 0 280 76" role="img" aria-label="各学期加权绩点趋势图">
              <line x1="12" y1="64" x2="268" y2="64" stroke="currentColor" stroke-opacity="0.2" />
              {curveCoords.length > 1 && (
                <polyline fill="none" stroke="var(--hz-hot)" stroke-width="2" points={curvePolyline} />
              )}
              {curveCoords.map((pt) => (
                <g>
                  <circle cx={pt.x} cy={pt.y} r="3.8" fill="var(--hz-hot)" />
                  <text x={pt.x} y={pt.y - 7} text-anchor="middle" font-size="8" fill="currentColor">{pt.avgGpa.toFixed(2)}</text>
                  <text x={pt.x} y="74" text-anchor="middle" font-size="7" fill="currentColor" opacity="0.65">{pt.shortLabel}</text>
                </g>
              ))}
            </svg>
          </div>
        )}
      </div>
    </details>

    <div class="hz-empty" data-acad-empty hidden>
      <p class="hz-mono">NO COURSES MATCH CURRENT FILTER</p>
      <p>当前筛选条件下没有匹配的课程，试试清空搜索词或切换状态。</p>
      <button type="button" class="hz-btn" data-acad-reset>重置全部筛选</button>
    </div>

    <div class="hz-acad-wall">
      {walls.map((wall, idx) => (
        <>
          <section class:list={['hz-mosaic', { 'hz-mosaic--clin': wall.id === 'clin' }]} aria-label={wall.label}>
            {wall.axis.map((seg) => (
              <div
                class:list={['hz-axis-seg', { 'is-year-start': seg.showYear }]}
                style={axisStyle(seg)}
                aria-hidden="true"
              >
                <i class="hz-axis-seg__tick"></i>
                <div class="hz-axis-seg__meta">
                  {seg.showYear && (
                    <span class="hz-axis-seg__year">
                      <b class="hz-axis-full">{seg.year}</b>
                      <b class="hz-axis-short">{seg.shortYear}</b>
                    </span>
                  )}
                  <span class="hz-axis-seg__label">
                    <b class="hz-axis-full">{seg.label}</b>
                    <b class="hz-axis-short">{seg.shortLabel}</b>
                  </span>
                </div>
              </div>
            ))}

            {wall.courses.map((c) => {
              const isMilestone = c.kind === 'milestone';
              const milestoneTier = isMilestone ? (c.milestoneSpan && c.milestoneSpan >= 4 ? 'internship' : 'clerkship') : undefined;
              const gradeInfo = formatCourseGrade(c);
              const linkedPosts = resolveCoursePosts(c.posts, postMap);
              const fullTitle = c.subTags.length > 0 ? `${c.mainTitle}（${c.subTags.join('·')}）` : c.mainTitle;
              return (
                <button
                  type="button"
                  class="hz-tile"
                  data-acad-tile
                  data-id={c.id}
                  data-track={c.track}
                  data-status={c.status}
                  data-early={c.early ? 'true' : undefined}
                  data-hero={c.desktop.h > 1 ? 'true' : undefined}
                  data-milestone={isMilestone ? 'true' : undefined}
                  data-milestone-tier={milestoneTier}
                  data-search={`${c.name} ${c.mainTitle} ${c.subTags.join(' ')} ${c.en || ''} ${c.dept} ${c.note || ''}`.toLowerCase()}
                  style={tileStyle(c)}
                  aria-pressed="false"
                  aria-label={`${fullTitle}${c.en ? ` (${c.en})` : ''}，${badgeText(c)}，开课部门：${c.dept}，${gradeInfo.label}：${gradeInfo.ariaText}`}
                >
                  <span class="hz-tile__inner">
                    <span class="hz-tile__face hz-tile__face--front">
                      <span class:list={['hz-tile__body', { 'hz-tile__body--with-logo': Boolean(c.logo) }]}>
                        {c.logo && (
                          <img
                            class="hz-tile__logo"
                            src={c.logo}
                            alt={c.logoAlt || ''}
                            width={1001}
                            height={235}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        <span class="hz-tile__heading">
                          <span class="hz-tile__title-line">
                            <span class="hz-tile__name">{c.mainTitle}</span>
                            {c.subTags.map((st) => (
                              <span class="hz-tile__sub">{st}</span>
                            ))}
                          </span>
                          {c.en && (
                            <span class="hz-tile__en" lang="en">{c.en}</span>
                          )}
                        </span>
                      </span>
                      <span class="hz-tile__cr">
                        {c.early && <span class="hz-tile__early" aria-hidden="true">⚡</span>}
                        {linkedPosts.length > 0 && <span class="hz-tile__note-ind" title={`关联 ${linkedPosts.length} 篇博文`} aria-hidden="true">📝</span>}
                        <span>{badgeText(c)}</span>
                      </span>
                    </span>

                    <span class="hz-tile__face hz-tile__face--back" aria-hidden="true">
                      <span class="hz-tile__meta-row">
                        <span class="hz-tile__k">开课部门</span>
                        <span class="hz-tile__v">{c.dept}</span>
                      </span>
                      <span class="hz-tile__meta-row">
                        <span class="hz-tile__k">{gradeInfo.label}</span>
                        <span
                          class="hz-tile__v hz-tile__v--grade"
                          data-empty={gradeInfo.hasScore ? undefined : 'true'}
                        >
                          {gradeInfo.value}
                          {gradeInfo.scale && <span class="hz-tile__scale"> {gradeInfo.scale}</span>}
                        </span>
                      </span>
                      {c.note && (
                        <span class="hz-tile__note-txt">{c.note}</span>
                      )}
                      {linkedPosts.length > 0 && (
                        <span class="hz-tile__posts">
                          {linkedPosts.slice(0, 2).map((p) => (
                            <a href={`/blog/${encodeURI(p.id)}/`}>{p.title} ↗</a>
                          ))}
                        </span>
                      )}
                    </span>
                  </span>
                </button>
              );
            })}
          </section>

          {idx === 0 && (
            <div class="hz-transfer-line" role="separator" aria-label="转专业">
              <span>转专业 · <span lang="ja">転科軌道修正</span></span>
              {transferPosts.length > 0 && (
                <span class="hz-transfer-posts">
                  {transferPosts.map((p) => (
                    <a href={`/blog/${encodeURI(p.id)}/`}>{p.title} ↗</a>
                  ))}
                </span>
              )}
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/hz/academics';
</script>
