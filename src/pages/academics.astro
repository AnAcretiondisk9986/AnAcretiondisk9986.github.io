---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  computeAcademicStats,
  fmtCredit,
  packAcademics,
  packTrackWall,
  type AcademicData,
  type AxisSegment,
  type PackedCourse,
} from '../lib/academics';
import rawData from '../data/academics.json';
import '../styles/hz/log.css';
import '../styles/hz/academics.css';

const data = rawData as AcademicData;
const stats = computeAcademicStats(data);
const packedSemesters = packAcademics(data);

const origWall = packTrackWall(packedSemesters.filter((s) => s.track === 'orig'));
const clinWall = packTrackWall(packedSemesters.filter((s) => s.track === 'clin'));

const litTotal = stats.completedCount + stats.activeCount;

const walls: { id: 'orig' | 'clin'; label: string; courses: PackedCourse[]; axis: AxisSegment[] }[] = [
  { id: 'orig', label: data.tracks.orig.name, courses: origWall.courses, axis: origWall.axis },
  { id: 'clin', label: data.tracks.clin.name, courses: clinWall.courses, axis: clinWall.axis },
];

const tileStyle = (c: PackedCourse) =>
  `--sem-hue:${c.hue};--fs-d:${c.titleRemD}rem;--fs-m:${c.titleRemM}rem;--dc:${c.desktop.x};--dr:${c.desktop.y};--dw:${c.desktop.w};--dh:${c.desktop.h};--tc:${c.tablet.x};--tr:${c.tablet.y};--tw:${c.tablet.w};--th:${c.tablet.h};--mc:${c.mobile.x};--mr:${c.mobile.y};--mw:${c.mobile.w};--mh:${c.mobile.h}`;

const axisStyle = (a: AxisSegment) =>
  `--sem-hue:${a.hue};--dr:${a.desktopRow};--dh:${a.desktopSpan};--tr:${a.tabletRow};--th:${a.tabletSpan};--mr:${a.mobileRow};--mh:${a.mobileSpan}`;

const badgeText = (c: PackedCourse) => {
  if (c.kind === 'milestone') {
    return c.milestoneSpan && c.milestoneSpan >= 4 ? '大五学年' : '大四学年';
  }
  return `${fmtCredit(c.credits)} CR`;
};
---

<BaseLayout title="学业" description="本科课程拼贴墙。" page="trajectory">
  <div class="hz-wrap hz-acad" data-acad-root>
    <header class="hz-acad-head">
      <div class="hz-acad-head__title-row">
        <div>
          <p class="hz-mono hz-acad-head__kicker">
            TRAJECTORY // 05 · <span lang="ja">履修軌道</span>
          </p>
          <h1 class="hz-acad-head__title">学业</h1>
        </div>
        <p class="hz-mono hz-acad-readout" data-acad-readout>
          {stats.totalTiles} / {stats.totalTiles}
        </p>
      </div>

      <div class="hz-acad-controls">
        <label class="hz-search">
          <span class="hz-mono" aria-hidden="true">SEARCH</span>
          <input
            type="search"
            data-acad-search
            aria-label="搜索课程名或开课部门"
            placeholder="搜索课程名或开课部门…"
            autocomplete="off"
          />
          <kbd aria-hidden="true">/</kbd>
        </label>

        <div class="hz-tags-rail" role="group" aria-label="状态筛选">
          <button type="button" data-acad-filter="all" aria-pressed="true">全部 ({stats.totalTiles})</button>
          <button type="button" data-acad-filter="lit" aria-pressed="false">已点亮 ({litTotal})</button>
          <button type="button" data-acad-filter="completed" aria-pressed="false">
            <i class="hz-swatch hz-swatch--done" aria-hidden="true"></i>已修 ({stats.completedCount})
          </button>
          <button type="button" data-acad-filter="active" aria-pressed="false">
            <i class="hz-swatch hz-swatch--active" aria-hidden="true"></i>在修 ({stats.activeCount})
          </button>
          <button type="button" data-acad-filter="early" aria-pressed="false">提前 ({stats.earlyCount})</button>
          <button type="button" data-acad-filter="planned" aria-pressed="false">
            <i class="hz-swatch hz-swatch--plan" aria-hidden="true"></i>待修 ({stats.plannedCount})
          </button>
        </div>
      </div>
    </header>

    <div class="hz-acad-wall">
      {walls.map((wall, idx) => (
        <>
          <section class="hz-mosaic" aria-label={wall.label}>
            {wall.axis.map((seg) => (
              <div
                class:list={['hz-axis-seg', { 'is-year-start': seg.showYear }]}
                style={axisStyle(seg)}
                aria-hidden="true"
              >
                <i class="hz-axis-seg__tick"></i>
                <div class="hz-axis-seg__meta">
                  {seg.showYear && (
                    <span class="hz-axis-seg__year">
                      <b class="hz-axis-full">{seg.year}</b>
                      <b class="hz-axis-short">{seg.shortYear}</b>
                    </span>
                  )}
                  <span class="hz-axis-seg__label">
                    <b class="hz-axis-full">{seg.label}</b>
                    <b class="hz-axis-short">{seg.shortLabel}</b>
                  </span>
                </div>
              </div>
            ))}

            {wall.courses.map((c) => {
              const isMilestone = c.kind === 'milestone';
              const milestoneTier = isMilestone ? (c.milestoneSpan && c.milestoneSpan >= 4 ? 'internship' : 'clerkship') : undefined;
              const gradeText = c.grade?.trim() || 'NULL';
              return (
                <button
                  type="button"
                  class="hz-tile"
                  data-acad-tile
                  data-id={c.id}
                  data-track={c.track}
                  data-status={c.status}
                  data-early={c.early ? 'true' : undefined}
                  data-hero={c.desktop.h > 1 ? 'true' : undefined}
                  data-milestone={isMilestone ? 'true' : undefined}
                  data-milestone-tier={milestoneTier}
                  data-search={`${c.name} ${c.dept}`.toLowerCase()}
                  style={tileStyle(c)}
                  aria-pressed="false"
                  aria-label={`${c.name}，${badgeText(c)}，开课部门：${c.dept}，成绩：${gradeText}`}
                >
                  <span class="hz-tile__inner">
                    <span class="hz-tile__face hz-tile__face--front">
                      <span class="hz-tile__name">{c.name}</span>
                      <span class="hz-tile__cr">
                        {c.early && <span class="hz-tile__early" aria-hidden="true">⚡</span>}
                        <span>{badgeText(c)}</span>
                      </span>
                    </span>

                    <span class="hz-tile__face hz-tile__face--back" aria-hidden="true">
                      <span class="hz-tile__meta-row">
                        <span class="hz-tile__k">开课部门</span>
                        <span class="hz-tile__v">{c.dept}</span>
                      </span>
                      <span class="hz-tile__meta-row">
                        <span class="hz-tile__k">成绩</span>
                        <span class="hz-tile__v hz-tile__v--grade">{gradeText}</span>
                      </span>
                    </span>
                  </span>
                </button>
              );
            })}
          </section>

          {idx === 0 && (
            <div class="hz-transfer-line" role="separator" aria-label="转专业">
              <span>转专业</span>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/hz/academics';
</script>
