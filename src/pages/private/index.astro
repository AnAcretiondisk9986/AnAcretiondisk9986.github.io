---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gate from '../../components/hz/Gate.astro';
import PostRow from '../../components/hz/PostRow.astro';
import { folioCodes } from '../../lib/horizon';
import privateAccess from '../../data/private-access.json';
import '../../styles/hz/log.css';
import '../../styles/hz/entry.css';
import '../../styles/hz/misc.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.access === 'admin'))
  .sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    || (b.data.dayIndex ?? 0) - (a.data.dayIndex ?? 0)
    || b.id.localeCompare(a.id));

const folioFor = folioCodes(posts);
const passwordHash = privateAccess.passwordHash;
---

<BaseLayout title="暗房私密" description="管理员级私密文章入口。" page="darkroom">
  <div class="hz-wrap hz-darkroom">
    <header class="hz-darkroom__head">
      <p class="hz-mono hz-darkroom__kicker">DARKROOM ARCHIVE // CLEARANCE: ADMIN</p>
      <h1 class="hz-darkroom__title">私密文章</h1>
      <p class="hz-darkroom__deck">这里收录未进入公开光谱的个人记录，需验证口令后展开。</p>
      <div class="hz-darkroom__tele hz-mono">
        <span>ENTRIES: {String(posts.length).padStart(3, '0')}</span>
        <span>SORT: NEWEST → OLDEST</span>
        <span>STATUS: ENCRYPTED HASH GATE</span>
      </div>
    </header>

    <Gate
      mode="admin"
      articleId="private-index"
      hash={passwordHash}
      kicker="DARKROOM // CLEARANCE REQUIRED"
      title="输入暗房口令以开启私密卷册"
      hint="密码由站长在后台设置；验证通过后将记住本设备状态。"
      placeholder="私密文章密码"
    >
      {posts.length > 0 ? (
        <div class="hz-ledger">
          {posts.map((post, idx) => (
            <PostRow
              post={post}
              folioCode={folioFor(post)}
              index={idx}
              basePath="/private/"
              isPrivate
              headingLevel={2}
            />
          ))}
        </div>
      ) : (
        <div class="hz-empty">
          <p class="hz-mono">DARKROOM EMPTY // NO PRIVATE ENTRIES</p>
        </div>
      )}

      <footer class="hz-darkroom__foot hz-mono">
        <span>PRIVATE ARCHIVE · UNLISTED</span>
        <span>ACR / DARKROOM / {new Date().getFullYear()}</span>
      </footer>
    </Gate>
  </div>

  <div class="hz-lens" data-lens aria-hidden="true">
    <img data-lens-img alt="" />
    <span class="hz-lens__ring"></span>
    <span class="hz-lens__cap hz-mono" data-lens-cap></span>
  </div>
</BaseLayout>

<script>
  import '../../scripts/hz/lens';
</script>
