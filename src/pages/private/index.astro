---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeCopy from '../../components/ThemeCopy.astro';
import privateAccess from '../../data/private-access.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.access === 'admin'))
  .sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    || (b.data.dayIndex ?? 0) - (a.data.dayIndex ?? 0)
    || b.id.localeCompare(a.id));
const passwordHash = privateAccess.passwordHash;
const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="私密文章" description="管理员级文章入口。">
  <main class="private-index">
    <section class="f-section private-head">
      <div class="f-fleuron" aria-hidden="true"><i></i></div>
      <div class="f-cover__folio"><span>PRIVATE ARCHIVE</span><span>·</span><span>MMXXVI</span></div>
      <h1 class="private-head__title"><ThemeCopy minimal="私密文章" trace="私密卷册" /></h1>
      <p class="private-head__deck"><ThemeCopy minimal="此处文章不会出现在公开文章目录中。" trace="此处文章不会出现在公开文章目录中。" cyanotype="一些观察暂时收在暗房里，不列入公开手记。" /></p>
      <dl class="private-head__register">
        <div><dt><ThemeCopy minimal="文章总数" trace="私密馆藏总数" /></dt><dd class="f-num">{String(posts.length).padStart(3, '0')}</dd></div>
        <div><dt><ThemeCopy minimal="访问状态" trace="权限状态" /></dt><dd>需验证</dd></div>
        <div><dt>排序规则</dt><dd data-order-text>由新至旧</dd></div>
      </dl>
    </section>

    <div class="access-gate private-gate" data-private-index-gate>
      <p class="access-gate__eyebrow"><ThemeCopy minimal="管理员级文章" trace="管理员级文章" cyanotype="THE DARKROOM / 非公开区域" /></p>
      <h2><ThemeCopy minimal="输入密码后查看私密目录" trace="输入密码后查看私密目录" cyanotype="持有口令，才能展开这些底片。" /></h2>
      <form data-private-index-form><input name="password" type="password" autocomplete="current-password" required placeholder="私密文章密码" aria-label="私密文章密码" /><button class="f-btn" type="submit">验证并打开</button></form>
      <p class="access-gate__error" data-private-index-error role="alert"></p>
    </div>

    <div class="private-body" data-private-index-body hidden>
      {posts.length ? (
        <div class="f-catalog">
          {posts.map((post, i) => (
            <a class="f-entry" href={`/private/${post.id}/`}>
              <span class="f-entry__no">{String(posts.length - i).padStart(3, '0')}</span>
              <span class="f-entry__title"><span>{post.data.title}</span></span>
              <span class="f-entry__tag">{post.data.tags?.[0] ?? 'PRIVATE'}</span>
              <span class="f-entry__date">{fmtDate(post.data.pubDate)}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="private-empty">暂无私密文章。</p>
      )}
      <footer class="private-footer">
        <span><ThemeCopy minimal="私密文章仅在验证后展示" trace="受权限控制的私密卷册" /></span>
        <span class="f-num">ACR / PRIVATE / {new Date().getFullYear()}</span>
      </footer>
    </div>
  </main>
</BaseLayout>

<!-- 私密页版式（页头 + 登记条 + 细线门禁 + f-entry 编目）统一定义在
     src/styles/pages-next.css 的 components 层；锁定态由下方内联脚本切换。 -->

<script is:inline data-astro-rerun define:vars={{ passwordHash }}>
  (() => {
    const unlockKey = 'acr-private-admin-unlocked';
    const gate = document.querySelector('[data-private-index-gate]');
    const form = document.querySelector('[data-private-index-form]');
    const error = document.querySelector('[data-private-index-error]');
    const body = document.querySelector('[data-private-index-body]');
    if (!gate || !form || !error || !body) return;
    const isUnlocked = () => {
      try { return localStorage.getItem(unlockKey) === passwordHash; } catch { return false; }
    };
    const rememberUnlock = () => {
      try { localStorage.setItem(unlockKey, passwordHash); } catch {}
    };
    const reveal = () => {
      body.hidden = false;
      gate.replaceWith(body);
      document.dispatchEvent(new CustomEvent('astro:page-load'));
    };
    if (isUnlocked()) reveal();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = String(new FormData(form).get('password') || '');
      const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(password));
      const hash = [...new Uint8Array(digest)].map((v) => v.toString(16).padStart(2, '0')).join('');
      if (hash === passwordHash) { rememberUnlock(); reveal(); }
      else error.textContent = '密码不正确。';
    });
  })();
</script>
