---
import Icon from '../../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeCopy from '../../components/ThemeCopy.astro';
import privateAccess from '../../data/private-access.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.access === 'admin');
  const dayCounts = new Map<string, number>();
  for (const post of posts) {
    const key = post.data.pubDate.toISOString().slice(0, 10);
    dayCounts.set(key, (dayCounts.get(key) ?? 0) + 1);
  }
  return posts.map((post) => {
    const key = post.data.pubDate.toISOString().slice(0, 10);
    const folioBase = `${post.data.pubDate.getFullYear()}—${String(post.data.pubDate.getMonth() + 1).padStart(2, '0')}${String(post.data.pubDate.getDate()).padStart(2, '0')}`;
    const folioCode = dayCounts.get(key)! > 1
      ? `${folioBase}—${String(post.data.dayIndex ?? 1).padStart(2, '0')}`
      : folioBase;
    return { params: { id: post.id }, props: { post, folioCode } };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  folioCode: string;
}

const { post, folioCode } = Astro.props;
const { Content } = await render(post);
const passwordHash = privateAccess.passwordHash;
// 阅读时长：按正文有效字数估算（中文约 400 字/分钟），只用于页头元信息行
const readingMinutes = Math.max(
  1,
  Math.round(
    (post.body ?? '')
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
      .replace(/\[[^\]]*\]\([^)]*\)/g, ' ')
      .replace(/<[^>]*>/g, ' ')
      .replace(/[#>*_`|~\-\s]/g, '').length / 400,
  ),
);
const pad2 = (n: number) => String(n).padStart(2, '0');
const fmtMinute = (d: Date) => {
  const date = `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  const isDateOnly = d.getUTCHours() === 0 && d.getUTCMinutes() === 0;
  return isDateOnly ? date : `${date} ${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
};
---

<BaseLayout title={`私密文章｜${post.data.title}`} description="管理员级文章。">
  <div class="article-shell private-article-shell" data-private-article={post.id}>
    <aside class="article-margin f-article__aside">
      <a class="back-link" href="/private/"><Icon name="arrow-left" /> <ThemeCopy minimal="返回私密文章" trace="返回私密卷册" /></a>
      <div class="private-lock-note">
        <span>PRIVATE ARCHIVE</span>
        <small>管理员级文章 · 验证后阅览</small>
      </div>
      <button class="print-action" type="button" onclick="window.print()">
        <Icon name="download" /> 导出 PDF
      </button>
      <dl>
        <div><dt><ThemeCopy minimal="文章编号" trace="条目编号" /></dt><dd>{folioCode}</dd></div>
        <div><dt><ThemeCopy minimal="标签" trace="分类标签" /></dt><dd>{post.data.tags.join(' / ') || '未分类'}</dd></div>
        <div><dt><ThemeCopy minimal="作者" trace="记录者" /></dt><dd>Acretiondisk</dd></div>
        <div><dt>状态</dt><dd><ThemeCopy minimal="管理员级" trace="PRIVATE ACCESS" /></dd></div>
      </dl>
      <p class="margin-note"><ThemeCopy minimal="私密内容仅在验证后展开。" trace="本条目受访问控制保护，验证后展开全文。" /></p>
    </aside>

    <article class="article">
      <header class="article-header">
        <div class="article-register">
          <span class="f-article__eyebrow">PRIVATE {folioCode}</span>
          <span class="article-register__brand"><ThemeCopy minimal="ACRETIONDISK" trace="ARCHIVUM PERSONAE" /></span>
        </div>
        <h1 class="f-article__title">{post.data.title}</h1>
        {post.data.description && <p class="article-deck">{post.data.description}</p>}
        <div class="article-meta f-article__meta">
          <time datetime={post.data.pubDate.toISOString()}>发布 · {fmtMinute(post.data.pubDate)}</time>
          <span class="article-meta__read">约 {readingMinutes} 分钟</span>
          {post.data.updatedDate && <time datetime={post.data.updatedDate.toISOString()}>修订 · {fmtMinute(post.data.updatedDate)}</time>}
        </div>
      </header>

      <div class="article-ornament" aria-hidden="true"><Icon name="aperture" /></div>

      <div class="access-gate" data-private-gate>
        <p class="access-gate__eyebrow"><ThemeCopy minimal="管理员级文章" trace="管理员级文章" cyanotype="THE DARKROOM / 非公开区域" /></p>
        <h2><ThemeCopy minimal="输入密码后查看" trace="输入密码后查看" cyanotype="这一页，留给持有口令的人。" /></h2>
        <p>密码由站长在管理系统中设置。</p>
        <form data-private-form>
          <input name="password" type="password" autocomplete="current-password" required placeholder="私密文章密码" aria-label="私密文章密码" />
          <button class="f-btn" type="submit">验证并打开</button>
        </form>
        <p class="access-gate__error" data-private-error role="alert"></p>
      </div>

      <template data-private-body>
        <div class="prose"><Content /></div>
        <footer class="article-endmark">
          <span><ThemeCopy minimal="读完了" trace="FINIS" /></span>
          <p><ThemeCopy minimal="文章到这里结束" trace="本条目至此结束" /></p>
        </footer>
      </template>

      
    </article>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun define:vars={{ passwordHash }}>
  (() => {
    const unlockKey = 'acr-private-admin-unlocked';
    const root = document.querySelector('[data-private-article]');
    const gate = root?.querySelector('[data-private-gate]');
    const form = root?.querySelector('[data-private-form]');
    const error = root?.querySelector('[data-private-error]');
    const body = root?.querySelector('template[data-private-body]');
    if (!root || !gate || !form || !error || !body) return;
    const isUnlocked = () => {
      try { return localStorage.getItem(unlockKey) === passwordHash; } catch { return false; }
    };
    const rememberUnlock = () => {
      try { localStorage.setItem(unlockKey, passwordHash); } catch {}
    };
    const reveal = () => {
      gate.replaceWith(body.content.cloneNode(true));
      document.dispatchEvent(new CustomEvent('acr:private-revealed'));
    };
    if (isUnlocked()) reveal();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = String(new FormData(form).get('password') || '');
      const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(password));
      const hash = [...new Uint8Array(digest)].map((v) => v.toString(16).padStart(2, '0')).join('');
      if (hash === passwordHash) { rememberUnlock(); reveal(); }
      else error.textContent = '密码不正确。';
    });
  })();
</script>

<script>
  import { initSongPlayers } from '../../scripts/song-player';
  initSongPlayers();
  document.addEventListener('acr:private-revealed', () => initSongPlayers());
</script>

<style is:global>
  /* ── 私密文章页：Folio 版式（与公开文章页同构：180px 边注 · 34em 正文 · 细线） ── */
  @layer components {
    .article-shell {
      display: grid;
      grid-template-columns: 180px minmax(0, var(--measure));
      gap: clamp(24px, 4vw, 64px);
      justify-content: center;
      align-items: start;
      padding-block: var(--p-sp-8) var(--p-sp-9);
    }

    /* 边注：只做定位与滚动；字号/墨色/顶部铜线来自 .f-article__aside */
    .article-margin {
      position: sticky;
      top: 92px;
      align-self: start;
      max-height: calc(100vh - 116px);
      overflow-y: auto;
      scrollbar-width: none;
      padding-top: 0;
    }
    .article-margin::-webkit-scrollbar { display: none; }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: var(--p-sp-5);
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .back-link:hover { color: var(--c-ink); }
    .back-link svg,
    .print-action svg { width: 12px; height: 12px; }

    .private-lock-note {
      display: grid;
      gap: 3px;
      margin: var(--p-sp-4) 0 var(--p-sp-5);
      padding: var(--p-sp-3) 0 0;
      border: 0;
      border-top: 1px solid var(--c-rule);
    }
    .private-lock-note span {
      color: var(--c-metal);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .private-lock-note small {
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.04em;
      line-height: 1.7;
    }

    .print-action {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 var(--p-sp-3);
      padding: 8px 12px;
      border: 1px solid var(--c-rule);
      border-radius: var(--r-frame);
      background: transparent;
      color: var(--c-ink-2);
      box-shadow: none;
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1;
    }
    .print-action:hover {
      border-color: var(--c-metal);
      background: transparent;
      color: var(--c-ink);
      box-shadow: none;
    }
    .print-action:focus-visible { outline: 1px solid var(--c-accent); outline-offset: 3px; }

    .article-margin dl {
      margin: var(--p-sp-4) 0 0;
      border-top: 1px solid var(--c-rule);
    }
    .article-margin dl div {
      padding-block: 9px;
      border-bottom: 1px solid var(--c-rule);
    }
    .article-margin dt {
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .article-margin dd {
      margin: 3px 0 0;
      color: var(--c-ink-2);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.04em;
      overflow-wrap: anywhere;
    }
    .margin-note {
      margin-top: var(--p-sp-4);
      padding-left: var(--p-sp-3);
      border-left: 1px solid var(--c-metal);
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      line-height: 1.8;
    }

    /* —— 页头：编号 → 标题 → 元信息 → 1px 细线 —— */
    .article { min-width: 0; }
    .article-header {
      padding-bottom: var(--p-sp-5);
      border-bottom: 1px solid var(--c-rule);
    }
    .article-register {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--p-sp-4);
      margin-bottom: var(--p-sp-3);
    }
    .article-register__brand {
      color: var(--c-ink-3);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .article-header h1 { letter-spacing: -0.01em; }
    .article-deck {
      max-width: none;
      margin-bottom: var(--p-sp-4);
      color: var(--c-ink-2);
      font-family: var(--font-display);
      font-size: var(--type-lead);
      font-style: italic;
      letter-spacing: 0;
      line-height: 1.7;
    }
    .article-meta > * + * {
      padding-left: var(--p-sp-3);
      border-left: 1px solid var(--c-rule);
    }

    /* 饰花：细线 + 小徽记，随主题 --deco-fleuron 显隐 */
    .article-ornament {
      display: flex;
      align-items: center;
      gap: var(--p-sp-3);
      margin-block: var(--p-sp-6);
      color: var(--c-metal);
      opacity: var(--deco-fleuron);
    }
    .article-ornament::before,
    .article-ornament::after {
      flex: 1;
      height: 1px;
      content: "";
      background: var(--c-rule);
    }
    .article-ornament svg { width: 15px; height: 15px; }

    /* legacy 的首字下沉 / 节号仍是朱红：接回 tokens */
    .prose > p:first-of-type::first-letter {
      float: left;
      margin: 0;
      padding: 0.04em 0.08em 0 0;
      color: var(--c-accent);
      font-family: var(--font-display);
      font-size: 3.6em;
      font-weight: 500;
      line-height: 0.92;
    }
    .prose h2::before { color: var(--c-metal); }

    .article-endmark {
      display: grid;
      justify-items: center;
      margin-top: var(--p-sp-8);
      padding-top: var(--p-sp-5);
      border-top: 1px solid var(--c-rule);
      color: var(--c-ink-3);
    }
    .article-endmark span {
      color: var(--c-metal);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .article-endmark p {
      margin: 8px 0 0;
      font-family: var(--font-display);
      font-size: var(--type-meta);
      font-style: italic;
      letter-spacing: 0.04em;
    }

    /* —— 口令门禁：细线输入框 + .f-btn —— */
    .access-gate {
      max-width: none;
      margin: var(--p-sp-6) 0 0;
      padding: var(--p-sp-5) 0 0;
      border: 0;
      border-top: 1px solid var(--c-rule-strong);
      background: transparent;
    }
    .access-gate__eyebrow {
      margin: 0 0 var(--p-sp-2);
      color: var(--c-metal);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    .access-gate h2 {
      margin: 0 0 var(--p-sp-2);
      font-family: var(--font-display);
      font-size: var(--type-h2);
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    .access-gate p { color: var(--c-ink-2); font-size: var(--type-meta); }
    .access-gate form {
      display: flex;
      gap: var(--p-sp-2);
      margin-top: var(--p-sp-4);
    }
    .access-gate input {
      flex: 1;
      min-width: 0;
      padding: 10px 2px;
      border: 0;
      border-bottom: 1px solid var(--c-rule-strong);
      border-radius: 0;
      background: transparent;
      color: var(--c-ink);
      font-family: var(--font-mono);
      font-size: var(--type-meta);
      letter-spacing: 0.06em;
    }
    .access-gate input::placeholder { color: var(--c-ink-3); }
    .access-gate input:focus-visible {
      outline: none;
      border-bottom-color: var(--c-metal);
    }
    .access-gate p.access-gate__error {
      margin: var(--p-sp-2) 0 0;
      min-height: 1.4em;
      color: var(--c-accent-2);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.04em;
    }

    @media screen and (max-width: 1100px) {
      .article-shell { grid-template-columns: minmax(0, var(--measure)); }
      .article-margin { display: none; }
    }
    @media screen and (max-width: 720px) {
      .article-shell { padding-block: var(--p-sp-7) var(--p-sp-8); }
      .article-header h1 { font-size: clamp(1.5rem, 5.6vw, 2rem); }
    }
  }

  /* 导出 PDF：单栏 + 档案登记条 */
  @layer print {
    @media print {
      /* 站点外壳：legacy 的打印规则只认旧 class（.site-header/.site-footer） */
      .f-header,
      .f-footer { display: none; }
      .article-shell { display: block; padding: 0; }
      .article { max-width: none; }
      .article-margin {
        display: grid;
        position: static;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        max-height: none;
        overflow: visible;
        margin-bottom: var(--p-sp-5);
      }
      /* 登记条只保留 dl 的四个字段：铜线与目录不参与打印 */
      .article-margin::before { display: none; }
      .article-header h1 { font-size: 25pt; }
    }
  }
</style>

