---
import { getCollection, type CollectionEntry } from 'astro:content';
import EntryView from '../../components/hz/EntryView.astro';
import { folioCodes } from '../../lib/horizon';
import privateAccess from '../../data/private-access.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.access === 'admin');
  const folioFor = folioCodes(posts);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, folioCode: folioFor(post) },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  folioCode: string;
}

const { post, folioCode } = Astro.props;
---

<EntryView
  post={post}
  folioCode={folioCode}
  mode="admin"
  passwordHash={privateAccess.passwordHash}
/>
