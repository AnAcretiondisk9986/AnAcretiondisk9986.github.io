---
import { getPublicPosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCatalog from '../../components/PostCatalog.astro';
import ThemeCopy from '../../components/ThemeCopy.astro';

const posts = await getPublicPosts();
---

<BaseLayout title="文章" description="Acretiondisk 的全部文章。">
  <header class="catalog-header fusion-catalog-header">
    <div class="catalog-title">
      <p class="eyebrow">ALL NOTES</p>
      <h1>全部文章</h1>
      <p>技术、医学、艺术，以及日常生活中的记录。</p>
    </div>
    <div class="catalog-mark">
      <img class="archive-seal" src="/logo.webp" alt="" width="380" height="380" loading="lazy" />
      <dl>
        <div><dt>文章总数</dt><dd>{String(posts.length).padStart(3, '0')}</dd></div>
        <div><dt>更新状态</dt><dd>持续更新</dd></div>
        <div><dt>排序规则</dt><dd data-order-text>由新至旧</dd></div>
      </dl>
    </div>
  </header>

  <PostCatalog posts={posts} />

  <footer class="catalog-footer">
    <span><ThemeCopy minimal="所有文章均由我本人记录" trace="所有条目均由编目者亲自记录" /></span>
    <span><ThemeCopy minimal={`ACR / CATALOGUS / ${new Date().getFullYear()}`} trace={`ACR / CATALOGUS / ${new Date().getFullYear()}`} cyanotype={`ACR / FIELD NOTES / ${new Date().getFullYear()}`} /></span>
  </footer>
</BaseLayout>
