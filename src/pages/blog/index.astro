---
import { getPublicPosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCatalog from '../../components/PostCatalog.astro';

const posts = await getPublicPosts();
---

<BaseLayout title="编目" description="Acretiondisk 的全部文章。">
  <section class="f-section f-opener">
    <h1 class="f-opener__title">全部文章</h1>
    <p class="f-opener__deck">技术、医学、艺术，以及日常生活中的记录。</p>
    <p class="f-opener__meta">共 {posts.length} 篇</p>
  </section>

  <PostCatalog posts={posts} />

</BaseLayout>

<!-- 编目页版式（页头 + 工具栏 + 条目网格）统一定义在 src/styles/pages-next.css 的
     components 层，页面本身不再带 <style>，避免"页面样式晚于全局样式加载"
     造成同一组件两处来源、互相打架。 -->
