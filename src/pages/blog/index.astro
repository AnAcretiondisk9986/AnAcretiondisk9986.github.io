---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCatalog from '../../components/PostCatalog.astro';
import WordCloud from '../../components/WordCloud.astro';
import ThemeCopy from '../../components/ThemeCopy.astro';
import { buildWordCloud } from '../../lib/wordcloud';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    || (b.data.dayIndex ?? 0) - (a.data.dayIndex ?? 0)
    || b.id.localeCompare(a.id));

// 全站正文词频统计,生成词云数据
const cloudWords = buildWordCloud(
  posts.map((p) => ({ title: p.data.title, body: p.body ?? '' })),
);
---

<BaseLayout title="文章" description="Acretiondisk 的全部文章。">
  <header class="catalog-header">
    <div class="catalog-title">
      <p class="eyebrow">CATALOGUS SCRIPTORUM</p>
      <h1><ThemeCopy minimal="全部文章" trace="卷册目录" /></h1>
      <p><ThemeCopy minimal="技术、医学、艺术，以及日常生活中的记录。" trace="技术、医学、艺术，以及生活里值得被编目的细节。" /></p>
    </div>
    <div class="catalog-mark">
      <img class="archive-seal" src="/logo.webp" alt="" width="380" height="380" loading="lazy" />
      <dl>
        <div><dt><ThemeCopy minimal="文章总数" trace="馆藏总数" /></dt><dd>{String(posts.length).padStart(3, '0')}</dd></div>
        <div><dt><ThemeCopy minimal="更新状态" trace="卷册状态" /></dt><dd><ThemeCopy minimal="持续更新" trace="开放编目" /></dd></div>
        <div><dt>排序规则</dt><dd data-order-text>由新至旧</dd></div>
      </dl>
    </div>
  </header>

  <WordCloud words={cloudWords} title="关键词" traceTitle="关键词索引" />

  <PostCatalog posts={posts} />

  <footer class="catalog-footer">
    <span><ThemeCopy minimal="所有文章均由我本人记录" trace="所有条目均由编目者亲自记录" /></span>
    <span>ACR / CATALOGUS / {new Date().getFullYear()}</span>
  </footer>
</BaseLayout>
