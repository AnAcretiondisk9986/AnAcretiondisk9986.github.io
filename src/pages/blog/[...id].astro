---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const dayCounts = new Map<string, number>();
  for (const post of posts) {
    const key = post.data.pubDate.toISOString().slice(0, 10);
    dayCounts.set(key, (dayCounts.get(key) ?? 0) + 1);
  }
  return posts.map((post) => {
    const key = post.data.pubDate.toISOString().slice(0, 10);
    const folioBase = `${post.data.pubDate.getFullYear()}—${String(post.data.pubDate.getMonth() + 1).padStart(2, '0')}${String(post.data.pubDate.getDate()).padStart(2, '0')}`;
    const folioCode = dayCounts.get(key)! > 1
      ? `${folioBase}—${String(post.data.dayIndex ?? 1).padStart(2, '0')}`
      : folioBase;
    return { params: { id: post.id }, props: { post, folioCode } };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  folioCode: string;
}

const { post, folioCode } = Astro.props;
const { Content } = await render(post);
const printFolio = JSON.stringify(`FOLIO ${folioCode}`);
const printUrl = JSON.stringify(
  `${Astro.site?.origin ?? ''}${Astro.url.pathname}`.replace(/\/$/, ''),
);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="article-shell">
    <aside class="article-margin">
      <a class="back-link" href="/blog/">← 返回卷册目录</a>
      <button class="print-action" type="button" onclick="window.print()">
        <span aria-hidden="true">⤓</span> 导出 PDF
      </button>
      <dl>
        <div><dt>条目编号</dt><dd>{folioCode}</dd></div>
        <div><dt>分类标签</dt><dd>{post.data.tags.join(' / ') || '未分类'}</dd></div>
        <div><dt>记录者</dt><dd>Acretiondisk</dd></div>
        <div><dt>状态</dt><dd>公开阅览</dd></div>
      </dl>
      <p class="margin-note">原始观察记录。文字与观点会随认知更新而修订。</p>
    </aside>

    <article class="article">
      <header class="article-header">
        <div class="article-register">
          <span>FOLIO {folioCode}</span>
          <span>ARCHIVUM PERSONAE</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            发布 · {post.data.pubDate.toLocaleDateString('zh-CN')}
          </time>
          {post.data.updatedDate && (
            <time datetime={post.data.updatedDate.toISOString()}>
              修订 · {post.data.updatedDate.toLocaleDateString('zh-CN')}
            </time>
          )}
        </div>
      </header>

      <div class="article-ornament" aria-hidden="true"><span>✦</span></div>

      <div class="prose">
        <Content />
      </div>

      <footer class="article-endmark">
        <span>FINIS</span>
        <p>本条目至此结束</p>
      </footer>
    </article>
  </div>
</BaseLayout>

<style is:global is:inline>
  /* 打印页眉页脚：Chrome / Edge / Safari 支持 @page margin boxes，Firefox 优雅降级（仅无页眉页脚） */
  @page {
    size: A4;
    margin: 21mm 19mm 20mm;
    @top-left {
      content: 'ACRETIONDISK — ARCHIVUM PERSONAE';
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 7.5pt;
      letter-spacing: 0.16em;
      color: #8a8378;
    }
    @top-right {
      content: ${printFolio};
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 7.5pt;
      letter-spacing: 0.16em;
      color: #8d302b;
    }
    @bottom-left {
      content: ${printUrl};
      font-family: 'Cascadia Code', Consolas, monospace;
      font-size: 7pt;
      color: #9a948a;
    }
    @bottom-right {
      content: '第 ' counter(page) ' 页 · 共 ' counter(pages) ' 页';
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 7.5pt;
      letter-spacing: 0.1em;
      color: #8a8378;
    }
  }
</style>
