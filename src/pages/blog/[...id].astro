---
import { getCollection, type CollectionEntry } from 'astro:content';
import EntryView from '../../components/hz/EntryView.astro';
import { folioCodes, isListable } from '../../lib/horizon';

export async function getStaticPaths() {
  const posts = await getCollection('blog', isListable);
  const folioFor = folioCodes(posts);

  // 上下篇按发布时间升序排列（同日再按 dayIndex）
  const ordered = [...posts].sort((a, b) => {
    const dt = a.data.pubDate.getTime() - b.data.pubDate.getTime();
    return dt !== 0 ? dt : (a.data.dayIndex ?? 1) - (b.data.dayIndex ?? 1);
  });
  const idxMap = new Map(ordered.map((p, i) => [p.id, i]));
  const brief = (p: CollectionEntry<'blog'> | undefined) =>
    p ? { id: p.id, title: p.data.title, folioCode: folioFor(p) } : null;

  return posts.map((post) => {
    const i = idxMap.get(post.id)!;
    return {
      params: { id: post.id },
      props: {
        post,
        folioCode: folioFor(post),
        prevPost: brief(ordered[i - 1]),
        nextPost: brief(ordered[i + 1]),
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  folioCode: string;
  prevPost: { id: string; title: string; folioCode: string } | null;
  nextPost: { id: string; title: string; folioCode: string } | null;
}

const { post, folioCode, prevPost, nextPost } = Astro.props;
const mode = post.data.access === 'authorized' ? 'authorized' : 'public';
---

<EntryView
  post={post}
  folioCode={folioCode}
  mode={mode}
  prevPost={prevPost}
  nextPost={nextPost}
/>
