---
import Icon from '../../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeCopy from '../../components/ThemeCopy.astro';
import { shortIdForPath } from '../../lib/shortlink';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && !data.archived && data.access !== 'admin' && (!data.scheduledAt || data.scheduledAt.getTime() <= Date.now()));
  const dayCounts = new Map<string, number>();
  for (const post of posts) {
    const key = post.data.pubDate.toISOString().slice(0, 10);
    dayCounts.set(key, (dayCounts.get(key) ?? 0) + 1);
  }
  return posts.map((post) => {
    const key = post.data.pubDate.toISOString().slice(0, 10);
    const folioBase = `${post.data.pubDate.getFullYear()}—${String(post.data.pubDate.getMonth() + 1).padStart(2, '0')}${String(post.data.pubDate.getDate()).padStart(2, '0')}`;
    const folioCode = dayCounts.get(key)! > 1
      ? `${folioBase}—${String(post.data.dayIndex ?? 1).padStart(2, '0')}`
      : folioBase;
    return { params: { id: post.id }, props: { post, folioCode } };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  folioCode: string;
}

const { post, folioCode } = Astro.props;
const { Content } = await render(post);
const isAuthorized = post.data.access === 'authorized';
const firstImageFromBody = (body = '') => body.match(/!\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)/)?.[1] ?? '';
const articleCover = post.data.cover?.trim() || firstImageFromBody(post.body ?? '');
// 阅读时长：按正文有效字数估算（中文约 400 字/分钟），只用于页头元信息行
const readingMinutes = Math.max(
  1,
  Math.round(
    (post.body ?? '')
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
      .replace(/\[[^\]]*\]\([^)]*\)/g, ' ')
      .replace(/<[^>]*>/g, ' ')
      .replace(/[#>*_`|~\-\s]/g, '').length / 400,
  ),
);
const printFolio = JSON.stringify(`FOLIO ${folioCode}`);
const printUrl = JSON.stringify(
  `${Astro.site?.origin ?? ''}${Astro.url.pathname}`.replace(/\/$/, ''),
);
// 分享短链:纯 ASCII 短码,避免中文 slug 在复制时被百分号转码拉长链接
const shortUrl = `${Astro.site?.origin ?? ''}/s/${shortIdForPath(post.id)}`;
// 时间显示:frontmatter 写了具体时间才精确到分钟,纯日期(如 "2026-08-04",解析为 UTC 午夜)只显示日期,
// 避免时区偏移产生虚假的 08:00。判断用 UTC(纯日期字符串按 UTC 解析),显示用本地时间。
const pad2 = (n: number) => String(n).padStart(2, '0');
const fmtMinute = (d: Date) => {
  const date = `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  const isDateOnly = d.getUTCHours() === 0 && d.getUTCMinutes() === 0;
  return isDateOnly ? date : `${date} ${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="article-reading-progress" aria-hidden="true"><span data-reading-progress-bar></span></div>
  <div class="article-shell">
    <aside class="article-margin f-article__aside">
      <a class="back-link" href="/blog/"><Icon name="arrow-left" /> <ThemeCopy minimal="返回文章" trace="返回卷册目录" /></a>
      <a class="private-channel" href="/private/">
        <span class="private-channel__copy"><ThemeCopy minimal="私密文章" trace="私密卷册" /><small>PRIVATE ARCHIVE</small></span>
        <span class="private-channel__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
      </a>
      <button class="print-action" type="button" onclick="window.print()">
        <Icon name="download" /> 导出 PDF
      </button>
      <dl>
        <div><dt><ThemeCopy minimal="文章编号" trace="条目编号" /></dt><dd>{folioCode}</dd></div>
        <div><dt><ThemeCopy minimal="标签" trace="分类标签" /></dt><dd>{post.data.tags.join(' / ') || '未分类'}</dd></div>
        <div><dt><ThemeCopy minimal="作者" trace="记录者" /></dt><dd>Acretiondisk</dd></div>
        <div><dt>状态</dt><dd><ThemeCopy minimal={isAuthorized ? '授权阅览' : '公开'} trace={isAuthorized ? '验证后阅览' : '公开阅览'} /></dd></div>
      </dl>

      <div class="share-link" data-shortlink>
        <button class="print-action share-link__btn" type="button" data-shortlink-generate>
          <Icon name="copy" /> 生成分享短链
        </button>
        <div class="share-link__panel" data-shortlink-panel>
          <span class="share-link__title" data-shortlink-title>《{post.data.title}》</span>
          <code class="share-link__url" data-shortlink-url>{shortUrl}</code>
          <button class="share-link__copy" type="button" data-shortlink-copy>复制</button>
          <span class="share-link__hint" data-shortlink-hint role="status"></span>
        </div>
      </div>

      <nav class="article-toc" data-article-toc aria-label="文章目录" hidden>
        <p>文章目录</p>
        <ol></ol>
      </nav>
      <p class="margin-note"><ThemeCopy minimal="文字与观点会随认知更新。" trace="原始观察记录。文字与观点会随认知更新而修订。" /></p>
    </aside>

    <article class="article">
      <header class="article-header">
        <div class="article-register">
          <span class="f-article__eyebrow"><ThemeCopy cyanotype={`NOTE / ${folioCode}`} minimal={`ARTICLE ${folioCode}`} trace={`FOLIO ${folioCode}`} /></span>
          <span class="article-register__brand"><ThemeCopy minimal="ACRETIONDISK" trace="ARCHIVUM PERSONAE" /></span>
        </div>
        <h1 class="f-article__title">{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-meta f-article__meta">
          <time datetime={post.data.pubDate.toISOString()}>
            发布 · {fmtMinute(post.data.pubDate)}
          </time>
          <span class="article-meta__read">约 {readingMinutes} 分钟</span>
          {post.data.updatedDate && (
            <time datetime={post.data.updatedDate.toISOString()}>
              修订 · {fmtMinute(post.data.updatedDate)}
            </time>
          )}
          <span class="article-meta__pv" id="busuanzi_container_page_pv" hidden>
            阅读 · <span id="busuanzi_value_page_pv">—</span>
          </span>
        </div>
      </header>

      {articleCover && (
        <figure class="article-cover">
          <img src={articleCover} alt="" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="article-ornament" aria-hidden="true"><Icon name="aperture" /></div>

      {isAuthorized ? (
        <div class="access-gate" data-authorized-gate data-authorized-article={post.id}>
          <p class="access-gate__eyebrow">授权级文章</p>
          <h2>输入站长的网名后继续阅读</h2>
          <p>答案不区分大小写。</p>
          <form data-authorized-form>
            <input name="answer" type="text" autocomplete="off" required placeholder="站长的网名" aria-label="站长的网名" />
            <button class="f-btn" type="submit">验证并打开</button>
          </form>
          <p class="access-gate__error" data-authorized-error role="alert"></p>
        </div>
      ) : (
        <div class="prose"><Content /></div>
      )}
      {isAuthorized && <template data-authorized-body><div class="prose"><Content /></div></template>}

      <footer class="article-endmark">
        <span><ThemeCopy minimal="读完了" trace="FINIS" /></span>
        <p><ThemeCopy minimal="文章到这里结束" trace="本条目至此结束" /></p>
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  // 音乐播放条：把正文里的 .song-player 占位块增强为可播放的播放条
  // 模块只执行一次；astro:page-load 在首次加载与每次 VT 导航后触发，重新扫描新 DOM
  // （注意：不能给本脚本加 data-astro-rerun——会隐式 is:inline 导致 import/TS 内联失效，见 AGENT_HANDOFF v3.0.1）
  import { initSongPlayers, stopSongPlayback } from '../../scripts/song-player';
  initSongPlayers();
  // 内联 module 每次 VT 导航会重新执行：用全局标记保证监听器只注册一次
  if (!(window as any).__acrSongPlayerBound) {
    (window as any).__acrSongPlayerBound = true;
    document.addEventListener('astro:page-load', () => {
      stopSongPlayback(); // 离开上一页后停止其音频，避免声音延续到新页面
      initSongPlayers();
    });
  }
</script>

<script is:inline data-astro-rerun>
  (() => {
    const article = document.querySelector('.article');
    const toc = document.querySelector('[data-article-toc]');
    const list = toc?.querySelector('ol');
    const progress = document.querySelector('[data-reading-progress-bar]');
    if (!article) return;

    const headings = [...article.querySelectorAll('h2, h3')].filter((heading) => heading.textContent?.trim());
    if (toc && list && headings.length) {
      list.innerHTML = '';
      headings.forEach((heading, index) => {
        if (!heading.id) {
          const slug = (heading.textContent || '')
            .trim()
            .toLocaleLowerCase()
            .replace(/[^\p{L}\p{N}]+/gu, '-')
            .replace(/^-|-$/g, '');
          heading.id = `section-${index + 1}-${slug || 'note'}`;
        }
        const item = document.createElement('li');
        if (heading.tagName === 'H3') item.className = 'article-toc__subitem';
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent.trim();
        item.append(link);
        list.append(item);
      });
      toc.hidden = false;
    }

    if (!progress) return;
    let raf = 0;
    const updateProgress = () => {
      raf = 0;
      const rect = article.getBoundingClientRect();
      const total = Math.max(1, article.scrollHeight - window.innerHeight);
      const passed = Math.min(total, Math.max(0, -rect.top));
      progress.style.transform = `scaleX(${passed / total})`;
    };
    const requestUpdate = () => {
      if (!raf) raf = requestAnimationFrame(updateProgress);
    };
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    requestUpdate();
  })();
</script>

{isAuthorized && <script is:inline data-astro-rerun>
  (() => {
    const form = document.querySelector('[data-authorized-form]');
    const gate = document.querySelector('[data-authorized-gate]');
    const error = document.querySelector('[data-authorized-error]');
    if (!form || !gate || !error) return;
    const key = `acr-authorized:${gate.dataset.authorizedArticle || 'article'}`;
    const unlocked = sessionStorage.getItem(key) === '1';
    const reveal = () => {
      gate.outerHTML = '<div class="prose" data-authorized-content></div>';
      const target = document.querySelector('[data-authorized-content]');
      if (target) target.innerHTML = document.querySelector('template[data-authorized-body]')?.innerHTML || '';
    };
    if (unlocked) reveal();
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = String(new FormData(form).values().next().value || '').trim().toLowerCase();
      if (value === 'anacretiondisk' || value === 'acretiondisk') {
        sessionStorage.setItem(key, '1');
        reveal();
      } else error.textContent = '网名不正确，请再试一次。';
    });
  })();
</script>}

<script is:inline data-astro-rerun>
  // 阅览次数（不蒜子统计）：按当前页面 URL 计数，境内可直连。
  // 数字就绪后才显示条目；服务不可用时保持隐藏，不影响页面其余内容。
  (() => {
    const valueEl = document.getElementById('busuanzi_value_page_pv');
    const box = document.getElementById('busuanzi_container_page_pv');
    if (!valueEl || !box) return;

    window.busuanziCallback = (data) => {
      const n = Number(data && data.page_pv);
      if (Number.isFinite(n) && n > 0) {
        valueEl.textContent = n.toLocaleString('zh-CN');
        box.hidden = false;
      }
    };

    const s = document.createElement('script');
    s.async = true;
    // 不蒜子靠 Referer 的完整 URL 区分页面：必须显式允许发送完整路径，
    // 否则浏览器默认只发域名，所有文章的浏览量会混在一起。
    s.referrerPolicy = 'no-referrer-when-downgrade';
    s.src = 'https://busuanzi.ibruce.info/busuanzi?jsonpCallback=busuanziCallback';
    s.onerror = () => { box.hidden = true; };
    document.head.appendChild(s);
  })();
</script>

<script is:inline data-astro-rerun>
  // 分享短链:点击「生成」展示《标题》+ 短链(纯 ASCII,复制不会被转码),点短链或「复制」即可复制《标题》与短链。
  // data-astro-rerun:VT 导航后 DOM 被替换,每次页面加载需重新绑定;
  // IIFE 包裹,重复执行时顶层 const 不冲突。
  (() => {
    const root = document.querySelector('[data-shortlink]');
    const generateBtn = root?.querySelector('[data-shortlink-generate]');
    const panel = root?.querySelector('[data-shortlink-panel]');
    const copyBtn = root?.querySelector('[data-shortlink-copy]');
    const urlEl = root?.querySelector('[data-shortlink-url]');
    const titleEl = root?.querySelector('[data-shortlink-title]');
    const hint = root?.querySelector('[data-shortlink-hint]');
    if (!root || !generateBtn || !panel || !copyBtn || !urlEl || !titleEl || !hint) return;

    let hintTimer = 0;
    const showHint = (text) => {
      hint.textContent = text;
      window.clearTimeout(hintTimer);
      hintTimer = window.setTimeout(() => { hint.textContent = ''; }, 2200);
    };

    const copyShortUrl = async () => {
      // 复制内容 = 《标题》 + 短链,便于分享时识别文章
      const title = (titleEl?.textContent || '').trim();
      const url = (urlEl.textContent || '').trim();
      const text = title ? `${title} ${url}` : url;
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        // 剪贴板 API 不可用(非安全上下文 / 权限受限)时降级为「选中复制」
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        ta.remove();
      }
      showHint(ok ? '已复制 ✓' : '复制失败,请手动选择短链复制');
    };

    generateBtn.addEventListener('click', () => {
      root.classList.add('is-open');
      generateBtn.hidden = true;
    });
    copyBtn.addEventListener('click', copyShortUrl);
    urlEl.addEventListener('click', copyShortUrl);
  })();
</script>

<style is:global>
  /* ── 文章页：Folio 版式（180px 边注 · 34em 正文 · 细线分隔 · 铜色编号） ──
     只在本页覆盖 legacy；不改 src/styles/*。 */
  @layer components {
    /* 阅读进度：一条铜线（legacy 为青→珊瑚渐变） */
    .article-reading-progress {
      position: fixed;
      z-index: 100;
      inset-inline: 0;
      top: 0;
      height: 2px;
      pointer-events: none;
      background: color-mix(in oklab, var(--c-metal) 14%, transparent);
    }
    .article-reading-progress span {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--c-metal);
      transform: scaleX(0);
      transform-origin: left center;
    }

    /* 版心：180px 边注 + 34em 正文，整体居中 */
    .article-shell {
      display: grid;
      grid-template-columns: 180px minmax(0, var(--measure));
      gap: clamp(24px, 4vw, 64px);
      justify-content: center;
      align-items: start;
      padding-block: var(--p-sp-8) var(--p-sp-9);
    }

    /* 边注：只做定位与滚动；字号/行高/墨色/顶部铜线来自 .f-article__aside */
    .article-margin {
      position: sticky;
      top: 92px;
      align-self: start;
      max-height: calc(100vh - 116px);
      overflow-y: auto;
      scrollbar-width: none;
      padding-top: 0;
    }
    .article-margin::-webkit-scrollbar { display: none; }

    /* —— 边注条目：细线 + 等宽编号 —— */
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: var(--p-sp-5);
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .back-link:hover { color: var(--c-ink); }
    .back-link svg,
    .print-action svg,
    .private-channel svg { width: 12px; height: 12px; }

    .private-channel {
      margin: 0 0 var(--p-sp-5);
      padding: 8px 0;
      border: 0;
      border-block: 1px solid var(--c-rule);
      border-radius: 0;
      background: transparent;
      color: var(--c-ink-2);
      transform: none;
    }
    .private-channel:hover {
      border-color: var(--c-rule-strong);
      background: transparent;
      color: var(--c-ink);
      transform: none;
    }
    .private-channel__copy {
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.1em;
    }
    .private-channel__copy small {
      color: var(--c-metal);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.14em;
    }
    .private-channel__arrow { color: var(--c-metal); }

    .print-action {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 var(--p-sp-3);
      padding: 8px 12px;
      border: 1px solid var(--c-rule);
      border-radius: var(--r-frame);
      background: transparent;
      color: var(--c-ink-2);
      box-shadow: none;
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1;
    }
    .print-action:hover {
      border-color: var(--c-metal);
      background: transparent;
      color: var(--c-ink);
      box-shadow: none;
    }
    .print-action:focus-visible { outline: 1px solid var(--c-accent); outline-offset: 3px; }

    .article-margin dl {
      margin: var(--p-sp-4) 0 0;
      border-top: 1px solid var(--c-rule);
    }
    .article-margin dl div {
      padding-block: 9px;
      border-bottom: 1px solid var(--c-rule);
    }
    .article-margin dt {
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .article-margin dd {
      margin: 3px 0 0;
      color: var(--c-ink-2);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.04em;
      overflow-wrap: anywhere;
    }

    /* 分享短链：细框、无底色 */
    .share-link { margin-bottom: var(--p-sp-4); }
    .share-link__panel {
      border: 1px solid var(--c-rule-strong);
      border-radius: var(--r-frame);
      background: transparent;
    }
    .share-link__title {
      color: var(--c-ink);
      font-family: var(--font-display);
      font-size: var(--type-meta);
      font-style: italic;
      letter-spacing: 0;
    }
    .share-link__url {
      color: var(--c-ink-2);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
    }
    .share-link__copy {
      border: 1px solid var(--c-rule);
      border-radius: 0;
      background: transparent;
      color: var(--c-ink-2);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      letter-spacing: 0.08em;
    }
    .share-link__copy:hover {
      border-color: var(--c-ink);
      background: var(--c-ink);
      color: var(--c-paper);
    }
    .share-link__hint {
      color: var(--c-ink-3);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
    }

    /* 目录 */
    .article-toc {
      margin-top: var(--p-sp-5);
      padding-top: var(--p-sp-3);
      border-top: 1px solid var(--c-rule);
    }
    .article-toc[hidden] { display: none; }
    .article-toc > p {
      margin: 0 0 8px;
      color: var(--c-ink-3);
      font-size: var(--type-micro);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .article-toc ol { display: grid; gap: 6px; }
    .article-toc li.article-toc__subitem { padding-left: 10px; }
    .article-toc a {
      color: var(--c-ink-2);
      font-size: var(--type-micro);
      line-height: 1.5;
    }
    .article-toc a:hover { color: var(--c-metal); }

    .margin-note {
      margin-top: var(--p-sp-4);
      padding-left: var(--p-sp-3);
      border-left: 1px solid var(--c-metal);
      color: var(--c-ink-3);
      font-family: var(--font-body);
      font-size: var(--type-micro);
      line-height: 1.8;
    }

    /* —— 页头：编号 → 标题 → 元信息 → 1px 细线 —— */
    .article { min-width: 0; }
    .article-header {
      padding-bottom: var(--p-sp-5);
      border-bottom: 1px solid var(--c-rule);
    }
    .article-register {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--p-sp-4);
      margin-bottom: var(--p-sp-3);
    }
    .article-register__brand {
      color: var(--c-ink-3);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    /* 字号 / 行高 / text-wrap 来自 .f-article__title，这里只收紧字距 */
    .article-header h1 { letter-spacing: -0.01em; }
    .article-deck {
      max-width: none;
      margin-bottom: var(--p-sp-4);
      color: var(--c-ink-2);
      font-family: var(--font-display);
      font-size: var(--type-lead);
      font-style: italic;
      letter-spacing: 0;
      line-height: 1.7;
    }
    .article-meta > * + * {
      padding-left: var(--p-sp-3);
      border-left: 1px solid var(--c-rule);
    }

    .article-cover {
      margin: var(--p-sp-6) 0 0;
      aspect-ratio: 3 / 2;
      min-height: 0;
      overflow: hidden;
      border: 1px solid var(--c-rule-strong);
      border-radius: var(--r-frame);
      background: var(--c-paper-sunken);
    }
    .article-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.12) contrast(1.02);
    }

    /* 饰花：细线 + 小徽记，随主题 --deco-fleuron 显隐 */
    .article-ornament {
      display: flex;
      align-items: center;
      gap: var(--p-sp-3);
      margin-block: var(--p-sp-6);
      color: var(--c-metal);
      opacity: var(--deco-fleuron);
    }
    .article-ornament::before,
    .article-ornament::after {
      flex: 1;
      height: 1px;
      content: "";
      background: var(--c-rule);
    }
    .article-ornament svg { width: 15px; height: 15px; }

    /* legacy 的首字下沉 / 节号仍是朱红：接回 tokens（首字用强调色，节号用铜） */
    .prose > p:first-of-type::first-letter {
      float: left;
      margin: 0;
      padding: 0.04em 0.08em 0 0;
      color: var(--c-accent);
      font-family: var(--font-display);
      font-size: 3.6em;
      font-weight: 500;
      line-height: 0.92;
    }
    .prose h2::before { color: var(--c-metal); }

    .article-endmark {
      display: grid;
      justify-items: center;
      margin-top: var(--p-sp-8);
      padding-top: var(--p-sp-5);
      border-top: 1px solid var(--c-rule);
      color: var(--c-ink-3);
    }
    .article-endmark span {
      color: var(--c-metal);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .article-endmark p {
      margin: 8px 0 0;
      font-family: var(--font-display);
      font-size: var(--type-meta);
      font-style: italic;
      letter-spacing: 0.04em;
    }

    /* —— 授权级文章门禁：细线输入框 + .f-btn —— */
    .access-gate {
      max-width: none;
      margin: var(--p-sp-6) 0 0;
      padding: var(--p-sp-5) 0 0;
      border: 0;
      border-top: 1px solid var(--c-rule-strong);
      background: transparent;
    }
    .access-gate__eyebrow {
      margin: 0 0 var(--p-sp-2);
      color: var(--c-metal);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    .access-gate h2 {
      margin: 0 0 var(--p-sp-2);
      font-family: var(--font-display);
      font-size: var(--type-h2);
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    .access-gate p { color: var(--c-ink-2); font-size: var(--type-meta); }
    .access-gate form {
      display: flex;
      gap: var(--p-sp-2);
      margin-top: var(--p-sp-4);
    }
    .access-gate input {
      flex: 1;
      min-width: 0;
      padding: 10px 2px;
      border: 0;
      border-bottom: 1px solid var(--c-rule-strong);
      border-radius: 0;
      background: transparent;
      color: var(--c-ink);
      font-family: var(--font-mono);
      font-size: var(--type-meta);
      letter-spacing: 0.06em;
    }
    .access-gate input::placeholder { color: var(--c-ink-3); }
    .access-gate input:focus-visible {
      outline: none;
      border-bottom-color: var(--c-metal);
    }
    .access-gate p.access-gate__error {
      margin: var(--p-sp-2) 0 0;
      min-height: 1.4em;
      color: var(--c-accent-2);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.04em;
    }

    /* —— 响应式：≤1100px 收起边注（仅屏幕，打印另走 @layer print） —— */
    @media screen and (max-width: 1100px) {
      .article-shell { grid-template-columns: minmax(0, var(--measure)); }
      .article-margin { display: none; }
    }
    @media screen and (max-width: 720px) {
      .article-shell { padding-block: var(--p-sp-7) var(--p-sp-8); }
      .article-header h1 { font-size: clamp(1.5rem, 5.6vw, 2rem); }
      .article-cover { aspect-ratio: 4 / 3; }
    }
  }

  /* 导出 PDF：legacy 的打印版式（单栏 + 档案登记条）优先于上面的屏幕版式 */
  @layer print {
    @media print {
      /* 站点外壳：legacy 的打印规则只认旧 class（.site-header/.site-footer） */
      .f-header,
      .f-footer { display: none; }
      .article-shell { display: block; padding: 0; }
      .article { max-width: none; }
      .article-margin {
        display: grid;
        position: static;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        max-height: none;
        overflow: visible;
        margin-bottom: var(--p-sp-5);
      }
      /* 登记条只保留 dl 的四个字段：铜线与目录不参与打印 */
      .article-margin::before { display: none; }
      .article-toc { display: none; }
      .article-header h1 { font-size: 25pt; }
    }
  }
</style>

