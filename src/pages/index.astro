---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveSeal from '../components/ArchiveSeal.astro';
import SpecimenPlate from '../components/SpecimenPlate.astro';
import ThemeCopy from '../components/ThemeCopy.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    || (b.data.dayIndex ?? 0) - (a.data.dayIndex ?? 0)
    || b.id.localeCompare(a.id));

const dayCounts = new Map<string, number>();
for (const post of posts) {
  const key = post.data.pubDate.toISOString().slice(0, 10);
  dayCounts.set(key, (dayCounts.get(key) ?? 0) + 1);
}
const dayKeyOf = (post: (typeof posts)[number]) => post.data.pubDate.toISOString().slice(0, 10);
---

<BaseLayout>
  <section class="codex-hero">
    <div class="hero-copy-panel">
      <div class="folio-kicker">
        <span>PERSONAL ARCHIVE</span>
        <span>VOL. I · MMXXVI</span>
      </div>

      <p class="eyebrow"><ThemeCopy minimal="个人博客" trace="一份仍在书写的私人行记" /></p>
      <h1>
        <ThemeCopy minimal="Acretiondisk">
          <Fragment slot="trace"><span>在生活之中，</span><em>留存我的观察。</em></Fragment>
        </ThemeCopy>
      </h1>
      <p class="hero-copy">
        <ThemeCopy minimal="记录想法、作品与生活。" trace="记录我个人生活中的想法与成果。" />
      </p>

      <div class="hero-actions">
        <a class="primary-link" href="/blog/">
          <span><ThemeCopy minimal="浏览文章" trace="展开卷册" /></span>
          <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="/about/"><ThemeCopy minimal="了解我" trace="阅览编目者档案" /></a>
      </div>

      <dl class="hero-register">
        <div><dt><ThemeCopy minimal="内容" trace="编目范围" /></dt><dd>医学 / 技术 / 艺术</dd></div>
        <div><dt><ThemeCopy minimal="状态" trace="记录状态" /></dt><dd>持续更新</dd></div>
        <div><dt><ThemeCopy minimal="站点编号" trace="馆藏编号" /></dt><dd>ACR—001</dd></div>
      </dl>
    </div>

    <div class="hero-plate-panel">
      <SpecimenPlate />
      <ArchiveSeal class="hero-seal" />
    </div>
  </section>

  <section class="archive-section">
    <div class="section-heading codex-heading">
      <div>
        <p class="eyebrow">RECENT FOLIOS</p>
        <h2><ThemeCopy minimal="最新文章" trace="近期入藏" /></h2>
      </div>
      <div class="heading-note">
        <span>{String(posts.length).padStart(2, '0')} <ThemeCopy minimal="篇文章" trace="件记录" /></span>
        <a href="/blog/"><ThemeCopy minimal="查看全部" trace="完整目录" /> →</a>
      </div>
    </div>

    <div class="gallery-order-bar" aria-label="文章展示顺序">
      <div class="gallery-order-label">
        <span>DISPLAY ORDER</span>
        <strong data-order-status>从新至旧</strong>
      </div>
      <div class="gallery-sort" role="group" aria-label="文章展示顺序">
        <button type="button" data-order-sort="newest" aria-pressed="true">
          <span aria-hidden="true">↓</span>从新至旧
        </button>
        <button type="button" data-order-sort="oldest" aria-pressed="false">
          <span aria-hidden="true">↑</span>从旧至新
        </button>
      </div>
    </div>

    <div class="archive-list" data-order-list>
      {posts.map((post, index) => (
        <article class="archive-entry" data-order-card data-order-date={post.data.pubDate.toISOString().slice(0, 10)} data-order-day-index={post.data.dayIndex ?? 0} data-order-position={index}>
          <div class="entry-number">
            <span><ThemeCopy minimal="文章" trace="FOLIO" /></span>
            <b data-order-sequence data-order-pad="3">{String(index + 1).padStart(3, '0')}</b>
          </div>
          <div class="entry-main">
            <div class="entry-register">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN')}
                {dayCounts.get(dayKeyOf(post))! > 1 && ` · #${String(post.data.dayIndex ?? 0).padStart(2, '0')}`}
              </time>
              <span>{post.data.tags.join(' · ') || '未分类记录'}</span>
            </div>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
          <a class="entry-arrow" href={`/blog/${post.id}/`} aria-label={`阅读《${post.data.title}》`}>↗</a>
        </article>
      ))}
    </div>
  </section>

  <section class="index-coda">
    <ArchiveSeal class="coda-seal" />
    <blockquote><ThemeCopy minimal="“写下来，是为了更清楚地看见自己。”" trace="“记录并非为了留住一切，而是为了在时间中辨认自己。”" /></blockquote>
    <p>FINIS PAGINAE · INITIUM SEQUENTIS</p>
  </section>
</BaseLayout>

<script>
  import { initOrderToggle } from '../scripts/order-toggle';
  // astro:page-load 在整页加载与每次 VT 导航后触发;打包脚本只执行一次,靠事件驱动每次导航重新初始化
  document.addEventListener('astro:page-load', () => initOrderToggle());
</script>
