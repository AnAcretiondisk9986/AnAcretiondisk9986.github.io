---
import { getPublicPosts } from '../lib/posts';
import { sortNewestFirst, thumbOf, type GalleryImageBrief } from '../lib/gallery';
import { buildWordCloud } from '../lib/wordcloud';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCatalog from '../components/PostCatalog.astro';
import WordCloud from '../components/WordCloud.astro';
import GalleryTeaser from '../components/GalleryTeaser.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import SpecimenPlate from '../components/SpecimenPlate.astro';
import ThemeCopy from '../components/ThemeCopy.astro';
import { safeLink } from '../lib/safe-link';
import frontend from '../data/frontend.json';
import about from '../data/about.json';
import standaloneGallery from '../data/gallery.json';

const posts = await getPublicPosts();
const primaryCtaHref = safeLink(frontend.primaryCtaHref, '/blog/');

// 首页精选：最新 5 篇
const recentPosts = posts.slice(0, 5);

// 全站正文词频统计,生成词云数据
const cloudWords = buildWordCloud(
  posts.map((p) => ({ title: p.data.title, body: p.body ?? '' })),
);

// 图志精选：独立图集最新 4 张
const galleryTeaserImages: GalleryImageBrief[] = sortNewestFirst(
  standaloneGallery as GalleryImageBrief[],
)
  .slice(0, 4)
  .map((img) => ({ ...img, thumb: img.thumb ?? thumbOf(img.src) }));
---

<BaseLayout>
  <section class="codex-hero">
    <div class="liquid-hero-media">
      <img class="liquid-hero-image liquid-hero-image--still" src={frontend.stillHeroImage} alt={frontend.stillHeroAlt} style={`object-position:${frontend.stillImagePosition}`} fetchpriority="high" crossorigin="anonymous" />
      <img class="liquid-hero-image liquid-hero-image--fluid" src={frontend.fluidHeroImage} alt={frontend.fluidHeroAlt} style={`object-position:${frontend.fluidImagePosition}`} fetchpriority="high" crossorigin="anonymous" />
      <span class="liquid-hero-scrim"></span>
    </div>
    <div class="hero-copy-panel">
      <div class="folio-kicker">
        <span>PERSONAL ARCHIVE</span>
        <span>VOL. I · MMXXVI</span>
      </div>

      <p class="eyebrow legacy-hero-copy"><ThemeCopy minimal="个人博客" trace="一份仍在书写的私人行记" /></p>
      <p class="eyebrow liquid-hero-copy">{frontend.heroEyebrow}</p>
      <h1 class="legacy-hero-copy">
        <ThemeCopy minimal="Acretiondisk">
          <Fragment slot="trace"><span>在生活之中，</span><em>留存我的观察。</em></Fragment>
        </ThemeCopy>
      </h1>
      <h1 class="liquid-hero-copy liquid-hero-title"><span>{frontend.heroTitleLine1}</span><em>{frontend.heroTitleLine2}</em></h1>
      <p class="hero-copy legacy-hero-copy">
        <ThemeCopy minimal="记录想法、作品与生活。" trace="记录我个人生活中的想法与成果。" />
      </p>
      <p class="hero-copy liquid-hero-copy">{frontend.heroDescription}</p>

      <div class="hero-actions">
        <a class="primary-link" href={primaryCtaHref}>
          <span class="legacy-hero-copy"><ThemeCopy minimal="浏览文章" trace="展开卷册" /></span>
          <span class="liquid-hero-copy">{frontend.primaryCtaLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a class="primary-link private-link" href="/private/">
          <ThemeCopy minimal="私密文章" trace="私密卷册" />
          <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/"><ThemeCopy minimal="了解我" trace="阅览编目者档案" /></a>
      </div>

      <dl class="hero-register">
        <div><dt><ThemeCopy minimal="内容" trace="编目范围" /></dt><dd>医学 / 技术 / 艺术</dd></div>
        <div><dt><ThemeCopy minimal="状态" trace="记录状态" /></dt><dd>持续更新</dd></div>
        <div><dt><ThemeCopy minimal="站点编号" trace="馆藏编号" /></dt><dd>ACR—001</dd></div>
      </dl>
    </div>

    <div class="hero-plate-panel">
      <SpecimenPlate />
      <img class="archive-seal hero-seal" src="/logo.webp" alt="" width="240" height="240" loading="lazy" />
    </div>
  </section>

  <section class="archive-section">
    <div class="section-heading codex-heading">
      <div>
        <p class="eyebrow">RECENT FOLIOS</p>
        <h2><ThemeCopy minimal="最新文章" trace="近期入藏" /></h2>
      </div>
      <div class="heading-note">
        <span>{String(posts.length).padStart(2, '0')} <ThemeCopy minimal="篇文章" trace="件记录" /></span>
        <a href="/blog/"><ThemeCopy minimal="查看全部" trace="完整目录" /> →</a>
      </div>
    </div>

    <PostCatalog posts={recentPosts} toolbar={false} />
  </section>

  <WordCloud words={cloudWords} title="关键词" traceTitle="关键词索引" />

  <GalleryTeaser images={galleryTeaserImages} />

  <AboutTeaser
    avatar={about.avatar}
    lead={about.lead}
    paragraphs={about.paragraphs}
    quoteText={about.quoteText}
  />

  <section class="index-coda">
    <img class="archive-seal coda-seal" src="/logo.webp" alt="" width="132" height="132" loading="lazy" />
    <blockquote><ThemeCopy minimal="“写下来，是为了更清楚地看见自己。”" trace="“记录并非为了留住一切，而是为了在时间中辨认自己。”" /></blockquote>
    <p>FINIS PAGINAE · INITIUM SEQUENTIS</p>
  </section>
</BaseLayout>
