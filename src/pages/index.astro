---
import Icon from '../components/Icon.astro';
import { getPublicPosts } from '../lib/posts';
import { sortNewestFirst, thumbOf, type GalleryImageBrief } from '../lib/gallery';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCatalog from '../components/PostCatalog.astro';
import GalleryTeaser from '../components/GalleryTeaser.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import ThemeCopy from '../components/ThemeCopy.astro';
import { safeLink } from '../lib/safe-link';
import frontend from '../data/frontend.json';
import about from '../data/about.json';
import standaloneGallery from '../data/gallery.json';

const posts = await getPublicPosts();
const primaryCtaHref = safeLink(frontend.primaryCtaHref, '/blog/');

// 首页精选：最新 5 篇
const recentPosts = posts.slice(0, 5);

// 图志精选：独立图集最新 4 张
const galleryTeaserImages: GalleryImageBrief[] = sortNewestFirst(
  standaloneGallery as GalleryImageBrief[],
)
  .slice(0, 4)
  .map((img) => ({ ...img, thumb: img.thumb ?? thumbOf(img.src) }));
---

<BaseLayout>
  <section class="fusion-hero" aria-labelledby="fusion-hero-title">
    <div class="fusion-hero__media" aria-hidden="true">
      <img src={frontend.stillHeroImage} alt="" style={`object-position:${frontend.stillImagePosition}`} fetchpriority="high" crossorigin="anonymous" />
    </div>
    <div class="fusion-hero__content">
      <p class="fusion-hero__eyebrow">{frontend.heroEyebrow}</p>
      <h1 id="fusion-hero-title"><span>{frontend.heroTitleLine1}</span><em>{frontend.heroTitleLine2}</em></h1>
      <p class="fusion-hero__description">{frontend.heroDescription}</p>
      <div class="fusion-hero__actions">
        <a class="fusion-button fusion-button--primary" href={primaryCtaHref}>
          {frontend.primaryCtaLabel}<Icon name="arrow-right" />
        </a>
        <a class="fusion-button fusion-button--ghost" href="/gallery/">查看图像</a>
      </div>
      <div class="fusion-hero__meta" aria-label="博客内容范围">
        <span>医学 · 技术 · 艺术</span>
        <span>持续更新</span>
      </div>
    </div>
  </section>

  <section class="fusion-section fusion-section--posts">
    <div class="fusion-section__header">
      <div>
        <p class="eyebrow">LATEST NOTES</p>
        <h2>最新文章</h2>
      </div>
      <div class="fusion-section__aside">
        <span>{posts.length} 篇公开文章</span>
        <a href="/blog/">查看全部 <Icon name="arrow-right" /></a>
      </div>
    </div>

    <PostCatalog posts={recentPosts} toolbar={false} />
  </section>

  <GalleryTeaser images={galleryTeaserImages} />

  <AboutTeaser
    avatar={about.avatar}
    lead={about.lead}
    paragraphs={about.paragraphs}
    quoteText={about.quoteText}
  />

  <section class="index-coda">
    <img class="archive-seal coda-seal" src="/logo.webp" alt="" width="132" height="132" loading="lazy" />
    <blockquote><ThemeCopy minimal="“写下来，是为了更清楚地看见自己。”" trace="“记录并非为了留住一切，而是为了在时间中辨认自己。”" /></blockquote>
    <p><ThemeCopy minimal="FINIS PAGINAE · INITIUM SEQUENTIS" trace="FINIS PAGINAE · INITIUM SEQUENTIS" cyanotype="THE STUDY CONTINUES. / 下次观察见。" /></p>
  </section>
</BaseLayout>
