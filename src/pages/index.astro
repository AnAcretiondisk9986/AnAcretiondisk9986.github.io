---
import Icon from '../components/Icon.astro';
import { getPublicPosts } from '../lib/posts';
import { sortNewestFirst, thumbOf, type GalleryImageBrief } from '../lib/gallery';
import { firstImageFromBody } from '../lib/post-cover';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import { safeLink } from '../lib/safe-link';
import frontend from '../data/frontend.json';
import about from '../data/about.json';
import standaloneGallery from '../data/gallery.json';
// 首页专属的滚动动效样式：放在 BaseLayout 之后引入，保证在同一 @layer 里后胜出
import '../styles/home-cinematic.css';

const posts = await getPublicPosts();
const primaryCtaHref = safeLink(frontend.primaryCtaHref, '/blog/');
const recentPosts = posts.slice(0, 6);

const galleryTeaserImages: (GalleryImageBrief & { thumb?: string })[] = sortNewestFirst(
  standaloneGallery as GalleryImageBrief[],
)
  .slice(0, 3)
  .map((img) => ({ ...img, thumb: img.thumb ?? thumbOf(img.src) }));

/* 首屏标题：frontend.heroTitleLine1 里同时含有中文与域名（如「欢迎来到Blog.Acretiondisk.top」）。
   按第一个拉丁字符拆成两行，各自定标——中文行用 --type-display，域名行用更小的 clamp，
   否则 21 字符的域名会被断行算法从词中间劈开。 */
const rawTitle1 = String(frontend.heroTitleLine1 ?? '').trim();
const latinAt = rawTitle1.search(/[A-Za-z0-9]/);
const titleCjk = latinAt > 0 ? rawTitle1.slice(0, latinAt).trim() : rawTitle1;
const titleLatin = latinAt > 0 ? rawTitle1.slice(latinAt).trim() : '';
const titleLine3 = String(frontend.heroTitleLine2 ?? '').trim();

/* 域名拆成「前缀」与「主域」两段：前缀（blog.）保持原样，主域单独加克制的光效。
   只按第一个点切分，因此 blog.Acretiondisk.top / www.example.com 都成立；
   没有点（纯单词）时整段按主域处理。 */
const domainSplit = titleLatin.match(/^([A-Za-z0-9-]{1,12}\.)(.+)$/);
const domainPrefix = domainSplit?.[1] ?? '';
const domainZone = domainSplit?.[2] ?? titleLatin;

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

/* 六张编目卡片：封面走 480px 缩略图（image/thumb/*.webp），没有封面时退回正文首图；
   两者都没有就渲染「NO PLATE」骨架，而不是留一个空洞。 */
const recentCards = recentPosts.map((post, index) => {
  const original = post.data.cover?.trim() || firstImageFromBody(post.body ?? '');
  return {
    href: `/blog/${post.id}/`,
    title: post.data.title,
    tag: post.data.tags?.[0] ?? '',
    date: fmtDate(post.data.pubDate),
    iso: post.data.pubDate.toISOString(),
    no: String(posts.length - index).padStart(3, '0'),
    cover: original ? thumbOf(original) : '',
    original: original && original !== thumbOf(original) ? original : '',
  };
});

const heroPosition = String(frontend.stillImagePosition || 'center');
---

<BaseLayout>
  <!-- 首屏横幅：图片层是 100vw 对称出血的全幅底图，内容层留在纸面内容框内，
       两者共享同一水平中心，所以文字在任意宽度下都严格居中。 -->
  <section class="f-hero" aria-labelledby="cover-title" data-hero>
    <div class="f-hero__media" aria-hidden="true">
      <img
        class="f-hero__image"
        src={frontend.stillHeroImage}
        alt=""
        decoding="async"
        fetchpriority="high"
        crossorigin="anonymous"
        style={`--hero-image-position:${heroPosition}`}
      />
    </div>
    <div class="f-hero__scrim" aria-hidden="true"></div>

    <div class="f-hero__body">
      <p class="f-hero__folio"><span>PLATE I</span><i></i><span>MMXXVI</span></p>

      <h1 id="cover-title" class="f-hero__title">
        <span class="f-hero__line1">{titleCjk}</span>
        {titleLatin && (
          <span class="f-hero__domain">
            {domainPrefix && <em class="f-hero__domain-prefix">{domainPrefix}</em>}
            <em class="f-hero__domain-zone">{domainZone}</em>
          </span>
        )}
      </h1>
      {titleLatin && <span class="f-hero__domain-rule" aria-hidden="true"></span>}
      {titleLine3 && <p class="f-hero__line3">{titleLine3}</p>}

      <p class="f-hero__deck">{frontend.heroDescription}</p>

      <div class="f-hero__meta">
        <span>{posts.length} 篇手记</span>
        <span>{(standaloneGallery as unknown[]).length} 幅图版</span>
        <span>自 2026 年起</span>
      </div>

      <div class="f-hero__actions">
        <a class="f-btn" href={primaryCtaHref}>
          {frontend.primaryCtaLabel}
          <Icon name="arrow-right" />
        </a>
        <a class="f-btn f-btn--ghost" href="/gallery/">查看图志</a>
      </div>
    </div>
  </section>

  <section class="f-section">
    <div class="f-section-head" data-reveal="head">
      <h2 class="f-section-title"><small>II</small>近期编目</h2>
      <a class="f-section-more" href="/blog/">全部 {posts.length} 篇 →</a>
    </div>
    <div class="f-recent">
      {recentCards.map((card) => (
        <a class="f-card" href={card.href} data-reveal="card">
          <span
            class="f-card__frame"
            data-loading={card.cover ? 'true' : undefined}
            data-empty={card.cover ? undefined : 'true'}
          >
            {card.cover && (
              <img
                class="f-card__img"
                src={card.cover}
                alt=""
                loading="lazy"
                decoding="async"
                data-original-cover={card.original || undefined}
              />
            )}
          </span>
          <span class="f-card__body">
            <span class="f-card__no">NO. {card.no}</span>
            <span class="f-card__title">{card.title}</span>
            <span class="f-card__meta">
              <span class="f-card__tag">{card.tag || '未分类'}</span>
              <time datetime={card.iso}>{card.date}</time>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="f-section">
    <div class="f-section-head" data-reveal="head">
      <h2 class="f-section-title"><small>III</small>最新图版</h2>
      <a class="f-section-more" href="/gallery/">进入图志 →</a>
    </div>
    <div class="f-plates">
      {galleryTeaserImages.map((img, i) => (
        <a class="f-plate" href="/gallery/" data-reveal="plate">
          <span class="f-plate__frame">
            <img src={img.thumb ?? img.src} alt={img.alt || img.title || ''} loading="lazy" decoding="async" />
          </span>
          <span class="f-plate__cap">
            <span class="f-plate__title">{img.title || '未命名'}</span>
            <span class="f-plate__no">PL. {String(99 - i).padStart(3, '0')}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <AboutTeaser
    avatar={about.avatar}
    lead={about.lead}
    paragraphs={about.paragraphs}
    quoteText={about.quoteText}
  />

  <section class="f-section f-coda" data-reveal="coda">
    <div class="f-fleuron" aria-hidden="true"><i></i></div>
    <blockquote>"写下来，是为了更清楚地看见自己。"</blockquote>
    <p class="f-num">FINIS PAGINAE · INITIUM SEQUENTIS</p>
  </section>
</BaseLayout>

<script>
  import '../scripts/home-media';
  import '../scripts/home-cinematic';
</script>
