---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/hz/PostRow.astro';
import { getPublicPosts } from '../lib/posts';
import { sortNewestFirst, thumbOf, type GalleryImageBrief } from '../lib/gallery';
import { safeLink } from '../lib/safe-link';
import { fmtMass, folioCodes, massOf, mjd } from '../lib/horizon';
import frontend from '../data/frontend.json';
import about from '../data/about.json';
import standaloneGallery from '../data/gallery.json';
import '../styles/hz/home.css';
import '../styles/hz/log.css';

const posts = await getPublicPosts();
const folioFor = folioCodes(posts);
const recentPosts = posts.slice(0, 8);
const totalChars = posts.reduce((sum, p) => sum + massOf(p.body ?? ''), 0);
const latestMjd = posts[0] ? mjd(posts[0].data.pubDate).toFixed(1) : '—';

const galleryPlates = sortNewestFirst(standaloneGallery as GalleryImageBrief[])
  .slice(0, 4)
  .map((img) => {
    const thumb = img.thumb ?? thumbOf(img.src);
    return { ...img, thumb, fallback: thumb !== img.src ? img.src : '' };
  });

const rawTitle1 = String(frontend.heroTitleLine1 ?? '').trim();
const latinAt = rawTitle1.search(/[A-Za-z0-9]/);
const titleCjk = latinAt > 0 ? rawTitle1.slice(0, latinAt).trim() : rawTitle1;
const titleLatin = latinAt > 0 ? rawTitle1.slice(latinAt).trim() : '';
const titleLine2 = String(frontend.heroTitleLine2 ?? '').trim();
const primaryCtaHref = safeLink(frontend.primaryCtaHref, '/blog/');
---

<BaseLayout page="origin" bleed>
  <section class="hz-hero" data-hero aria-labelledby="hz-hero-title">
    <canvas
      class="hz-hero__canvas"
      data-disk
      data-sky-src={frontend.stillHeroImage || ''}
      aria-hidden="true"
    ></canvas>
    <div class="hz-hero__fallback" aria-hidden="true"></div>
    <div class="hz-hero__scrim" aria-hidden="true"></div>

    <div class="hz-hero__inner hz-wrap">
      <p class="hz-hero__eyebrow hz-mono">
        <i class="hz-hero__pulse" aria-hidden="true"></i>
        <span>{frontend.heroEyebrow || 'EVENT HORIZON OBSERVATORY · 2026'}</span>
      </p>

      <h1 id="hz-hero-title" class="hz-hero__title">
        <span class="hz-hero__l1">{titleCjk}</span>
        {titleLatin && <span class="hz-hero__domain">{titleLatin}</span>}
        {titleLine2 && <span class="hz-hero__l2">{titleLine2}</span>}
      </h1>

      {frontend.heroDescription && (
        <p class="hz-hero__deck">{frontend.heroDescription}</p>
      )}

      <div class="hz-hero__tele hz-mono">
        <span><b>{posts.length}</b> 篇观测记录</span>
        <span><b>{fmtMass(totalChars)}</b> 有效字符</span>
        <span><b>{(standaloneGallery as unknown[]).length}</b> 幅独立图版</span>
        <span>LATEST MJD <b>{latestMjd}</b></span>
      </div>

      <div class="hz-hero__actions">
        <a class="hz-btn hz-btn--hot" href={primaryCtaHref}>
          <span>{frontend.primaryCtaLabel || '浏览文章'}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a class="hz-btn" href="/gallery/">
          <span>进入透镜图志</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="hz-hero__cue hz-wrap hz-mono" aria-hidden="true">
      <span>R_s = 2GM / c² · SCHWARZSCHILD METRIC</span>
      <span>↓ SCROLL TO CROSS HORIZON</span>
    </div>
  </section>

  <section class="hz-home-sec hz-wrap" aria-labelledby="sec-recent">
    <div class="hz-sect">
      <span class="hz-sect__no">01</span>
      <h2 class="hz-sect__title" id="sec-recent">近期观测记录</h2>
      <span class="hz-sect__rule" aria-hidden="true"></span>
      <a class="hz-sect__more" href="/blog/">全部 {posts.length} 篇光谱 →</a>
    </div>

    <div class="hz-ledger">
      {recentPosts.map((post, idx) => (
        <PostRow post={post} folioCode={folioFor(post)} index={idx} headingLevel={3} />
      ))}
    </div>
  </section>

  {galleryPlates.length > 0 && (
    <section class="hz-home-sec hz-wrap" aria-labelledby="sec-plates">
      <div class="hz-sect">
        <span class="hz-sect__no">02</span>
        <h2 class="hz-sect__title" id="sec-plates">引力透镜图版</h2>
        <span class="hz-sect__rule" aria-hidden="true"></span>
        <a class="hz-sect__more" href="/gallery/">进入透镜场 →</a>
      </div>

      <div class="hz-plates-strip">
        {galleryPlates.map((img, i) => (
          <a
            class:list={['hz-hplate', { 'hz-hplate--lead': i === 0 }]}
            href={`/gallery/?plate=${encodeURIComponent(img.id)}`}
          >
            <span class="hz-hplate__frame">
              <img
                src={img.thumb}
                alt={img.alt || img.title || ''}
                loading="lazy"
                decoding="async"
                data-gallery-fallback={img.fallback || undefined}
              />
              <span class="hz-hplate__cross" aria-hidden="true"></span>
            </span>
            <span class="hz-hplate__meta">
              <span class="hz-hplate__title">{img.title || '未命名图版'}</span>
              <span class="hz-hplate__no hz-mono">PL.{String(i + 1).padStart(2, '0')}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="hz-home-sec hz-wrap" aria-labelledby="sec-observer">
    <div class="hz-sect">
      <span class="hz-sect__no">03</span>
      <h2 class="hz-sect__title" id="sec-observer">观测者档案</h2>
      <span class="hz-sect__rule" aria-hidden="true"></span>
      <a class="hz-sect__more" href="/about/">完整档案与项目 →</a>
    </div>

    <div class="hz-dossier-teaser">
      <div class="hz-dossier-teaser__orbit">
        <span class="hz-dossier-teaser__ring" aria-hidden="true"></span>
        <img src={about.avatar || '/logo.webp'} alt="Acretiondisk" loading="lazy" decoding="async" />
      </div>
      <div class="hz-dossier-teaser__copy">
        <p class="hz-dossier-teaser__lead">{about.lead}</p>
        {about.paragraphs?.[0] && <p>{about.paragraphs[0]}</p>}
        {about.quoteText && (
          <blockquote class="hz-dossier-teaser__quote">{about.quoteText}</blockquote>
        )}
        <div class="hz-dossier-teaser__links">
          <a class="hz-btn" href="/about/">查看完整档案 + {(about.projects || []).length} 个项目 →</a>
          <a class="hz-btn" href="/ai-quota/">AI 额度监控 ↗</a>
        </div>
      </div>
    </div>
  </section>

  <div class="hz-lens" data-lens aria-hidden="true">
    <img data-lens-img alt="" />
    <span class="hz-lens__ring"></span>
    <span class="hz-lens__cap hz-mono" data-lens-cap></span>
  </div>
</BaseLayout>

<script>
  import '../scripts/hz/disk';
  import '../scripts/hz/lens';
</script>
