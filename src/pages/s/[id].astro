---
import { getCollection } from 'astro:content';
import { shortIdForPath } from '../../lib/shortlink';

/**
 * 短链跳转页:构建时为每篇非草稿文章生成一个 /s/<短码> 页面,
 * 打开后立即跳到文章真实地址(meta refresh 兜底 + JS location.replace)。
 * 短码与文章页侧栏展示的「分享短链」由同一函数 shortIdForPath 生成,保证一致。
 */
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.access !== 'admin');
  const site = import.meta.env.SITE;
  const used = new Map<string, string>();
  return posts.map((post) => {
    const shortId = shortIdForPath(post.id);
    const conflict = used.get(shortId);
    if (conflict) {
      throw new Error(
        `[shortlink] 短链冲突:「${conflict}」与「${post.id}」生成了相同的短码 /s/${shortId}。` +
          `请调大 src/lib/shortlink.ts 中 hash 的位数。`,
      );
    }
    used.set(shortId, post.id);
    // new URL 会自动对中文 slug 做百分号编码,得到可直接请求的规范地址
    const target = new URL(`/blog/${post.id}/`, site).href;
    return { params: { id: shortId }, props: { target, title: post.data.title } };
  });
}

interface Props {
  target: string;
  title: string;
}

const { target, title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>正在跳转 · {title}</title>
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: Georgia, 'Times New Roman', 'Noto Serif SC', 'Songti SC', serif;
        background: #f3eddf;
        color: #2c261b;
      }
      @media (prefers-color-scheme: dark) {
        body { background: #24211b; color: #e8e0cd; }
      }
      main { text-align: center; padding: 32px; max-width: 560px; }
      h1 { font-size: 1.05rem; font-weight: 500; letter-spacing: 0.04em; margin: 0 0 18px; }
      p { font-size: 0.8rem; line-height: 1.8; opacity: 0.75; margin: 0; }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <main>
      <h1>正在跳转到文章…</h1>
      <p>《{title}》</p>
      <p><a href={target}>如果未自动跳转,请点击这里</a></p>
    </main>
    <script is:inline define:vars={{ target }}>
      // target 已是 new URL(...).href 的合法百分号编码地址,不可再 encodeURI(会双重编码导致中文 slug 404)
      location.replace(target);
    </script>
  </body>
</html>
