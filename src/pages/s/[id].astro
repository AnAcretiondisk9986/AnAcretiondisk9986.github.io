---
import { getCollection } from 'astro:content';
import { shortIdForPath } from '../../lib/shortlink';
import { isListable } from '../../lib/horizon';

/**
 * 短链跳转页：构建时为每篇可公开列出的文章生成一个 /s/<短码> 页面，
 * 打开后立即跳转到真实地址（meta refresh 兜底 + JS location.replace）。
 */
export async function getStaticPaths() {
  const posts = await getCollection('blog', isListable);
  const site = import.meta.env.SITE;
  const used = new Map<string, string>();
  return posts.map((post) => {
    const shortId = shortIdForPath(post.id);
    const conflict = used.get(shortId);
    if (conflict) {
      throw new Error(
        `[shortlink] 短链冲突:「${conflict}」与「${post.id}」生成了相同的短码 /s/${shortId}。请调大 src/lib/shortlink.ts 中 hash 的位数。`,
      );
    }
    used.set(shortId, post.id);
    const target = new URL(`/blog/${post.id}/`, site).href;
    return { params: { id: shortId }, props: { target, title: post.data.title } };
  });
}

interface Props {
  target: string;
  title: string;
}

const { target, title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>正在跳转 · {title}</title>
    <style>
      :root { color-scheme: dark light; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        font-family: ui-monospace, 'Cascadia Code', Consolas, system-ui, sans-serif;
        background: #08080b;
        color: #ece7dc;
      }
      @media (prefers-color-scheme: light) {
        body { background: #eae8e2; color: #0d0d10; }
      }
      main {
        padding: 32px;
        max-width: 560px;
        border: 1px solid currentColor;
      }
      p.kicker {
        margin: 0 0 12px;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        color: #ff5a1a;
      }
      h1 {
        margin: 0 0 14px;
        font-size: 1.05rem;
        font-weight: 700;
      }
      p.note {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.7;
        opacity: 0.78;
      }
      a { color: #ff5a1a; }
    </style>
  </head>
  <body>
    <main>
      <p class="kicker">HORIZON // SHORTLINK RELAY</p>
      <h1>正在跳转至《{title}》…</h1>
      <p class="note"><a href={target}>如果未自动跳转，请点击这里 →</a></p>
    </main>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
