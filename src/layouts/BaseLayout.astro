---
/**
 * HORIZON 全站外壳。
 * Props 与旧版兼容（title / description / bodyClass），额度页与定价页无需改动即可套用。
 * 不再使用 Astro ClientRouter：跨页过渡交给原生跨文档 View Transitions（见 styles/hz/base.css）。
 */
import '../styles/hz/fonts.css';
import '../styles/hz/tokens.css';
import '../styles/hz/base.css';
import '../styles/hz/shell.css';
import Hud from '../components/hz/Hud.astro';
import Foot from '../components/hz/Foot.astro';
import frontend from '../data/frontend.json';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  /** 页面标识，写到 <body data-page> */
  page?: string;
  /** 首页首屏全出血：去掉 main 顶部留白 */
  bleed?: boolean;
  /** 不渲染页脚 */
  noFoot?: boolean;
}

const {
  title = 'Acretiondisk',
  description = '记录技术、医学、艺术与生活。',
  bodyClass = '',
  page = '',
  bleed = false,
  noFoot = false,
} = Astro.props;

const siteName = frontend.siteName || 'Acretiondisk';
const siteTagline = frontend.siteTagline || '记录想法与生活';
const fullTitle = title === 'Acretiondisk' || title === siteName ? siteName : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://blog.acretiondisk.top').href;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <style is:inline>@layer hz-reset, hz-base;</style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080b" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preload" href="/fonts/anthropic-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anthropic-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anthropic-serif-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        var r = document.documentElement;
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        r.dataset.theme = t === 'light' || t === 'dark' ? t : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        r.classList.add('js');
      })();
    </script>
  </head>
  <body class={bodyClass} data-page={page}>
    <a class="hz-skip" href="#main">跳到正文</a>
    <Hud siteName={siteName} siteTagline={siteTagline} pathname={Astro.url.pathname} />
    <main id="main" class:list={['hz-main', { 'hz-main--bleed': bleed }]}>
      <slot />
    </main>
    {!noFoot && <Foot siteName={siteName} siteTagline={siteTagline} />}
    <script>
      import '../scripts/hz/shell';
      import '../scripts/cdn-fallback';
    </script>
  </body>
</html>
