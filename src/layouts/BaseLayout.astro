---
import '../styles/global.css';
import '../styles/minimal-theme.css';
import { ClientRouter } from 'astro:transitions';
import ArchiveSeal from '../components/ArchiveSeal.astro';
import ThemeCopy from '../components/ThemeCopy.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Acretiondisk',
  description = '记录技术、医学、艺术与生活。',
} = Astro.props;

const pageTitle = title === 'Acretiondisk' ? title : `${title} · Acretiondisk`;
const pathname = Astro.url.pathname;
const navigation = [
  { href: '/', minimal: '首页', trace: '首页', index: 'I' },
  { href: '/blog/', minimal: '文章', trace: '卷册', index: 'II' },
  { href: '/gallery/', minimal: '照片', trace: '图志', index: 'III' },
  { href: '/about/', minimal: '关于', trace: '关于', index: 'IV' },
  { href: '/guestbook/', minimal: '留言', trace: '留言', index: 'V' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <!-- data-astro-rerun:View Transitions 导航后需重新执行,恢复 data-theme/js/vt(swap 会移除 <html> 属性);IIFE 包裹防止重复执行时顶层 const 重复声明 -->
    <script is:inline data-astro-rerun>
      (() => {
        const savedTheme = localStorage.getItem('theme');
        const savedVisualTheme = localStorage.getItem('visual-theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = savedTheme ?? (systemDark ? 'dark' : 'light');
        document.documentElement.dataset.visualTheme = savedVisualTheme === 'trace' ? 'trace' : 'minimal';
        // js = 允许脚本驱动的进入动画;vt = 支持 View Transitions(避免与路由过渡动画叠加)
        document.documentElement.classList.add('js');
        if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('vt');
        }
      })();
    </script>
  </head>
  <body>
    <ClientRouter />
    <div class="paper-grain" aria-hidden="true"></div>
    <div class="site-shell">
      <aside class="edge-note edge-note--left" aria-hidden="true">
        <span>ARCHIVUM PERSONAE</span>
        <span>31°14′ N · 121°29′ E</span>
      </aside>
      <aside class="edge-note edge-note--right" aria-hidden="true">
        <span>CATALOGUS I</span>
        <span>{new Date().getFullYear()}</span>
      </aside>

      <header class="site-header">
        <div class="header-register">
          <span>ACR—LOG / PERSONAL CODEX</span>
          <span>EST. MMXXVI</span>
        </div>

        <div class="header-main">
          <a class="site-name" href="/" aria-label="Acretiondisk 首页">
            <ArchiveSeal class="site-seal" />
            <span>
              <b>Acretiondisk</b>
              <small><ThemeCopy minimal="记录想法与生活" trace="一人之观察与行记" /></small>
            </span>
          </a>

          <nav aria-label="主导航">
            {navigation.map((item) => {
              const active = item.href === '/'
                ? pathname === '/'
                : pathname.startsWith(item.href);
              return (
                <a href={item.href} aria-current={active ? 'page' : undefined}>
                  <span class="nav-index">{item.index}</span>
                  <ThemeCopy minimal={item.minimal} trace={item.trace} />
                </a>
              );
            })}
            <button class="theme-toggle" type="button" aria-label="切换明暗主题">
              <span data-theme-icon aria-hidden="true">☀</span>
              <span class="theme-toggle__label">昼夜</span>
            </button>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-mark">
          <ArchiveSeal class="footer-seal" label="Acretiondisk" />
          <p>
            <strong><ThemeCopy minimal="个人博客 · 持续更新" trace="私人典藏 · 持续编目" /></strong>
            <span><ThemeCopy minimal="记录想法、作品与日常。" trace="以文字保存观察，以设计标记时间。" /></span>
          </p>
        </div>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} ACRETIONDISK</span>
          <a href="https://github.com/AnAcretiondisk9986">GITHUB ↗</a>
        </div>
      </footer>
    </div>

    <!-- data-astro-rerun:VT 导航后 DOM 被替换,必须重新执行以绑定按钮监听器;内联脚本需为纯 JS 且用 IIFE 包裹(重复执行时顶层 const 会冲突) -->
    <script is:inline data-astro-rerun>
      (() => {
        const button = document.querySelector('.theme-toggle');
        const icon = button?.querySelector('[data-theme-icon]');
        const syncThemeButton = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          if (icon) icon.textContent = dark ? '☾' : '☀';
          button?.setAttribute('aria-label', dark ? '切换为浅色模式' : '切换为深色模式');
        };
        syncThemeButton();
        button?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          const apply = () => {
            document.documentElement.dataset.theme = next;
            localStorage.setItem('theme', next);
            syncThemeButton();
          };
          // 支持 View Transitions 时以交叉淡化衔接明暗主题切换
          if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.startViewTransition(apply);
          } else {
            apply();
          }
        });

        requestAnimationFrame(() => document.documentElement.classList.add('is-ready'));
      })();
    </script>
  </body>
</html>
